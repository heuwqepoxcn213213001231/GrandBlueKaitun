    function Systems.Combat.WeaponRank(name)
        if type(name) ~= "string" or name == "" then
            return 0
        end
        local order = {
            ["Nightfall Axe and Mace"] = 100,
            ["Seismic Axe and Mace"] = 90,
            ["Axe and Mace"] = 80,
            ["Fancy Katana"] = 70,
            ["Regular Katana"] = 50,
            Combat = 10,
        }
        if order[name] then
            return order[name]
        end
        if string.find(name, "Broken", 1, true) then
            return 0
        end
        if string.find(name, "Katana", 1, true) or string.find(name, "Nichirin", 1, true) then
            return 65
        end
        return 0
    end

    function Systems.Combat.EquipBest()
        if not Config.AutoEquipment then
            return
        end
        if Runtime.DrinkingPotion then
            return
        end
        local character, humanoid = Resolver.Character()
        if not character or not humanoid then
            return
        end
        local equippedTool = character:FindFirstChildOfClass("Tool")
        if equippedTool and Systems.Potion and Systems.Potion.IsPotionName(equippedTool.Name) then
            Systems.Potion.SetEquippedSlot(1)
            return
        end
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        local bestName = equippedTool and equippedTool.Name
        local bestRank = Systems.Combat.WeaponRank(bestName)
        local bestTool = equippedTool
        local preferred = {
            "Nightfall Axe and Mace",
            "Seismic Axe and Mace",
            "Axe and Mace",
            "Fancy Katana",
            "Regular Katana",
            "Combat",
        }
        local function consider(name, tool)
            local rank = Systems.Combat.WeaponRank(name)
            if rank > bestRank then
                bestRank = rank
                bestName = name
                bestTool = tool
            end
        end
        for i = 1, #preferred do
            local name = preferred[i]
            local tool = character:FindFirstChild(name) or (backpack and backpack:FindFirstChild(name))
            if tool and tool:IsA("Tool") then
                consider(name, tool)
            elseif Game.PlayerData.HasItem(name) then
                consider(name, nil)
            end
        end
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then
                    consider(tool.Name, tool)
                end
            end
        end
        if not bestName then
            return
        end
        -- Already holding that tool, or toolbar One already points at it — do not spam.
        local bestId = Game.PlayerData.GetItemId(bestName)
        local barId = Game.PlayerData.GetToolbarId("One")
        if equippedTool and equippedTool.Name == bestName then
            Runtime.Weapon = bestName
            return
        end
        if bestId and barId == bestId and Runtime.Weapon == bestName then
            return
        end
        if Runtime.Weapon == bestName and Runtime.LastEquipAt and os.clock() - Runtime.LastEquipAt < 8 then
            return
        end
        if bestTool and bestTool:IsA("Tool") then
            pcall(function()
                humanoid:EquipTool(bestTool)
            end)
            Runtime.Weapon = bestName
            Runtime.LastEquipAt = os.clock()
            Logger.Info("Combat", "Equipped " .. tostring(bestName))
            return
        end
        if Runtime.LastEquipAt and os.clock() - Runtime.LastEquipAt < 5 then
            return
        end
        if bestId then
            if barId == bestId then
                Runtime.Weapon = bestName
                return
            end
            Net.ToServer("Toolbar_Equip", "One", bestId)
            Runtime.LastEquipAt = os.clock()
            Runtime.Weapon = bestName
            Logger.Info("Equipment", "Toolbar_Equip " .. tostring(bestName) .. " id=" .. tostring(bestId))
        end
    end

