    function Systems.Training.FindStation(kind)
        local marker = Systems.Training.MarkerPos(kind)
        local markerPos = marker and marker.Position
        local _, _, root = Resolver.Character()
        local here = root and root.Position
        local bestPrompt, bestCf, bestScore
        local function consider(prompt, cf)
            if not cf then
                return
            end
            local p = cf.Position
            if p.Y < 80 then
                return
            end
            if not Systems.Training.HasFloor(cf) then
                return
            end
            if markerPos then
                local dy = math.abs(p.Y - markerPos.Y)
                local flat = Vector3.new(p.X - markerPos.X, 0, p.Z - markerPos.Z).Magnitude
                if dy > 80 or flat > 180 then
                    return
                end
            end
            local distMark = markerPos and (p - markerPos).Magnitude or 0
            local distHere = here and (p - here).Magnitude or 0
            local s = -distMark - distHere * 0.2
            if prompt then
                s = s + 8000
            end
            if not bestScore or s > bestScore then
                bestScore = s
                bestPrompt = prompt
                bestCf = cf
            end
        end
        local folder = Workspace:FindFirstChild("Training")
        local names = TrainingFolders[kind]
        if folder and names then
            for i = 1, #names do
                local sub = folder:FindFirstChild(names[i])
                if sub then
                    for _, d in ipairs(sub:GetDescendants()) do
                        if d:IsA("ProximityPrompt") then
                            consider(d, Systems.Training.WorldPos(d))
                        end
                    end
                    for _, child in ipairs(sub:GetChildren()) do
                        if child.Name ~= "Sign" then
                            consider(child:FindFirstChildWhichIsA("ProximityPrompt", true), Systems.Training.WorldPos(child))
                        end
                    end
                end
            end
        end
        if not bestCf then
            bestCf = marker
        end
        return bestCf, bestPrompt
    end

