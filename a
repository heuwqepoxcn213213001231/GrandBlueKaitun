    function Systems.Skills.Spend()
        if Config.AutoSkills == false then
            return false
        end
        local now = os.clock()
        if Runtime.LastSkillSpendAt and now - Runtime.LastSkillSpendAt < 0.35 then
            return false
        end
        local points = Game.PlayerData.GetSkillPoints()
        if points < 3 then
            return false
        end
        local maxLevel = (Config.SkillTree and Config.SkillTree.MaxLevel) or 225
        local list = Config.SkillTree and Config.SkillTree.Priority
        if type(list) ~= "table" then
            return false
        end
        for i = 1, #list do
            local node = list[i]
            local name = node.Name
            local ratio = node.Ratio or 37
            local maxRank = math.max(1, math.floor(maxLevel / ratio))
            local rank = Game.PlayerData.GetSkillRank(name)
            if rank < maxRank then
                local cost = (node.Start or 3) + (node.Increment or 3) * rank
                if points >= cost then
                    Runtime.LastSkillSpendAt = now
                    local ok, success, msg = Net.Invoke("UnlockSkillTreeNode", name)
                    if ok and success ~= false then
                        Logger.Info("SkillTree", string.format(
                            "Unlock %s rank %s→%s cost=%s SP=%s",
                            name,
                            tostring(rank),
                            tostring(rank + 1),
                            tostring(cost),
                            tostring(points)
                        ))
                        return true
                    end
                    Logger.Once("skill-" .. name, "debug", "SkillTree", string.format(
                        "UnlockSkillTreeNode %s denied: %s %s",
                        name,
                        tostring(success),
                        tostring(msg)
                    ))
                end
            end
        end
        return false
    end

