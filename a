    function Systems.Movement.MoveTo(destination, range, _timeout)
        range = range or Config.Movement.ArriveDistance
        if Systems.Movement.HasArrived(destination, range) then
            if Systems.Movement.Overlapping()
                and Runtime.State ~= "LOOT_CHEST"
                and Runtime.State ~= "TRAINING"
                and Runtime.MovePurpose ~= "pickup"
            then
                Systems.Movement.Unstuck()
