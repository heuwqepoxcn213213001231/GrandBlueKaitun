    function Resolver.FindWorldNpcModel(npcName)
        if not npcName then
            return nil
        end
        local cached = Resolver._npcCache[npcName]
        local cachedAt = Resolver._npcCacheAt[npcName]
        if cached ~= nil and cachedAt and (os.clock() - cachedAt) < 2.5 then
            if typeof(cached) == "Instance" and cached.Parent then
                local expected = NpcDB[npcName] and NpcDB[npcName].CFrame
                if expected and Util.Distance(cached, expected) > 80 then
                    Resolver._npcCache[npcName] = nil
                else
                    return cached
                end
            else
                Resolver._npcCache[npcName] = nil
            end
        end
        local aliases = { npcName }
        if NpcDB[npcName] and NpcDB[npcName].Name and NpcDB[npcName].Name ~= npcName then
            table.insert(aliases, NpcDB[npcName].Name)
        end
        local function sameName(a, b)
            if not a or not b then
                return false
            end
            if a == b then
                return true
            end
            return string.lower(a) == string.lower(b)
        end
        local function matchName(inst)
            if not inst then
                return false
            end
            for i = 1, #aliases do
                if sameName(inst.Name, aliases[i]) then
                    return true
                end
            end
            if inst.GetAttribute then
                local dialogue = inst:GetAttribute("DialogueName")
                local offer = inst:GetAttribute("NpcName")
                for i = 1, #aliases do
                    if sameName(dialogue, aliases[i]) or sameName(offer, aliases[i]) then
                        return true
                    end
                end
            end
            return false
        end
        local function scanFolder(folder)
            if not folder then
                return nil
            end
            for _, child in ipairs(folder:GetChildren()) do
                if matchName(child) then
                    return child
                end
            end
            return nil
        end
        local found
        local prefer
        local intent = Runtime.CurrentIntent
        if intent and intent.Def and intent.Def.Region then
            prefer = intent.Def.Region
        elseif NpcDB[npcName] and NpcDB[npcName].Region then
            prefer = NpcDB[npcName].Region
        end
        local function scanRegions(container)
            if not container then
                return
            end
            local function scanOne(region)
                found = scanFolder(region:FindFirstChild("StationaryNpcs"))
                    or scanFolder(region:FindFirstChild("Npcs"))
                    or scanFolder(region:FindFirstChild("NPCs"))
                return found ~= nil
            end
            if prefer then
                local preferred = container:FindFirstChild(prefer)
                if preferred and scanOne(preferred) then
                    return
                end
            end
            for _, region in ipairs(container:GetChildren()) do
                if scanOne(region) then
                    return
                end
            end
        end
        local debree = Workspace:FindFirstChild("Debree")
        scanRegions(debree and debree:FindFirstChild("Regions"))
        if not found then
            local humanoids = Workspace:FindFirstChild("Humanoids")
            scanRegions(humanoids and humanoids:FindFirstChild("Regions"))
        end
        if found then
            Resolver._npcCache[npcName] = found
            Resolver._npcCacheAt[npcName] = os.clock()
        end
        return found
    end

    function Resolver.FindWorldNpc(npcName)
