    local Util = {}

    function Util.SafeCall(label, fn, ...)
        local ok, a, b, c, d, e = xpcall(fn, function(err)
            return debug.traceback(tostring(err), 2)
        end, ...)
        if not ok then
            Logger.Error(label or "SafeCall", a)
            return false, a
        end
        return true, a, b, c, d, e
    end

    function Util.WaitFor(timeout, predicate, interval)
        local deadline = os.clock() + (timeout or 5)
        interval = interval or 0.1
        while os.clock() < deadline and stillCurrent() do
            local ok, result = pcall(predicate)
            if ok and result then
                return true, result
            end
            task.wait(interval)
        end
        return false, nil
    end

    function Util.FindChild(parent, name, timeout)
        if not parent then
            return nil
        end
        local existing = parent:FindFirstChild(name)
        if existing then
            return existing
        end
        if not timeout or timeout <= 0 then
            return nil
        end
        local ok, child = pcall(function()
            return parent:WaitForChild(name, timeout)
        end)
        if ok then
            return child
        end
        return nil
    end

    function Util.FindDescendant(parent, name)
        if not parent then
            return nil
        end
        return parent:FindFirstChild(name, true)
    end

    function Util.ValueOf(instance)
        if instance == nil then
            return nil
        end
        if typeof(instance) ~= "Instance" then
            return instance
        end
        if instance:IsA("ValueBase") then
            return instance.Value
        end
        return instance
    end

    function Util.Distance(a, b)
        if typeof(a) == "CFrame" then
            a = a.Position
        end
        if typeof(b) == "CFrame" then
            b = b.Position
        end
        if typeof(a) == "Instance" then
            if a:IsA("Model") then
                a = a:GetPivot().Position
            elseif a:IsA("BasePart") then
                a = a.Position
            else
                return math.huge
            end
        end
        if typeof(b) == "Instance" then
            if b:IsA("Model") then
                b = b:GetPivot().Position
            elseif b:IsA("BasePart") then
                b = b.Position
            else
                return math.huge
            end
        end
        if typeof(a) ~= "Vector3" or typeof(b) ~= "Vector3" then
            return math.huge
        end
        return (a - b).Magnitude
    end

    function Util.ToCFrame(value)
        if value == nil then
            return nil
        end
        if typeof(value) == "CFrame" then
            return value
        end
        if typeof(value) == "Vector3" then
            return CFrame.new(value)
        end
        if typeof(value) == "Instance" then
            if value:IsA("Model") then
                return value:GetPivot()
            end
            if value:IsA("BasePart") then
                return value.CFrame
            end
        end
        return nil
    end

    function Util.IsAliveHumanoid(humanoid)
        if not humanoid or typeof(humanoid) ~= "Instance" then
            return false
        end
        if not humanoid.Parent then
            return false
        end
        if humanoid.Health <= 0 then
            return false
        end
        local ok, state = pcall(function()
            return humanoid:GetState()
        end)
        if ok and state == Enum.HumanoidStateType.Dead then
            return false
        end
        return true
    end

    function Util.HasCapability(name)
        local ok, fn = pcall(function()
            return rawget(getfenv(0), name) or (getgenv and getgenv()[name])
        end)
        return ok and type(fn) == "function"
    end

    function Util.TableContains(list, value)
        if type(list) ~= "table" then
            return false
        end
        for i = 1, #list do
            if list[i] == value then
                return true
            end
        end
        return false
    end

    function Util.Count(tbl)
        local n = 0
        if type(tbl) ~= "table" then
            return 0
        end
        for _ in pairs(tbl) do
            n = n + 1
        end
        return n
    end

    function Util.CloneList(src)
        local out = {}
        if type(src) ~= "table" then
            return out
        end
        for i = 1, #src do
            out[i] = src[i]
        end
        return out
    end

