    function Resolver.RequireModule(pathParts)
        local current = ReplicatedStorage
        for i = 1, #pathParts do
            current = current:FindFirstChild(pathParts[i])
            if not current then
                return nil, "missing " .. pathParts[i]
            end
        end
        local ok, mod = pcall(require, current)
        if not ok then
            return nil, tostring(mod)
        end
        return mod, nil
    end

    function Resolver.SignalFunction()
        if Runtime.SignalFunction and Runtime.SignalInvoke then
            return Runtime.SignalFunction, Runtime.SignalInvoke
        end
        local mod = Resolver.RequireModule({ "Communication", "ServerAndClient", "Signals", "SignalFunction" })
        if type(mod) == "table" then
            Runtime.SignalFunction = mod
        end
        local comm = ReplicatedStorage:FindFirstChild("Communication")
        local sac = comm and comm:FindFirstChild("ServerAndClient")
        local signals = sac and sac:FindFirstChild("Signals")
        local sf = signals and signals:FindFirstChild("SignalFunction")
        local remote = sf and sf:FindFirstChild("Function")
        if not remote and sf then
            remote = sf:FindFirstChildWhichIsA("RemoteFunction")
        end
        Runtime.SignalInvoke = remote
        return Runtime.SignalFunction, Runtime.SignalInvoke
    end

    function Resolver.SignalEvent()
        if Runtime.SignalEvent and Runtime.SignalRemote then
            return Runtime.SignalEvent, Runtime.SignalRemote
        end
        local mod = Resolver.RequireModule({ "Communication", "ServerAndClient", "Signals", "SignalEvent" })
        if type(mod) == "table" then
            Runtime.SignalEvent = mod
        end
        local comm = ReplicatedStorage:FindFirstChild("Communication")
        local sac = comm and comm:FindFirstChild("ServerAndClient")
        local signals = sac and sac:FindFirstChild("Signals")
        local se = signals and signals:FindFirstChild("SignalEvent")
        local remote = se and se:FindFirstChild("Event")
        if not remote and se then
            remote = se:FindFirstChildWhichIsA("RemoteEvent")
        end
        Runtime.SignalRemote = remote
        return Runtime.SignalEvent, Runtime.SignalRemote
    end

    function Net.AddQuest(key)
        if type(key) ~= "string" or key == "" then
            return false, "empty key"
        end
        local event = ReplicatedStorage:FindFirstChild("Communication")
        event = event and event:FindFirstChild("ServerAndClient")
        event = event and event:FindFirstChild("Signals")
        event = event and event:FindFirstChild("SignalEvent")
        event = event and event:FindFirstChild("Event")
        if event and event:IsA("RemoteEvent") then
            local ok, err = pcall(function()
                event:FireServer("AddQuest", key)
            end)
            if ok then
                Runtime.SignalRemote = event
                return true
            end
            Logger.Debug("Net", "AddQuest FireServer failed: " .. tostring(err))
        end
        return Net.ToServer("AddQuest", key)
    end

    function Net.ClaimBossHunt(id)
        if id == nil or id == "" then
            return false, "empty id"
        end
        return Net.ToServer("BossHuntsRequest", { action = "Claim", id = id })
    end

    function Net.ToServer(action, ...)
        if type(action) ~= "string" or action == "" then
            return false, "empty action"
        end
        local mod, remote = Resolver.SignalEvent()
        -- Verified: SignalEvent.Event:FireServer(action, ...) — same path as working M1/AddQuest.
        if remote and remote:IsA("RemoteEvent") then
            local ok, err = pcall(function(...)
                remote:FireServer(action, ...)
            end, ...)
            if ok then
                return true
            end
            Logger.Debug("Net", "Event:FireServer failed for " .. action .. ": " .. tostring(err))
        end
        if mod and type(mod.ToServer) == "function" then
            local ok, err = pcall(mod.ToServer, action, ...)
            if ok then
                return true
            end
            Logger.Debug("Net", "SignalEvent.ToServer failed for " .. action .. ": " .. tostring(err))
        end
        return false, "SignalEvent unavailable"
    end

    function Net.Invoke(action, ...)
        if type(action) ~= "string" or action == "" then
            return false, "empty action"
        end
        local mod, remote = Resolver.SignalFunction()
        -- CenterEquipped: SignalFunction.ToServer("UnlockSkillTreeNode", nodeName)
        if remote and remote:IsA("RemoteFunction") then
            local ok, a, b = pcall(function(...)
                return remote:InvokeServer(action, ...)
            end, ...)
            if ok then
                return true, a, b
            end
            Logger.Debug("Net", "Function:InvokeServer failed for " .. action .. ": " .. tostring(a))
        end
        if mod and type(mod.ToServer) == "function" then
            local ok, a, b = pcall(mod.ToServer, action, ...)
            if ok then
                return true, a, b
            end
            Logger.Debug("Net", "SignalFunction.ToServer failed for " .. action .. ": " .. tostring(a))
        end
        return false, "SignalFunction unavailable"
    end

