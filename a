    -- Dedicated M1 loop (user-verified). Quest/tween stay on the scheduler.
    function Systems.Combat.M1Loop()
        Logger.Info("Combat", "Dedicated M1 loop: Combat_Service while near a live farm target")
        local event = Systems.Combat.SignalEventRemote()
        while stillCurrent() do
            task.wait(0.05)
            if Config.AutoCombat == false or Runtime.DrinkingPotion then
                -- idle
            else
                local character = LocalPlayer.Character
                local target = Runtime.LockTarget or Runtime.CurrentTarget
                local farming = false
                if character and target and Systems.Enemy.IsAlive(target) then
                    local enemyRoot = Systems.Enemy.GetRoot(target)
                    local _, _, root = Resolver.Character()
                    local dist = (enemyRoot and root) and (root.Position - enemyRoot.Position).Magnitude or 999
                    farming = dist <= 14
                end
                if farming and character then
                    if not event or not event.Parent then
                        event = Systems.Combat.SignalEventRemote()
                    end
                    if event then
                        local last = tonumber(character:GetAttribute("last_combo")) or tonumber(Runtime.LastCombatCombo) or 0
                        local combo = (last >= 6 or last == 7) and 1 or last + 1
                        if combo < 1 then
                            combo = 1
                        elseif combo > 5 then
                            combo = 1
                        end
                        local delay = Config.Combat.FireInterval or 0.12
                        if last >= 5 then
                            delay = Config.Combat.ComboReset or 0.5
                        end
                        if os.clock() - (Runtime.LastSwingAt or 0) >= delay then
                            local weapon = "Combat"
                            local tool = character:FindFirstChildOfClass("Tool")
                            if tool and not (Systems.Potion and Systems.Potion.IsPotionName(tool.Name)) then
                                weapon = tool.Name
                            end
                            pcall(function()
                                event:FireServer("Combat_Service", weapon, combo, false, Config.Combat.HitDelay or 0.02, false, nil)
                            end)
                            Runtime.LastSwingAt = os.clock()
                            Runtime.LastCombatAt = os.clock()
                            Runtime.LastCombatPath = "Combat_Service"
                            Runtime.LastCombatCombo = combo
                            Runtime.M1Combo = combo
                            Runtime.LastSuccessfulAction = "Combat:Combat"
                        end
                    end
                    -- Do not StripAnimTracks on LocalPlayer — breaks Animate.totalWeight / stops M1.
                end
            end
        end
    end

    function Systems.Combat.Attack(target)
        if not Config.AutoCombat then
            return false
        end
        if Runtime.DrinkingPotion then
            return false
        end
        if not Systems.Enemy.IsValidTarget(target) then
            Systems.Enemy.InvalidateTarget()
            return false
        end
        Systems.Combat.LogResearchOnce()
        Systems.Combat.EquipBest()
        local offset = Systems.Movement.CombatOffset(target)
        local _, _, root = Resolver.Character()
        local closeEnough = Config.Combat.SwingWhileClosing or 3.25
        local distToSpot = (root and offset) and (root.Position - offset.Position).Magnitude or 999
        if offset and distToSpot > closeEnough then
            Systems.Movement.MoveToEnemy(target)
            return false
        end
        Systems.Movement.HoldCombat(target)
        local hum = target:FindFirstChildOfClass("Humanoid")
        local hp = hum and hum.Health
        if hp then
            Runtime.SwingHp = hp
            Runtime.SwingCheckAt = os.clock() + 0.4
            Runtime.SwingChecked = false
        end
        return true
    end

    function Systems.Combat.Cycle(expectedCode)
        if Runtime.DrinkingPotion then
            return "DRINKING"
        end
        local edef = expectedCode and EnemyDB[expectedCode]
        local isBoss = edef and edef.Boss == true

        -- Dead boss is cleared by ValidateCurrent (IsAlive=false) BEFORE we reach hp<=0.
        -- Capture that case first so loot window always starts.
        local stale = Runtime.CurrentTarget
        if stale and not Systems.Enemy.IsAlive(stale) then
            local enemyRoot = Systems.Enemy.GetRoot(stale)
            local origin = (enemyRoot and enemyRoot.Position)
                or Runtime.LastCombatPos
            Logger.Info("Combat", "Target dead → cancel and reacquire")
            if isBoss or Runtime.BossFightEngaged then
                Systems.Loot.BeginWindow(origin, "boss-dead")
            end
            Systems.Enemy.InvalidateTarget()
            return "TARGET_DEAD"
        end

        local target = Systems.Enemy.ValidateCurrent(expectedCode)
        if not target then
            target = select(1, Systems.Enemy.FindNearestTarget(expectedCode))
            if target then
                Runtime.CurrentTarget = target
                local hum = target:FindFirstChildOfClass("Humanoid")
                Runtime.LastTargetHealth = hum and hum.Health
                Runtime.LastTargetHealthAt = os.clock()
                if isBoss or (hum and hum.MaxHealth >= 800) then
                    local _, _, here = Resolver.Character()
                    local eroot = Systems.Enemy.GetRoot(target)
                    local near = here and eroot and (here.Position - eroot.Position).Magnitude <= 22
                    if near then
                        Runtime.BossFightEngaged = true
                        Runtime.LootSpent = false
                    end
                end
                Logger.Info("Combat", "Target=" .. tostring(expectedCode) .. " FarmBelowFeet=" .. tostring(Config.Combat.FarmBelowFeet) .. " BossEngaged=" .. tostring(Runtime.BossFightEngaged))
            end
        end
        if not target then
            -- Boss model often despawns the same frame as death — never hits TARGET_DEAD path.
            if Runtime.LastCombatPos and Runtime.LastTargetHealthAt
                and (os.clock() - Runtime.LastTargetHealthAt) < 12
                and (isBoss or Runtime.BossFightEngaged)
            then
                Systems.Loot.BeginWindow(Runtime.LastCombatPos, "boss-despawn")
                return "TARGET_DEAD"
            end
            return "NO_ENEMY"
        end
        local hum = target:FindFirstChildOfClass("Humanoid")
        local hp = hum and hum.Health or 0
        local enemyRoot = Systems.Enemy.GetRoot(target)
        if enemyRoot then
            Runtime.LastCombatPos = enemyRoot.Position
        end
        if hp <= 0 or Systems.Enemy.HasDied(target) then
            Logger.Info("Combat", "Target dead → cancel and reacquire")
            local deathPos = enemyRoot and enemyRoot.Position or Runtime.LastCombatPos
            if isBoss or Runtime.BossFightEngaged then
                Systems.Loot.BeginWindow(deathPos, "boss-hp0")
            end
            Systems.Enemy.InvalidateTarget()
            return "TARGET_DEAD"
        end
        local _, _, root = Resolver.Character()
        local dist = (root and enemyRoot) and (root.Position - enemyRoot.Position).Magnitude or -1
        local before = Runtime.LastTargetHealth
        if before and hp < before - 0.05 then
            Runtime.LastTargetHealthAt = os.clock()
            Runtime.LastProgressAt = os.clock()
            Runtime.LastNoHitStreak = 0
            Runtime.SwingChecked = true
            local maxHp = hum and hum.MaxHealth or 0
            if isBoss or maxHp >= 800 then
                Runtime.BossFightEngaged = true
                Runtime.LootSpent = false
            end
            Logger.Info("Combat", string.format(
                "FarmBelowFeet=%s Distance=%.1f M1 combo=%s HP %.1f → %.1f",
                tostring(Config.Combat.FarmBelowFeet),
                dist,
                tostring(Runtime.LastCombatCombo),
                before,
                hp
            ))
        elseif Runtime.SwingCheckAt and not Runtime.SwingChecked and os.clock() >= Runtime.SwingCheckAt then
            Runtime.SwingChecked = true
            local swingHp = Runtime.SwingHp
            if swingHp and hp < swingHp - 0.05 then
                Runtime.LastNoHitStreak = 0
                Runtime.LastProgressAt = os.clock()
                if isBoss then
                    Runtime.BossFightEngaged = true
                    Runtime.LootSpent = false
                end
            elseif swingHp and hp >= swingHp - 0.05 then
                Runtime.LastNoHitStreak = (Runtime.LastNoHitStreak or 0) + 1
                if Runtime.LastNoHitStreak >= 6 and Runtime.LastNoHitStreak % 6 == 0 then
                    Logger.Debug("Combat", string.format(
                        "Swing verified late (HP still %.1f after delay) Distance=%.1f combo=%s — hits can land on later swings",
                        hp,
                        dist,
                        tostring(Runtime.LastCombatCombo)
                    ))
                end
            end
        end
        Runtime.LastTargetHealth = hp
        Systems.Combat.Attack(target)
        return "COMBAT"
    end

