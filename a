    Systems.Movement = {}

    function Systems.Movement.RestoreCollision()
        local backup = Runtime.CollisionBackup or {}
        for part, canCollide in pairs(backup) do
            if typeof(part) == "Instance" and part.Parent then
                pcall(function()
                    part.CanCollide = canCollide
                end)
            end
            backup[part] = nil
        end
        Runtime.CollisionBackup = backup
    end

    function Systems.Movement.ApplyNoclip()
        if not Config.Movement.NoclipDuringTween then
            return
        end
        local character = Runtime.Character
        if not character then
            return
        end
        Runtime.CollisionBackup = Runtime.CollisionBackup or {}
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if Runtime.CollisionBackup[part] == nil then
                    Runtime.CollisionBackup[part] = part.CanCollide
                end
                if part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end

    function Systems.Movement.RayParams()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local ignore = {}
        if Runtime.Character then
            table.insert(ignore, Runtime.Character)
        end
        if Runtime.LockTarget then
            table.insert(ignore, Runtime.LockTarget)
        end
        if Runtime.PinModel then
            table.insert(ignore, Runtime.PinModel)
        end
        params.FilterDescendantsInstances = ignore
        return params
    end

    function Systems.Movement.GroundedCFrame(destination, hover)
        hover = hover or (Config.Movement.GroundHover or 5)
        local cf = Util.ToCFrame(destination)
        if not cf then
            return nil
        end
        local pos = cf.Position
        local authoredY = pos.Y
        local hit = Workspace:Raycast(pos + Vector3.new(0, 90, 0), Vector3.new(0, -280, 0), Systems.Movement.RayParams())
        if hit then
            local groundedY = hit.Position.Y + hover
            -- High trainers (Zentaro ~1660): a miss-ray onto the valley floor must not drop us 400 studs.
            if authoredY - groundedY > 22 then
                pos = Vector3.new(pos.X, authoredY, pos.Z)
            else
                pos = Vector3.new(pos.X, groundedY, pos.Z)
            end
        else
            pos = pos + Vector3.new(0, hover, 0)
        end
        local lookFlat = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
        if lookFlat.Magnitude < 0.05 then
            return CFrame.new(pos)
        end
        local look = pos + lookFlat.Unit
        return CFrame.lookAt(pos, Vector3.new(look.X, pos.Y, look.Z))
    end

    function Systems.Movement.Overlapping()
        local character, _, root = Resolver.Character()
        if not character or not root then
            return false
        end
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { character }
        local ok, parts = pcall(function()
            return Workspace:GetPartBoundsInBox(root.CFrame, Vector3.new(2.4, 2.2, 2.4), params)
        end)
        if not ok or type(parts) ~= "table" then
            return false
        end
        for i = 1, #parts do
            local part = parts[i]
            if part and part.CanCollide and not part:IsDescendantOf(character) then
                return true
            end
        end
        return false
    end

    function Systems.Movement.Unstuck()
        local _, _, root = Resolver.Character()
        if not root then
            return false
        end
        -- Loot claim: standing inside drop aura looks like "stuck" — never shove the character.
        if Runtime.State == "LOOT_CHEST" or Runtime.MovePurpose == "pickup"
            or Runtime.State == "HUNT_TRAVEL" or Runtime.State == "WAITING_FOR_BOSS"
            or Runtime.State == "TRAINING"
        then
            return false
        end
        if Systems.Movement.BusyWithNpc() then
            Systems.Movement.ApplyNoclip()
            return false
        end
        if not Systems.Movement.Overlapping() then
            return false
        end
        Systems.Movement.ApplyNoclip()
        local safe = Systems.Movement.GroundedCFrame(root.CFrame, 7)
        if safe then
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = safe
            end)
            if Systems.Movement.Overlapping() then
                pcall(function()
                    root.CFrame = root.CFrame + Vector3.new(0, 18, 0)
                end)
            end
            if (os.clock() - (Runtime.LastUnstuckLog or 0)) > 2 then
                Runtime.LastUnstuckLog = os.clock()
                Logger.Info("Movement", "Unstuck to ground")
            end
            return true
        end
        pcall(function()
            root.CFrame = root.CFrame + Vector3.new(0, 14, 0)
            root.AssemblyLinearVelocity = Vector3.zero
        end)
        if (os.clock() - (Runtime.LastUnstuckLog or 0)) > 2 then
            Runtime.LastUnstuckLog = os.clock()
            Logger.Info("Movement", "Unstuck lift")
        end
        return true
    end

    function Systems.Movement.SafeRestoreCollision()
        if Systems.Movement.Overlapping() then
            Systems.Movement.Unstuck()
            if Systems.Movement.Overlapping() then
                Systems.Movement.ApplyNoclip()
                return
            end
        end
        Systems.Movement.RestoreCollision()
    end

    function Systems.Movement.IsMoving()
        return Runtime.ActiveTween ~= nil
    end

    function Systems.Movement.HasArrived(destination, range)
        range = range or Config.Movement.NpcDistance
        local _, _, root = Resolver.Character()
        if not root then
            return false
        end
        local cf = Util.ToCFrame(destination)
        if not cf then
            return false
        end
        if Util.Distance(root, cf) <= range then
            return true
        end
        if range >= 8 then
            local a, b = root.Position, cf.Position
            local flat = Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
            return flat <= range and math.abs(a.Y - b.Y) <= 28
        end
        return false
    end

    function Systems.Movement.DistanceTo(cf)
        local _, _, root = Resolver.Character()
        if not root then
            return math.huge
        end
        return Util.Distance(root, cf)
    end

    function Systems.Movement.Reached(cf, range)
        return Systems.Movement.HasArrived(cf, range or Config.Movement.NpcDistance)
    end

    function Systems.Movement.ReleaseNpcHold()
        Runtime.NpcHoldCf = nil
        local _, _, root = Resolver.Character()
        if root then
            pcall(function()
                if root.Anchored then
                    root.Anchored = false
                end
            end)
        end
    end

    function Systems.Movement.HoldNpc(destination)
        local _, _, root = Resolver.Character()
        local cf = Util.ToCFrame(destination)
        if not root or not cf then
            return false
        end
        Runtime.NpcHoldCf = cf
        Systems.Movement.FreezeLocomotion()
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.Anchored = true
            root.CFrame = cf
        end)
        return true
    end

    function Systems.Movement.Cancel(reason)
        Runtime.MoveToken = (Runtime.MoveToken or 0) + 1
        if Runtime.ActiveTween then
            pcall(function()
                Runtime.ActiveTween:Cancel()
            end)
            Runtime.ActiveTween = nil
        end
        Systems.Movement.ReleaseNpcHold()
        Runtime.MovePurpose = nil
        Runtime.MoveTarget = nil
        Runtime.MoveFollow = nil
        Runtime.MoveDestination = nil
        Runtime.MoveRange = nil
        Runtime.LandAfterHop = nil
        Runtime.MoveGoalRaw = nil
        Runtime.LockTarget = nil
        Systems.Movement.ReleasePin()
        Systems.Movement.SetCombatLock(false)
        if not Runtime.DrinkingPotion then
            Systems.Movement.UnfreezeLocomotion()
        end
        Systems.Movement.SafeRestoreCollision()
    end

    function Systems.Movement.Stop()
        Systems.Movement.Cancel("stop")
    end

    function Systems.Movement.CombatOffset(model)
        local enemyRoot = Systems.Enemy.GetRoot(model)
        if not enemyRoot then
            return nil
        end
        -- Exactly FarmBelowFeet under enemy HRP, look up so the (6, 6.25, 9) box
        -- still contains their root. Do not clamp onto the floor — noclip holds us there.
        local below = Config.Combat.FarmBelowFeet or 6.2
        local lateral = Config.Combat.FarmLateral or 2.0
        local flat = Vector3.new(enemyRoot.CFrame.LookVector.X, 0, enemyRoot.CFrame.LookVector.Z)
        if flat.Magnitude < 0.15 then
            flat = Vector3.new(1, 0, 0)
        else
            flat = flat.Unit
        end
        local pos = enemyRoot.Position - Vector3.new(0, below, 0) - flat * lateral
        local lookAt = enemyRoot.Position
        local delta = lookAt - pos
        if delta.Magnitude < 0.05 then
            lookAt = pos + Vector3.new(0, 1, 0)
            delta = lookAt - pos
        end
        local up = Vector3.new(0, 1, 0)
        if math.abs(delta.Unit:Dot(up)) > 0.98 then
            up = Vector3.new(0, 0, 1)
        end
        return CFrame.lookAt(pos, lookAt, up)
    end

    function Systems.Movement.SetCombatLock(enabled)
        local _, humanoid, root = Resolver.Character()
        if enabled then
            if humanoid and Runtime.HumanoidLockBackup == nil then
                Runtime.HumanoidLockBackup = {
                    AutoRotate = humanoid.AutoRotate,
                    PlatformStand = humanoid.PlatformStand,
                    WalkSpeed = humanoid.WalkSpeed,
                    JumpPower = humanoid.JumpPower,
                    JumpHeight = humanoid.JumpHeight,
                }
            end
            if humanoid then
                humanoid.AutoRotate = false
                humanoid.PlatformStand = true
                humanoid.WalkSpeed = 0
                pcall(function()
                    humanoid.JumpPower = 0
                    humanoid.JumpHeight = 0
                end)
            end
            if root then
                root.Anchored = false
            end
            return
        end
        local backup = Runtime.HumanoidLockBackup
        Runtime.HumanoidLockBackup = nil
        Runtime.AutoRotateWas = nil
        if humanoid and backup then
            humanoid.AutoRotate = backup.AutoRotate
            humanoid.PlatformStand = backup.PlatformStand
            humanoid.WalkSpeed = backup.WalkSpeed
            pcall(function()
                humanoid.JumpPower = backup.JumpPower
                humanoid.JumpHeight = backup.JumpHeight
            end)
        end
        if root and root.Anchored then
            root.Anchored = false
        end
    end

    function Systems.Movement.StripKnockback(root)
        if not root then
            return
        end
        for _, child in ipairs(root:GetChildren()) do
            local name = child.Name
            if name == "combat_knockback" or name == "combat_knockbackLast" then
                pcall(function()
                    child:Destroy()
                end)
            end
        end
    end

    function Systems.Movement.ReleasePin()
        local model = Runtime.PinModel
        local backup = Runtime.PinHumBackup
        Runtime.PinModel = nil
        Runtime.PinCFrame = nil
        Runtime.PinHumBackup = nil
        if not model or not model.Parent then
            return
        end
        local hum = model:FindFirstChildOfClass("Humanoid")
        local root = Systems.Enemy.GetRoot(model)
        if hum and backup then
            pcall(function()
                hum.PlatformStand = backup.PlatformStand
                hum.AutoRotate = backup.AutoRotate
            end)
        end
        if root then
            pcall(function()
                root.Anchored = false
            end)
        end
    end

    function Systems.Movement.PlayingTracks(model)
        local tracks = {}
        if not model then
            return tracks
        end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if not hum then
            return tracks
        end
        local seen = {}
        local function take(list)
            if type(list) ~= "table" then
                return
            end
            for i = 1, #list do
                local track = list[i]
                if track and not seen[track] then
                    seen[track] = true
                    tracks[#tracks + 1] = track
                end
            end
        end
        pcall(function()
            take(hum:GetPlayingAnimationTracks())
        end)
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            pcall(function()
                take(animator:GetPlayingAnimationTracks())
            end)
        end
        return tracks
    end

    function Systems.Movement.IsSwingTrack(track)
        if not track then
            return false
        end
        local anim = track.Animation
        local name = string.lower(tostring((anim and anim.Name) or track.Name or ""))
        return string.find(name, "swing", 1, true)
            or string.find(name, "react", 1, true)
            or string.find(name, "combat", 1, true)
            or string.find(name, "hit", 1, true)
            or string.find(name, "punch", 1, true)
    end

    function Systems.Movement.IsLocoTrack(track)
        if not track then
            return false
        end
        local anim = track.Animation
        local name = string.lower(tostring((anim and anim.Name) or track.Name or ""))
        return string.find(name, "walk", 1, true)
            or string.find(name, "run", 1, true)
            or string.find(name, "jump", 1, true)
            or string.find(name, "fall", 1, true)
            or string.find(name, "climb", 1, true)
            or string.find(name, "swim", 1, true)
            or string.find(name, "land", 1, true)
    end

    -- CFrame tween makes default Animate load walk/jump forever until the 64-track cap (yellow warning).
    function Systems.Movement.PruneLocomotionTracks()
        local now = os.clock()
        local hunting = Runtime.State == "HUNT_TRAVEL" or Runtime.State == "LOOT_CHEST"
            or Runtime.MovePurpose == "hunt" or Runtime.MovePurpose == "pickup"
        local gap = hunting and 0.2 or 0.4
        if Runtime.LastAnimPrune and (now - Runtime.LastAnimPrune) < gap then
            return
        end
        local char = Runtime.Character or LocalPlayer.Character
        if not char then
            return
        end
        local tracks = Systems.Movement.PlayingTracks(char)
        local n = #tracks
        if hunting then
            if n < 16 then
                return
            end
        elseif n < 24 then
            return
        end
        Runtime.LastAnimPrune = now
        local aggressive = n >= 40 or hunting
        for i = 1, n do
            local track = tracks[i]
            if track and not Systems.Movement.IsSwingTrack(track) then
                if aggressive or Systems.Movement.IsLocoTrack(track) then
                    pcall(function()
                        track:Stop(0)
                    end)
                end
            end
        end
    end

    function Systems.Movement.FreezeLocomotion()
        local char = Runtime.Character
        local hum = Runtime.Humanoid
        if not char then
            return
        end
        Runtime.AnimateFrozen = true
        local animate = char:FindFirstChild("Animate")
        if animate then
            pcall(function()
                animate.Disabled = true
            end)
        end
        if hum and not Runtime.LockTarget then
            pcall(function()
                hum.AutoRotate = false
                hum.PlatformStand = true
                hum:ChangeState(Enum.HumanoidStateType.Physics)
            end)
        end
        Systems.Movement.PruneLocomotionTracks()
    end

    function Systems.Movement.UnfreezeLocomotion()
        if Runtime.DrinkingPotion then
            return
        end
        if Runtime.LockTarget or Runtime.ActiveTween or Runtime.MovePurpose == "combat" or Runtime.NpcHoldCf then
            return
        end
        Runtime.AnimateFrozen = false
        local char = Runtime.Character
        local hum = Runtime.Humanoid
        local animate = char and char:FindFirstChild("Animate")
        if animate then
            pcall(function()
                animate.Disabled = false
            end)
        end
        if hum and not Runtime.HumanoidLockBackup then
            pcall(function()
                hum.PlatformStand = false
                hum.AutoRotate = true
            end)
        end
    end

    function Systems.Movement.StripAnimTracks(model, keep)
        if not model then
            return
        end
        -- Never strip LocalPlayer tracks — stops Animate.totalWeight and kills M1 after a few swings.
        if model == LocalPlayer.Character then
            return
        end
        keep = keep or 8
        local tracks = Systems.Movement.PlayingTracks(model)
        if #tracks < 40 and #tracks <= keep then
            return
        end
        if #tracks > 48 then
            keep = 4
        end
        local extra = #tracks - keep
        if extra <= 0 then
            return
        end
        for i = 1, extra do
            pcall(function()
                tracks[i]:Stop(0)
            end)
        end
    end

    function Systems.Movement.IsBossModel(model)
        if not model then
            return false
        end
        local code = Systems.Enemy.GetNpcCode(model)
        if code and EnemyDB[code] and EnemyDB[code].Boss then
            return true
        end
        local name = string.lower(tostring(model.Name))
        return string.find(name, "hoyuzo", 1, true)
            or string.find(name, "kaiden", 1, true)
            or string.find(name, "zuko", 1, true)
            or string.find(name, "mother", 1, true)
    end

    function Systems.Movement.PinEnemy(model)
        if Config.Combat.PinTarget == false or not model then
            return
        end
        local enemyRoot = Systems.Enemy.GetRoot(model)
        if not enemyRoot then
            return
        end
        local isBoss = Systems.Movement.IsBossModel(model)
        if isBoss and Config.Combat.PinBosses == false then
            -- Soft pin only: strip knockback, never Anchor (server hitbox desyncs).
            Systems.Movement.StripKnockback(enemyRoot)
            pcall(function()
                enemyRoot.AssemblyLinearVelocity = Vector3.zero
                enemyRoot.AssemblyAngularVelocity = Vector3.zero
            end)
            if Runtime.PinModel and Runtime.PinModel ~= model then
                Systems.Movement.ReleasePin()
            end
            return
        end
        if Runtime.PinModel ~= model then
            Systems.Movement.ReleasePin()
            Runtime.PinModel = model
            Runtime.PinCFrame = enemyRoot.CFrame
            local hum = model:FindFirstChildOfClass("Humanoid")
            if hum then
                Runtime.PinHumBackup = {
                    PlatformStand = hum.PlatformStand,
                    AutoRotate = hum.AutoRotate,
                }
            end
        end
        local pin = Runtime.PinCFrame
        local hum = model:FindFirstChildOfClass("Humanoid")
        Systems.Movement.StripKnockback(enemyRoot)
        pcall(function()
            if hum then
                hum.PlatformStand = true
                hum.AutoRotate = false
            end
            enemyRoot.Anchored = true
            enemyRoot.AssemblyLinearVelocity = Vector3.zero
            enemyRoot.AssemblyAngularVelocity = Vector3.zero
            if pin then
                enemyRoot.CFrame = pin
            end
        end)
    end

    function Systems.Movement.ApplyCombatLock()
        if Runtime.DrinkingPotion then
            return
        end
        local model = Runtime.LockTarget
        if not model then
            if Runtime.PinModel then
                Systems.Movement.ReleasePin()
            end
            return
        end
        if not Systems.Enemy.IsAlive(model) then
            Runtime.LockTarget = nil
            Systems.Movement.ReleasePin()
            Systems.Movement.SetCombatLock(false)
            return
        end
        Systems.Movement.PinEnemy(model)
        local offset = Systems.Movement.CombatOffset(model)
        local _, _, root = Resolver.Character()
        if not offset or not root then
            return
        end
        Systems.Movement.ApplyNoclip()
        Systems.Movement.SetCombatLock(true)
        pcall(function()
            root.Anchored = false
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = offset
        end)
        Runtime.MovePurpose = "combat"
        Runtime.MoveFollow = model
        Runtime.MoveDestination = offset
        Runtime.MoveRange = Config.Combat.FarmPositionTolerance or 1.25
    end

    function Systems.Movement.HoldCombat(model)
        if Runtime.DrinkingPotion then
            return false
        end
        if not model then
            return false
        end
        Runtime.LockTarget = model
        Systems.Movement.ApplyCombatLock()
        return true
    end

    function Systems.Movement.Teleport(cf)
        return Systems.Movement.MoveTo(cf, Config.Movement.NpcDistance)
    end

    function Systems.Movement.TeleportToNPC(npcName, fallbackCFrame)
        return Systems.Movement.MoveToNPC(npcName, fallbackCFrame)
    end

    function Systems.Movement.BindHeartbeat()
        trackConnection("Heartbeat", RunService.Heartbeat:Connect(function()
            if not stillCurrent() then
                return
            end
            Systems.Movement.ApplyCombatLock()
            if Runtime.NpcHoldCf then
                local _, _, root = Resolver.Character()
                if root then
                    pcall(function()
                        if not root.Anchored then
                            root.Anchored = true
                        end
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        if (root.Position - Runtime.NpcHoldCf.Position).Magnitude > 1.5 then
                            root.CFrame = Runtime.NpcHoldCf
                        end
                    end)
                end
                Systems.Movement.FreezeLocomotion()
                return
            end
            if Runtime.ActiveTween or Runtime.LockTarget or Runtime.MovePurpose or Systems.Movement.BusyWithNpc() then
                Systems.Movement.ApplyNoclip()
                if Runtime.ActiveTween or Runtime.MovePurpose == "travel" or Runtime.MovePurpose == "npc"
                    or Runtime.MovePurpose == "hunt" or Runtime.State == "HUNT_TRAVEL"
                then
                    Systems.Movement.FreezeLocomotion()
                end
            elseif Systems.Movement.Overlapping() then
                Systems.Movement.ApplyNoclip()
                if not Runtime.ActiveTween and not Runtime.LockTarget
                    and Runtime.State ~= "LOOT_CHEST"
                    and Runtime.State ~= "HUNT_TRAVEL"
                    and Runtime.State ~= "TRAINING"
                    and Runtime.MovePurpose ~= "pickup"
                then
                    Systems.Movement.Unstuck()
                end
            end
        end))
        trackConnection("Stepped", RunService.Stepped:Connect(function()
            if not stillCurrent() then
                return
            end
            local model = Runtime.LockTarget or Runtime.PinModel
            if model then
                Systems.Movement.PinEnemy(model)
            end
            Systems.Movement.PruneLocomotionTracks()
        end))
    end

    function Systems.Movement.BusyWithNpc()
        local purpose = Runtime.MovePurpose
        if purpose == "npc" or purpose == "pickup" then
            return true
        end
        local state = Runtime.State
        return state == "QUEST_ACCEPT"
            or state == "QUEST_TRAVEL"
            or state == "QUEST_DELIVER"
            or state == "QUEST_COMPLETE"
            or state == "LOOT_CHEST"
            or state == "TRAINING"
    end

    function Systems.Movement.NpcRootCFrame(model, fallback)
        if typeof(model) == "Instance" then
            local part = model:FindFirstChild("HumanoidRootPart")
                or model:FindFirstChild("Torso")
                or model:FindFirstChild("UpperTorso")
                or model.PrimaryPart
            if part and part:IsA("BasePart") then
                return part.CFrame
            end
            if model:IsA("BasePart") then
                return model.CFrame
            end
            if model:IsA("Model") then
                local ok, cf = pcall(function()
                    return model:GetPivot()
                end)
                if ok and cf then
                    return cf
                end
            end
        end
        return Util.ToCFrame(fallback)
    end

    function Systems.Movement.IsBesideNpc(destination, model)
        local cf = Systems.Movement.NpcRootCFrame(model, destination)
        local _, _, root = Resolver.Character()
        if not cf or not root then
            return false
        end
        local a, b = root.Position, cf.Position
        local flat = Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
        local dy = math.abs(a.Y - b.Y)
        local maxFlat = (Config.Movement.NpcStandDistance or 3.2) + 1.8
        local maxDy = Config.Movement.NpcStandHeight or 14
        return flat <= maxFlat and dy <= maxDy
    end

    function Systems.Movement.NpcApproachCFrame(destination, model)
        local cf = Systems.Movement.NpcRootCFrame(model, destination)
        if not cf then
            return nil
        end
        local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
        if look.Magnitude < 0.08 then
            local _, _, root = Resolver.Character()
            if root then
                local away = Vector3.new(root.Position.X - cf.Position.X, 0, root.Position.Z - cf.Position.Z)
                if away.Magnitude > 0.08 then
                    look = away.Unit
                else
                    look = Vector3.new(0, 0, -1)
                end
            else
                look = Vector3.new(0, 0, -1)
            end
        else
            look = look.Unit
        end
        local standDist = Config.Movement.NpcStandDistance or 3.2
        local stand = cf.Position + look * standDist
        stand = Vector3.new(stand.X, cf.Position.Y, stand.Z)
        return CFrame.lookAt(stand, Vector3.new(cf.Position.X, stand.Y, cf.Position.Z))
    end

    function Systems.Movement.StartTween(destination, range, purpose, followInst)
        if Runtime.DrinkingPotion then
            return false, "drinking"
        end
        if not Config.AutoTravel then
            return Systems.Movement.HasArrived(destination, range)
        end
        local _, _, root = Resolver.Character()
        if not root then
            return false, "no root"
        end
        local cf = Util.ToCFrame(destination)
        if not cf then
            return false, "no dest"
        end
        range = range or Config.Movement.NpcDistance
        local skipHop = Runtime.SkipHop == true
        Runtime.SkipHop = nil
        local landAfter = nil
        local goal = cf
        if purpose == "combat" then
            goal = cf
        elseif purpose == "pickup" then
            -- Chest/drop: walk the ground to the item. Never hop/fly.
            goal = cf
            skipHop = true
        elseif purpose == "npc" then
            local flat = Vector3.new(root.Position.X - cf.Position.X, 0, root.Position.Z - cf.Position.Z).Magnitude
            local hopDist = Config.Movement.HopDistance or 22
            local lift = Config.Movement.FlyClearance or 42
            if not skipHop and flat > hopDist then
                landAfter = cf
                local highY = math.max(root.Position.Y, cf.Position.Y) + lift
                goal = CFrame.new(cf.Position.X, highY, cf.Position.Z)
            else
                goal = cf
            end
        else
            local hover = Config.Movement.GroundHover or 5
            goal = Systems.Movement.GroundedCFrame(cf, hover) or CFrame.new(cf.Position.X, cf.Position.Y + 3, cf.Position.Z)
            local flat = Vector3.new(root.Position.X - goal.Position.X, 0, root.Position.Z - goal.Position.Z).Magnitude
            local hopDist = (purpose == "hunt") and 40 or (Config.Movement.HopDistance or 22)
            local lift = Config.Movement.FlyClearance or 42
            if not skipHop and flat > hopDist then
                landAfter = goal
                local highY = math.max(root.Position.Y, goal.Position.Y) + lift
                goal = CFrame.new(goal.Position.X, highY, goal.Position.Z)
            end
        end
        if not landAfter and Systems.Movement.HasArrived(goal, range) then
            if purpose ~= "npc" and purpose ~= "pickup" and purpose ~= "combat" and Systems.Movement.Overlapping() then
                Systems.Movement.Unstuck()
            end
            if Runtime.ActiveTween and Runtime.MovePurpose == purpose then
                Systems.Movement.Cancel("arrived")
            end
            return true
        end
        if Runtime.ActiveTween and Runtime.MovePurpose and Runtime.MovePurpose ~= purpose then
            Systems.Movement.Cancel("purpose-change")
        end
        if Runtime.ActiveTween and Runtime.MovePurpose == purpose then
            local settled = (landAfter or goal).Position
            if followInst and followInst == Runtime.MoveFollow and Runtime.MoveDestination then
                local latest = Systems.Movement.CombatOffset(followInst)
                if latest and (latest.Position - Runtime.MoveDestination.Position).Magnitude < (Config.Movement.TargetRepathDistance or 5) then
                    return false, "moving"
                end
            elseif not followInst and Runtime.MoveGoalRaw then
                local repath = 2.5
                if purpose == "travel" or purpose == "hunt" then
                    repath = 48
                elseif purpose == "pickup" then
                    repath = 18
                end
                local flatDelta = Vector3.new(settled.X - Runtime.MoveGoalRaw.X, 0, settled.Z - Runtime.MoveGoalRaw.Z).Magnitude
                if flatDelta < repath then
                    return false, "moving"
                end
            end
        end
        local token = (Runtime.MoveToken or 0) + 1
        Runtime.MoveToken = token
        if Runtime.ActiveTween then
            pcall(function()
                Runtime.ActiveTween:Cancel()
            end)
            Runtime.ActiveTween = nil
        end
        local dist = Util.Distance(root, goal)
        local speed = Config.Movement.TweenSpeed
        if not speed or speed <= 0 then
            speed = 250
        end
        local duration = math.max(0.05, dist / speed)
        if Runtime.NpcHoldCf then
            Systems.Movement.ReleaseNpcHold()
        elseif root.Anchored then
            pcall(function()
                root.Anchored = false
            end)
        end
        Systems.Movement.ApplyNoclip()
        Systems.Movement.FreezeLocomotion()
        local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = goal })
        Runtime.ActiveTween = tween
        Runtime.MovePurpose = purpose
        Runtime.MoveTarget = destination
        Runtime.MoveFollow = followInst
        Runtime.MoveDestination = goal
        Runtime.MoveGoalRaw = (landAfter or goal).Position
        Runtime.MoveRange = range
        Runtime.LandAfterHop = landAfter
        tween:Play()
        tween.Completed:Connect(function()
            if not stillCurrent() or Runtime.MoveToken ~= token then
                return
            end
            if Runtime.ActiveTween == tween then
                Runtime.ActiveTween = nil
            end
            local land = Runtime.LandAfterHop
            if land and purpose ~= "combat" then
                Runtime.LandAfterHop = nil
                Runtime.SkipHop = true
                Systems.Movement.StartTween(land, range, purpose, followInst)
                return
            end
            if purpose == "combat" then
                if followInst then
                    Systems.Movement.HoldCombat(followInst)
                end
                return
            end
            if purpose == "npc" or purpose == "pickup" then
                if purpose == "npc" then
                    Systems.Movement.HoldNpc(land or goal)
                end
                return
            end
            if purpose == "hunt" then
                Systems.Movement.FreezeLocomotion()
                return
            end
            if purpose == "travel" then
                Systems.Movement.FreezeLocomotion()
                if Systems.Movement.Overlapping() then
                    Systems.Movement.ApplyNoclip()
                else
                    Systems.Movement.SafeRestoreCollision()
                end
                return
            end
            Systems.Movement.Unstuck()
            Systems.Movement.SafeRestoreCollision()
            Runtime.MovePurpose = nil
            Runtime.MoveFollow = nil
            Runtime.LandAfterHop = nil
            Systems.Movement.UnfreezeLocomotion()
        end)
        return false, "started"
    end

    function Systems.Movement.Update()
        if Runtime.DrinkingPotion then
            if Runtime.ActiveTween then
                Systems.Movement.Cancel("drinking")
            end
            return
        end
        local _, _, root = Resolver.Character()
        if not root then
            if Runtime.ActiveTween then
                Systems.Movement.Cancel("no-root")
            end
            return
        end
        if Runtime.MoveFollow then
            if not Systems.Enemy.IsAlive(Runtime.MoveFollow) then
                Systems.Movement.Cancel("follow-dead")
                Systems.Enemy.InvalidateTarget()
                return
            end
            local latest = Systems.Movement.CombatOffset(Runtime.MoveFollow)
            if latest then
                local tol = Config.Combat.FarmPositionTolerance or 1.25
                if Systems.Movement.HasArrived(latest, tol) then
                    if Runtime.ActiveTween then
                        pcall(function()
                            Runtime.ActiveTween:Cancel()
                        end)
                        Runtime.ActiveTween = nil
                    end
                    Systems.Movement.HoldCombat(Runtime.MoveFollow)
                    return
                end
                local dest = Runtime.MoveDestination
                local threshold = Config.Combat.RepositionThreshold or 1
                if not dest or (latest.Position - dest.Position).Magnitude >= threshold then
                    Systems.Movement.StartTween(latest, tol, "combat", Runtime.MoveFollow)
                end
            end
            return
        end
        if Runtime.LandAfterHop then
            return
        end
        if Runtime.MoveDestination and Systems.Movement.HasArrived(Runtime.MoveDestination, Runtime.MoveRange or Config.Movement.NpcDistance) then
            if Runtime.ActiveTween then
                pcall(function()
                    Runtime.ActiveTween:Cancel()
                end)
                Runtime.ActiveTween = nil
            end
            if Runtime.MovePurpose == "npc" then
                Systems.Movement.HoldNpc(Runtime.MoveDestination)
                return
            end
            if Runtime.MovePurpose ~= "pickup" and Runtime.MovePurpose ~= "combat" then
                Systems.Movement.Unstuck()
                Systems.Movement.SafeRestoreCollision()
            end
            Runtime.MovePurpose = nil
            Runtime.MoveFollow = nil
            Runtime.LandAfterHop = nil
        end
    end

    function Systems.Movement.MoveToNPC(npcName, fallbackCFrame)
        local model = Resolver.FindWorldNpcModel(npcName)
        local raw = Systems.Movement.NpcRootCFrame(model, fallbackCFrame)
            or (npcName and NpcDB[npcName] and NpcDB[npcName].CFrame)
        raw = Util.ToCFrame(raw)
        if not raw then
            return false, "npc missing"
        end
        local dest = Systems.Movement.NpcApproachCFrame(raw, model) or raw
        if Systems.Movement.IsBesideNpc(raw, model) then
            Systems.Movement.HoldNpc(dest)
            return true
        end
        local _, _, root = Resolver.Character()
        if root then
            local flat = Vector3.new(root.Position.X - dest.Position.X, 0, root.Position.Z - dest.Position.Z).Magnitude
            -- Already at the cliff XZ (Zentaro): snap up to stand height instead of falling through noclip.
            if flat <= 10 then
                Systems.Movement.HoldNpc(dest)
                if Systems.Movement.IsBesideNpc(raw, model) then
                    return true
                end
            end
        end
        if Runtime.NpcHoldCf then
            Systems.Movement.ReleaseNpcHold()
        end
        local stamp = tostring(npcName) .. tostring(dest)
        if Runtime.LastNpcTweenStamp ~= stamp then
            Runtime.LastNpcTweenStamp = stamp
            Logger.Info("Quest", "Tween NPC " .. tostring(npcName))
        end
        Systems.Movement.StartTween(dest, 4, "npc")
        return false, "moving"
    end

