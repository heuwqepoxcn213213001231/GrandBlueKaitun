    local DisplayToCode = {}
    local CompactToCode = {}
    local function compactNpcName(name)
        if type(name) ~= "string" then
            return ""
        end
        return string.lower((string.gsub(name, "[%s%p]+", "")))
    end
    local function rememberDisplay(label, code)
        if type(label) ~= "string" or label == "" then
            return
        end
        DisplayToCode[label] = code
        local compact = compactNpcName(label)
        if compact ~= "" then
            local prev = CompactToCode[compact]
            if not prev or #compact >= #compactNpcName(prev) then
                CompactToCode[compact] = code
            end
        end
    end
    for code, def in pairs(EnemyDB) do
        rememberDisplay(code, code)
        if def.Display then
            for i = 1, #def.Display do
                rememberDisplay(def.Display[i], code)
            end
        end
    end

