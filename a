    Systems.Enemy = {}

    function Systems.Enemy.CacheActiveFolders()
        if Runtime.ActiveNpcFolderCache and (os.clock() - Runtime.ActiveNpcFolderAt) < 4 then
            return Runtime.ActiveNpcFolderCache
        end
        local folders = {}
        local humanoids = Workspace:FindFirstChild("Humanoids")
        local regions = humanoids and humanoids:FindFirstChild("Regions")
        if regions then
            for _, region in ipairs(regions:GetChildren()) do
                local active = region:FindFirstChild("ActiveNpcs")
                if active then
                    table.insert(folders, active)
                end
            end
        end
        Runtime.ActiveNpcFolderCache = folders
        Runtime.ActiveNpcFolderAt = os.clock()
        return folders
    end

    function Systems.Enemy.NameToCode(name)
        if type(name) ~= "string" or name == "" then
            return nil
        end
        if DisplayToCode[name] then
            return DisplayToCode[name]
        end
        if EnemyDB[name] then
            return name
        end
        local compact = compactNpcName(name)
        if compact == "" then
            return nil
        end
        if CompactToCode[compact] then
            return CompactToCode[compact]
        end
        local best, bestLen
        for code, _ in pairs(EnemyDB) do
            local cc = compactNpcName(code)
            if cc ~= "" and (#compact >= #cc) and string.sub(compact, 1, #cc) == cc then
                if not bestLen or #cc > bestLen then
                    best = code
                    bestLen = #cc
                end
            end
        end
        for label, code in pairs(DisplayToCode) do
            local cc = compactNpcName(label)
            if cc ~= "" and (#compact >= #cc) and string.sub(compact, 1, #cc) == cc then
                if not bestLen or #cc > bestLen then
                    best = code
                    bestLen = #cc
                end
            end
        end
        return best
    end

    function Systems.Enemy.GetNpcCode(model)
        if not model then
            return nil
        end
        local chain = { model }
        local cursor = model.Parent
        for _ = 1, 8 do
            if not cursor or cursor.Name == "ActiveNpcs" or cursor == Workspace then
                break
            end
            table.insert(chain, cursor)
            cursor = cursor.Parent
        end
        for i = 1, #chain do
            local inst = chain[i]
            if inst then
                local attr = inst:GetAttribute("NpcCode")
                if type(attr) == "string" and attr ~= "" then
                    return attr
                end
                local bossInfo = inst:FindFirstChild("BossInfo")
                if bossInfo then
                    local code = bossInfo:GetAttribute("NpcCode")
                    if type(code) == "string" and code ~= "" then
                        return code
                    end
                end
                local settings = inst:FindFirstChild("Settings")
                if settings then
                    local sv = settings:FindFirstChild("NpcCode")
                    if sv and sv:IsA("ValueBase") and tostring(sv.Value) ~= "" then
                        return tostring(sv.Value)
                    end
                    local sattr = settings:GetAttribute("NpcCode")
                    if type(sattr) == "string" and sattr ~= "" then
                        return sattr
                    end
                end
                local fromName = Systems.Enemy.NameToCode(inst.Name)
                if fromName then
                    return fromName
                end
            end
        end
        local unique = model:GetAttribute("UniqueName")
        if type(unique) == "string" and unique ~= "" then
            local prefix = unique:match("^%*?([^*-]+)")
            local fromUnique = prefix and Systems.Enemy.NameToCode(prefix)
            if fromUnique then
                return fromUnique
            end
        end
        return Systems.Enemy.NameToCode(model.Name)
    end

    function Systems.Enemy.GetRoot(model)
        if not model then
            return nil
        end
        return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    end

    function Systems.Enemy.IsAlive(model)
        if not model or not model.Parent then
            return false
        end
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if not Util.IsAliveHumanoid(humanoid) then
            return false
        end
        local root = Systems.Enemy.GetRoot(model)
        if not root or not root.Parent then
            return false
        end
        return true
    end

    function Systems.Enemy.HasDied(model)
        return not Systems.Enemy.IsAlive(model)
    end

    function Systems.Enemy.IsValidTarget(model, expectedCode)
        if not Systems.Enemy.IsAlive(model) then
            return false
        end
        if model == Runtime.Character then
            return false
        end
        local underActive = false
        local cursor = model
        for _ = 1, 8 do
            if not cursor then
                break
            end
            if cursor.Name == "ActiveNpcs" then
                underActive = true
                break
            end
            cursor = cursor.Parent
        end
        if not underActive then
            return false
        end
        local code = Systems.Enemy.GetNpcCode(model)
        if expectedCode and code ~= expectedCode then
            return false
        end
        return true
    end

    function Systems.Enemy.CollectModels(folder, into, depth)
        depth = depth or 0
        if not folder or depth > 6 then
            return
        end
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") and child:FindFirstChildOfClass("Humanoid") then
                table.insert(into, child)
            elseif (child:IsA("Folder") or child:IsA("Model")) and child.Name ~= "HumanoidRootPart" then
                Systems.Enemy.CollectModels(child, into, depth + 1)
            end
        end
    end

    function Systems.Enemy.FindAliveTargets(npcCode, silent)
        local results = {}
        local scanned = 0
        local folders = Systems.Enemy.CacheActiveFolders()
        for i = 1, #folders do
            local models = {}
            Systems.Enemy.CollectModels(folders[i], models)
            scanned = scanned + #models
            for m = 1, #models do
                if Systems.Enemy.IsValidTarget(models[m], npcCode) then
                    table.insert(results, models[m])
                end
            end
        end
        if not silent and npcCode and #results == 0 and scanned > 0 then
            Runtime.LastEnemyMissAt = Runtime.LastEnemyMissAt or {}
            local last = Runtime.LastEnemyMissAt[npcCode] or 0
            if os.clock() - last > 20 then
                Runtime.LastEnemyMissAt[npcCode] = os.clock()
                Logger.Debug("Combat", "No live " .. tostring(npcCode) .. " (scanned " .. tostring(scanned) .. " ActiveNpcs models)")
            end
        end
        return results
    end

    function Systems.Enemy.FindNearestTarget(npcCode, fromPosition, silent)
        local _, _, root = Resolver.Character()
        fromPosition = fromPosition or (root and root.Position)
        local best, bestDist
        local targets = Systems.Enemy.FindAliveTargets(npcCode, silent)
        for i = 1, #targets do
            local enemyRoot = Systems.Enemy.GetRoot(targets[i])
            if enemyRoot then
                local dist = fromPosition and (enemyRoot.Position - fromPosition).Magnitude or 0
                if not bestDist or dist < bestDist then
                    bestDist = dist
                    best = targets[i]
                end
            end
        end
        return best, bestDist
    end

    Systems.BossOpportunity = Systems.BossOpportunity or {}

    function Systems.BossOpportunity.IsAlive(npcCode)
        if not npcCode then
            return false
        end
        local spawn = Systems.BossOpportunity.GetSpawn(npcCode)
        if spawn then
            return spawn.Alive == true
        end
        Runtime.BossAliveCache = Runtime.BossAliveCache or {}
        local interval = (Config.Boss and Config.Boss.AvailabilityCheckInterval) or 2
        local cached = Runtime.BossAliveCache[npcCode]
        if cached and (os.clock() - cached.At) < interval then
            return cached.Alive == true
        end
        local alive = select(1, Systems.Enemy.FindNearestTarget(npcCode, nil, true)) ~= nil
        Runtime.BossAliveCache[npcCode] = { Alive = alive, At = os.clock() }
        return alive
    end

    function Systems.BossOpportunity.Clear()
        Runtime.PendingOpportunity = nil
        Runtime.PendingBossQuest = nil
    end

    function Systems.BossOpportunity.Check()
        if not Config.AutoBoss then
            return
        end
        local now = os.clock()
        local interval = (Config.Boss and Config.Boss.AvailabilityCheckInterval) or 2
        if Runtime.LastBossCheckAt and (now - Runtime.LastBossCheckAt) < interval then
            return
        end
        Runtime.LastBossCheckAt = now
        local best = nil
        local huntAll = (Game.PlayerData.GetLevel() or 0) >= (Config.Boss.HuntFromLevel or 70)
        if huntAll then
            best = Systems.BossOpportunity.PickPatrol()
            if not best then
                Systems.BossOpportunity.LogTimers()
                if Runtime.PendingBossQuest then
                    Logger.Info("Boss", "no boss due; resume quest farm")
                    Systems.BossOpportunity.Clear()
                end
                return
            end
        else
            best = Systems.BossOpportunity.PickBestLive()
            if not best then
                if Runtime.PendingBossQuest then
                    Logger.Info("Boss", "no live boss; resume quest farm")
                    Systems.BossOpportunity.Clear()
                end
                return
            end
        end
        local key = best.Key
        local def = best.Def
        if not key or not def then
            return
        end
        if Game.PlayerData.GetQuestByKey(key) then
            Runtime.PendingBossQuest = key
            return
        end
        local current = Runtime.CurrentQuest
        if current and current ~= key then
            if Runtime.PendingBossQuest ~= key then
                local hunt = (Game.PlayerData.GetLevel() or 0) >= (Config.Boss.HuntFromLevel or 70)
                Logger.Info("Boss", tostring(def.TargetCode) .. " Lv" .. tostring(def.MinLevel or "?") .. (hunt and " hunt" or "") .. " available")
            end
        end
        Runtime.PendingBossQuest = key
        Runtime.PendingOpportunity = {
            Type = "Boss",
            QuestKey = key,
            TargetCode = def.TargetCode,
            SeenAt = now,
        }
    end

    function Systems.Enemy.InvalidateTarget()
        if Systems.Movement and Systems.Movement.Cancel and Runtime.MovePurpose == "combat" then
            Systems.Movement.Cancel("target-invalid")
        end
        Runtime.CurrentTarget = nil
        Runtime.LockTarget = nil
        Runtime.LastTargetHealth = nil
        if Systems.Movement then
            if Systems.Movement.ReleasePin then
                Systems.Movement.ReleasePin()
            end
            if Systems.Movement.SetCombatLock then
                Systems.Movement.SetCombatLock(false)
            end
        end
    end

    function Systems.Enemy.ValidateCurrent(expectedCode)
        local target = Runtime.CurrentTarget
        if not target or not Systems.Enemy.IsValidTarget(target, expectedCode) then
            Systems.Enemy.InvalidateTarget()
            return nil
        end
        return target
    end

