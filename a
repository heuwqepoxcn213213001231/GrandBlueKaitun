function Systems.Watchdog.MarkProgress()
    Runtime.LastProgressAt = os.clock()
end

    function Systems.Watchdog.Tick()
        local now = Systems.Watchdog.Fingerprint()
        local prev = Runtime.WatchFingerprint
        if prev then
            local diffs = {}
            for k, v in pairs(now) do
                if prev[k] ~= v then
                    diffs[#diffs + 1] = k .. "=" .. tostring(prev[k]) .. "→" .. tostring(v)
                    if k == "Exp" or k == "Goal" or k == "Level" or k == "TaskValue" or k == "Holders" or k == "Quest" or k == "Wen" then
                        Systems.Watchdog.MarkProgress()
                    elseif k == "Health" and type(v) == "number" and type(prev[k]) == "number" and v < prev[k] then
                        Systems.Watchdog.MarkProgress()
                    elseif (k == "Pos" or k == "Tween") and (Runtime.State == "WAIT_RESPAWN" or Runtime.State == "WAITING_FOR_BOSS" or Runtime.State == "FARM_TRAVEL" or Runtime.State == "QUEST_TRAVEL" or Runtime.State == "HUNT_TRAVEL" or Runtime.State == "PLAYER_DEAD" or Runtime.State == "ROOT_MISSING" or Runtime.State == "LOOT_CHEST" or Runtime.State == "BOSS_PREEMPT" or Runtime.State == "TRAINING") then
                        Systems.Watchdog.MarkProgress()
                    end
                end
            end
            if #diffs > 0 then
                Logger.Debug("Watchdog", "diff " .. table.concat(diffs, "; "))
            end
        end
        Runtime.WatchFingerprint = now
        local timeout = Systems.Watchdog.TimeoutFor(Runtime.State)
        if os.clock() - Runtime.LastProgressAt <= timeout then
            return
        end
        Logger.Warn("Watchdog", "Timeout in " .. tostring(Runtime.State) .. " after " .. string.format("%.1f", timeout) .. "s")
        Logger.Debug("Snapshot", Progression.DebugSnapshot())
        if Runtime.State == "FARM_COMBAT" then
            Systems.Recovery.Handle("COMBAT_NO_DAMAGE")
            return
        end
        if Runtime.State == "QUEST_ACCEPT" then
            Systems.Recovery.Handle("QUEST_ACCEPT_FAILED")
            return
        end
        if Runtime.State == "POTION_DRINK" then
            Runtime.DrinkingPotion = false
            Runtime.PotionUntil = 0
            Systems.Potion.SetEquippedSlot(1)
            Systems.Combat.EquipBest()
            Logger.Warn("Potion", "Drink watchdog timeout — resume farm")
            return
        end
        if Runtime.State == "FARM_TRAVEL" or Runtime.State == "QUEST_TRAVEL" or Runtime.State == "TRAINING" then
            Systems.Recovery.Handle("MOVEMENT_STUCK")
            return
        end
        Systems.Recovery.Handle("STALL", Runtime.State)
    end

