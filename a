    -- Loot/claim: tween to the chest on the ground, then stand on it. Never hop.
    function Systems.Movement.MoveToLoot(destination, range)
        range = range or 3.5
        local _, _, root = Resolver.Character()
        if not root then
            return false
        end
        local cf = Util.ToCFrame(destination)
        if not cf then
            return false
        end
        local dest = CFrame.new(cf.Position.X, cf.Position.Y + 2.5, cf.Position.Z)
        local dy = math.abs(root.Position.Y - dest.Position.Y)
        local flat = Vector3.new(root.Position.X - dest.Position.X, 0, root.Position.Z - dest.Position.Z).Magnitude
        if flat <= range and dy <= 6 then
            if dy > 2 then
                pcall(function()
                    root.CFrame = dest
                    root.AssemblyLinearVelocity = Vector3.zero
                end)
            end
            return true
        end
        Runtime.SkipHop = true
        Systems.Movement.StartTween(dest, range, "pickup")
        return false
    end

    Resolver._npcCache = {}
