    Systems.Loot = {}

    function Systems.Loot.TargetStillAlive()
        local code = (Runtime.CurrentTask and Runtime.CurrentTask.Code)
            or (Runtime.HuntPatrol and Runtime.HuntPatrol.Code)
        if not code then
            return false
        end
        local target = Runtime.CurrentTarget
        if target and Systems.Enemy.IsAlive(target) then
            local tcode = Systems.Enemy.GetNpcCode and Systems.Enemy.GetNpcCode(target)
            if tcode == nil or tcode == code then
                return true
            end
        end
        local patrol = Runtime.HuntPatrol
        if patrol and patrol.Model and Systems.Enemy.IsAlive(patrol.Model) then
            return true
        end
        local found = select(1, Systems.Enemy.FindNearestTarget(code, nil, true))
        return found ~= nil
    end

    function Systems.Loot.Abort(reason)
        Runtime.LootEmptySince = nil
        Runtime.LastLootLog = nil
        Runtime.LootUntil = nil
        Runtime.LootPhase = nil
        Runtime.LootHardUntil = 0
        Runtime.MovePurpose = nil
        if Systems.Movement.Cancel then
            Systems.Movement.Cancel("loot-abort")
        end
        Logger.Info("Loot", "Loot aborted (" .. tostring(reason or "cancel") .. ") — fight")
    end

    function Systems.Loot.PeekNearby(range)
        range = range or 52
        local _, _, root = Resolver.Character()
        if not root then
            return nil
        end
        local now = os.clock()
        local cache = Runtime.LootPeekCache
        if cache and cache.pos and (now - cache.at) < 0.5 and (cache.pos - root.Position).Magnitude < 8 then
            return cache.best
        end
        local chests, drops = Systems.Loot.GatherCandidates(root.Position, range, { Deep = false })
        local skip = Runtime.LootSkipUntil
        local function allowed(entry)
            if not entry then
                return false
            end
            local untilAt = skip and skip[tostring(entry.Inst)]
            return not (untilAt and now < untilAt)
        end
        local best
        for i = 1, #(chests or {}) do
            if allowed(chests[i]) then
                best = chests[i]
                break
            end
        end
        if not best then
            for i = 1, #(drops or {}) do
                if allowed(drops[i]) then
                    best = drops[i]
                    break
                end
            end
        end
        Runtime.LootPeekCache = { at = now, pos = root.Position, best = best }
        return best
    end

    function Systems.Loot.BeginWindow(origin, reason)
        local nearby = reason == "nearby-chest"
        if nearby then
            Runtime.LootSpent = false
        end
        if Runtime.LootSpent and not nearby
            and reason ~= "boss-dead" and reason ~= "boss-hp0" and reason ~= "boss-despawn"
        then
            return
        end
        local _, _, root = Resolver.Character()
        Runtime.LootOrigin = origin or Runtime.LastCombatPos or (root and root.Position)
        local seconds = Config.Boss.LootSeconds or 12
        local now = os.clock()
        if not Runtime.LootHardUntil or Runtime.LootHardUntil < now then
            Runtime.LootHardUntil = now + seconds
        end
        local untilAt = math.min(now + seconds, Runtime.LootHardUntil)
        if Runtime.LootUntil and Runtime.LootUntil > now then
            untilAt = math.min(math.max(Runtime.LootUntil, now + 4), Runtime.LootHardUntil)
        end
        Runtime.LootEmptySince = nil
        Runtime.LastLootLog = nil
        Runtime.LootUntil = untilAt
        Runtime.LootPhase = Runtime.LootPhase or "chest"
        Runtime.LockTarget = nil
        if Systems.Movement.ReleasePin then
            Systems.Movement.ReleasePin()
        end
        if Systems.Movement.SetCombatLock then
            Systems.Movement.SetCombatLock(false)
        end
        Logger.Info("Loot", "Loot window " .. tostring(seconds) .. "s (" .. tostring(reason or "boss") .. ")")
    end

    function Systems.Loot.ExtendWindow(seconds)
        if Runtime.LootSpent then
            return
        end
        local untilAt = os.clock() + (seconds or 6)
        if Runtime.LootHardUntil and Runtime.LootHardUntil > 0 then
            untilAt = math.min(untilAt, Runtime.LootHardUntil)
        end
        if not Runtime.LootUntil or Runtime.LootUntil < untilAt then
            Runtime.LootUntil = untilAt
        end
    end

    function Systems.Loot.EndWindow(reason)
        local code = Runtime.CurrentTask and Runtime.CurrentTask.Code
        Runtime.LootEmptySince = nil
        Runtime.LastLootLog = nil
        Runtime.LootUntil = nil
        Runtime.LootPhase = nil
        Runtime.LootHardUntil = 0
        Runtime.LootSpent = true
        Runtime.BossFightEngaged = false
        Runtime.MovePurpose = nil
        if Systems.Movement.Cancel then
            Systems.Movement.Cancel("loot-end")
        end
        if code then
            Systems.BossOpportunity.MarkMiss(code)
        end
        Logger.Info("Loot", "Loot window ended" .. (reason and (" (" .. tostring(reason) .. ")") or "") .. " — hunt next bosses")
    end

    function Systems.Loot.TagNames()
        local chest, drop = "Chest", "LootDrop"
        pcall(function()
            local cam = ReplicatedStorage:FindFirstChild("CAM") or ReplicatedStorage:FindFirstChild("CAM")
            local global = cam and cam:FindFirstChild("Global")
            local gs = global and global:FindFirstChild("gameSettings")
            if gs then
                local mod = require(gs)
                if type(mod) == "table" and type(mod.Tags) == "table" then
                    chest = mod.Tags.Chest or chest
                    drop = mod.Tags.LootDrop or drop
                end
            end
        end)
        return chest, drop
    end

    function Systems.Loot.WorldPos(inst)
        if not inst then
            return nil
        end
        if inst:IsA("ProximityPrompt") then
            local parent = inst.Parent
            if parent and parent:IsA("Attachment") then
                return parent.WorldPosition
            end
            if parent and parent:IsA("BasePart") then
                return parent.Position
            end
            if parent and parent:IsA("Model") then
                local ok, pivot = pcall(function()
                    return parent:GetPivot().Position
                end)
                if ok then
                    return pivot
                end
            end
            return Systems.Loot.WorldPos(parent)
        end
        if inst:IsA("BasePart") then
            return inst.Position
        end
        if inst:IsA("Model") then
            local ok, pos = pcall(function()
                return inst:GetPivot().Position
            end)
            if ok and typeof(pos) == "Vector3" then
                return pos
            end
            local part = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
            return part and part.Position
        end
        if inst:IsA("Attachment") then
            return inst.WorldPosition
        end
        return nil
    end

    -- Verified from ReplicatedStorage.Assets.Chests (Studio):
    -- Boss loot commonly: Common Chest, Rare Chest.
    -- Also exist: Demon Chest, Sealed Chest, Ice Chest, Snow Chest,
    -- Lost Chest, Ouwigahara Chest, World Events Chest.
    Systems.Loot.KnownTypes = {
        "Common Chest",
        "Rare Chest",
        "Demon Chest",
        "Sealed Chest",
        "Ice Chest",
        "Snow Chest",
        "Lost Chest",
        "Ouwigahara Chest",
        "World Events Chest",
    }

    function Systems.Loot.NormalizeName(text)
        return string.lower((tostring(text or ""):gsub("%s+", " ")))
    end

    function Systems.Loot.MatchKnownType(text)
        local n = Systems.Loot.NormalizeName(text)
        if n == "" then
            return nil
        end
        for i = 1, #Systems.Loot.KnownTypes do
            local known = Systems.Loot.NormalizeName(Systems.Loot.KnownTypes[i])
            if n == known or string.find(n, known, 1, true) then
                return Systems.Loot.KnownTypes[i]
            end
        end
        if string.find(n, "chest", 1, true) then
            return text
        end
        return nil
    end

    function Systems.Loot.IsOpen(inst)
        if not inst or not inst.Parent then
            return true
        end
        if inst:GetAttribute("IsOpen") == true or inst:GetAttribute("Opened") == true then
            return true
        end
        if inst:GetAttribute("DropClaimedBy") ~= nil then
            return true
        end
        local state = inst:GetAttribute("ChestState") or inst:GetAttribute("State")
        if state == "Opened" or state == "Despawned" or state == "Open" then
            return true
        end
        local prompt = inst:IsA("ProximityPrompt") and inst or inst:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and prompt.Enabled == false and (inst:GetAttribute("Opened") == true or inst:GetAttribute("IsOpen") == true) then
            return true
        end
        return false
    end

    function Systems.Loot.IsChestLike(inst)
        if not inst then
            return false
        end
        if inst:IsA("ProximityPrompt") then
            local objectText = tostring(inst.ObjectText or "")
            local actionText = string.lower(tostring(inst.ActionText or ""))
            if Systems.Loot.MatchKnownType(objectText) then
                return true
            end
            -- Boss drops show ObjectText "Rare Chest" / "Common Chest" + ActionText "Open".
            if actionText == "open" and string.find(string.lower(objectText), "chest", 1, true) then
                return true
            end
            return false
        end
        if Systems.Loot.MatchKnownType(inst.Name) then
            return true
        end
        local prompt = inst:FindFirstChildWhichIsA("ProximityPrompt", true)
        return prompt ~= nil and Systems.Loot.IsChestLike(prompt)
    end

    function Systems.Loot.IsDropLike(inst)
        if not inst or not inst.Parent then
            return false
        end
        if Systems.Loot.IsOpen(inst) then
            return false
        end
        if inst:GetAttribute("DropItemId") ~= nil or inst:GetAttribute("DropTarget") ~= nil then
            return true
        end
        if inst:IsA("ProximityPrompt") then
            local actionText = string.lower(tostring(inst.ActionText or ""))
            local objectText = string.lower(tostring(inst.ObjectText or ""))
            if actionText == "pick up" or actionText == "collect" or actionText == "claim" then
                return true
            end
            if string.find(objectText, "chest", 1, true) then
                return false
            end
            return false
        end
        local prompt = inst:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            return Systems.Loot.IsDropLike(prompt)
        end
        return false
    end

    function Systems.Loot.PressInteractKey(keyCode)
        local key = keyCode or Enum.KeyCode.T
        -- VirtualInputManager
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            vim:SendKeyEvent(true, key, false, game)
            task.wait(0.05)
            vim:SendKeyEvent(false, key, false, game)
        end)
        -- Synapse-style keypress fallbacks
        pcall(function()
            if keypress and keyrelease then
                local code = (typeof(key) == "EnumItem" and key.Value) or 0x54
                keypress(code)
                task.wait(0.05)
                keyrelease(code)
            end
        end)
    end

    function Systems.Loot.FirePrompt(inst)
        if not inst then
            return false
        end
        local prompt = inst:IsA("ProximityPrompt") and inst or inst:FindFirstChildWhichIsA("ProximityPrompt", true)
        if not prompt then
            return false
        end
        pcall(function()
            prompt.Enabled = true
            prompt.RequiresLineOfSight = false
            prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance or 0, 15)
            if prompt.HoldDuration and prompt.HoldDuration > 0 then
                -- keep hold; many loot prompts are 0
            end
        end)
        local hold = tonumber(prompt.HoldDuration) or 0
        local key = prompt.KeyboardKeyCode or Enum.KeyCode.T

        -- 1) Executor fireproximityprompt (most reliable when available)
        pcall(function()
            if fireproximityprompt then
                fireproximityprompt(prompt)
                if hold > 0 then
                    fireproximityprompt(prompt, hold)
                end
            end
        end)

        -- 2) Fire Triggered / hold signals via getconnections (custom Style prompts)
        pcall(function()
            if getconnections then
                for _, sigName in ipairs({ "Triggered", "PromptButtonHoldBegan", "PromptButtonHoldEnded" }) do
                    local ok, signal = pcall(function()
                        return prompt[sigName]
                    end)
                    if ok and signal then
                        for _, conn in ipairs(getconnections(signal)) do
                            pcall(function()
                                if conn.Fire then
                                    conn:Fire(LocalPlayer)
                                elseif conn.Function then
                                    conn.Function(LocalPlayer)
                                end
                            end)
                        end
                    end
                end
            end
        end)

        -- 3) Native InputHold
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(math.max(hold, 0.05))
            prompt:InputHoldEnd()
        end)

        -- 4) Keyboard T (what you press by hand)
        Systems.Loot.PressInteractKey(key)
        return true
    end


    function Systems.Loot.GatherCandidates(origin, range, opts)
        opts = opts or {}
        local deep = opts.Deep == true
        local chestTag, dropTag = Systems.Loot.TagNames()
        local seen = {}
        local chests = {}
        local drops = {}
        local function push(list, entry)
            list[#list + 1] = entry
        end
        local function consider(inst, kind)
            if not inst or not inst.Parent or seen[inst] then
                return
            end
            seen[inst] = true
            if Systems.Loot.IsOpen(inst) then
                return
            end
            local model = inst
            if inst:IsA("ProximityPrompt") then
                model = inst:FindFirstAncestorOfClass("Model") or inst.Parent
            end
            local pos = Systems.Loot.WorldPos(inst) or Systems.Loot.WorldPos(model)
            if not pos then
                return
            end
            if (pos - origin).Magnitude > range then
                return
            end
            local prompt = inst:IsA("ProximityPrompt") and inst or (model and model:FindFirstChildWhichIsA("ProximityPrompt", true))
                or (inst:IsA("BasePart") and inst:FindFirstChildWhichIsA("ProximityPrompt", true))
            local resolvedKind = kind
            if not resolvedKind then
                if Systems.Loot.IsChestLike(inst) or (prompt and Systems.Loot.IsChestLike(prompt)) then
                    resolvedKind = "chest"
                elseif Systems.Loot.IsDropLike(inst) or (prompt and Systems.Loot.IsDropLike(prompt)) then
                    resolvedKind = "drop"
                else
                    resolvedKind = "chest"
                end
            end
            push(resolvedKind == "drop" and drops or chests, {
                Inst = model or inst,
                Prompt = prompt,
                Pos = pos,
                Dist = (pos - origin).Magnitude,
                Kind = resolvedKind,
            })
        end
        -- Fast path: CollectionService tags only (no full Workspace scan).
        pcall(function()
            for _, inst in ipairs(CollectionService:GetTagged(chestTag)) do
                consider(inst, "chest")
            end
            for _, inst in ipairs(CollectionService:GetTagged(dropTag)) do
                consider(inst, "drop")
            end
        end)
        local folder = Workspace:FindFirstChild("Chests")
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                if Systems.Loot.IsChestLike(child) then
                    consider(child, "chest")
                end
            end
        end
        -- Deep scan only while actively looting (throttled). Never every Evaluate tick.
        if deep then
            local now = os.clock()
            if not Runtime.LootDeepScanAt or (now - Runtime.LootDeepScanAt) >= 0.85 then
                Runtime.LootDeepScanAt = now
                -- Spatial query near origin — NEVER full Workspace:GetDescendants (that lagged the game).
                pcall(function()
                    local params = OverlapParams.new()
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    local parts = Workspace:GetPartBoundsInRadius(origin, range, params)
                    for i = 1, math.min(#parts, 120) do
                        local part = parts[i]
                        local prompt = part:FindFirstChildWhichIsA("ProximityPrompt")
                            or (part.Parent and part.Parent:FindFirstChildWhichIsA("ProximityPrompt"))
                        if prompt then
                            local objectText = string.lower(tostring(prompt.ObjectText or ""))
                            local actionText = string.lower(tostring(prompt.ActionText or ""))
                            if string.find(objectText, "chest", 1, true) or actionText == "open" then
                                consider(prompt, "chest")
                            elseif actionText == "claim" or actionText == "pick up" or actionText == "collect" or actionText == "take" then
                                consider(prompt, "drop")
                            end
                        end
                        if #chests + #drops >= 20 then
                            break
                        end
                    end
                end)
                Runtime.LootDeepCache = { chests = chests, drops = drops, at = now }
            elseif Runtime.LootDeepCache then
                -- Reuse last deep result; still return fresh tag/folder results merged below via chests/drops already filled.
                for i = 1, #(Runtime.LootDeepCache.chests or {}) do
                    consider(Runtime.LootDeepCache.chests[i].Prompt or Runtime.LootDeepCache.chests[i].Inst, "chest")
                end
                for i = 1, #(Runtime.LootDeepCache.drops or {}) do
                    consider(Runtime.LootDeepCache.drops[i].Prompt or Runtime.LootDeepCache.drops[i].Inst, "drop")
                end
            end
        end
        table.sort(chests, function(a, b) return a.Dist < b.Dist end)
        table.sort(drops, function(a, b) return a.Dist < b.Dist end)
        return chests, drops
    end

    function Systems.Loot.HasNearbyChestAt(origin, range)
        if not origin then
            return false
        end
        range = range or (Config.Boss.LootRange or 80)
        local now = os.clock()
        local cache = Runtime.LootNearCache
        if cache and cache.origin and (now - cache.at) < 0.6
            and (cache.origin - origin).Magnitude < 8
            and cache.range >= range
        then
            return cache.hit
        end
        -- Tags-only (cheap). Deep scan is only for Collect while LOOT_CHEST.
        local chests = select(1, Systems.Loot.GatherCandidates(origin, range, { Deep = false }))
        local hit = chests ~= nil and #chests > 0
        Runtime.LootNearCache = { origin = origin, range = range, at = now, hit = hit }
        return hit
    end

    function Systems.Loot.HasNearbyChest(range)
        local _, _, root = Resolver.Character()
        local origin = Runtime.LootOrigin or Runtime.LastCombatPos or (root and root.Position)
        return Systems.Loot.HasNearbyChestAt(origin, range)
    end

    function Systems.Loot.ApproachAndFire(best, label)
        if not best then
            return false
        end
        local prompt = best.Prompt
        local maxDist = (prompt and prompt.MaxActivationDistance) or 10
        local standDist = math.max(3, math.min(maxDist - 0.5, 8))
        local _, _, root = Resolver.Character()
        local dy = root and math.abs(root.Position.Y - best.Pos.Y) or 0
        local flat = root and Vector3.new(root.Position.X - best.Pos.X, 0, root.Position.Z - best.Pos.Z).Magnitude or best.Dist
        local playerDist = root and (root.Position - best.Pos).Magnitude or best.Dist
        -- Don't hop across the map for a distant tagged chest (causes Y bounce after world bosses).
        if playerDist > 85 then
            return false
        end

        -- Close enough to claim: STOP tween / unstuck and fire T. Do not re-path.
        local inRange = (best.Dist <= standDist or flat <= standDist) and dy <= 10
        if not inRange then
            Systems.Movement.MoveToLoot(best.Pos, standDist)
            Systems.Loot.ExtendWindow(8)
            return true
        end

        -- Cancel any leftover pickup tween so we don't jitter while claiming.
        if Systems.Movement.Cancel then
            Systems.Movement.Cancel("loot-claim")
        end
        Runtime.MovePurpose = "pickup"
        Runtime.SkipHop = true

        if prompt then
            pcall(function()
                prompt.Enabled = true
                prompt.RequiresLineOfSight = false
                prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance or 0, 15)
            end)
        end

        local now = os.clock()
        local throttleKey = tostring(best.Inst)
        Runtime.LootFireAt = Runtime.LootFireAt or {}
        if (Runtime.LootFireAt[throttleKey] or 0) + 0.35 > now then
            return true
        end
        Runtime.LootFireAt[throttleKey] = now
        Runtime.LootFireCount = Runtime.LootFireCount or {}
        Runtime.LootFireCount[throttleKey] = (Runtime.LootFireCount[throttleKey] or 0) + 1
        if Runtime.LootFireCount[throttleKey] >= 10 then
            Runtime.LootSkipUntil = Runtime.LootSkipUntil or {}
            Runtime.LootSkipUntil[throttleKey] = now + 25
            Logger.Warn("Loot", "Skip stubborn " .. tostring(label or "chest"))
            return false
        end

        local target = prompt or best.Inst
        local action = prompt and string.lower(tostring(prompt.ActionText or "")) or ""
        local kind = Systems.Loot.MatchKnownType(prompt and prompt.ObjectText)
            or Systems.Loot.MatchKnownType(best.Inst and best.Inst.Name)
            or (prompt and prompt.ObjectText)
            or (best.Inst and best.Inst.Name)
            or label
            or "loot"

        Systems.Loot.FirePrompt(target)
        if Runtime.LastLootLog ~= best.Inst then
            Runtime.LastLootLog = best.Inst
            Logger.Info("Loot", (label or action or "Claim") .. " " .. tostring(kind) .. " dist=" .. string.format("%.1f", best.Dist))
        end

        if label == "Open" or best.Kind == "chest" or action == "open" then
            task.delay(0.8, function()
                if not stillCurrent() then
                    return
                end
                if Runtime.LootPhase == "chest" then
                    Runtime.LootPhase = "drops"
                    Runtime.LootEmptySince = nil
                    Logger.Info("Loot", "Chest opened — claim drops (T)")
                end
            end)
        end
        return true
    end

    function Systems.Loot.Collect(range)
        range = range or (Config.Boss.LootRange or 80)
        local _, _, root = Resolver.Character()
        local origin = Runtime.LootOrigin or Runtime.LastCombatPos or (root and root.Position)
        if not origin then
            return false
        end
        if root then
            local flatOrigin = Vector3.new(root.Position.X - origin.X, 0, root.Position.Z - origin.Z).Magnitude
            if flatOrigin > 70 then
                local near = select(1, Systems.Loot.GatherCandidates(root.Position, 40, { Deep = false }))
                if near and #near > 0 then
                    return Systems.Loot.ApproachAndFire(near[1], "Open")
                end
                return false
            end
        end
        local chests, drops = Systems.Loot.GatherCandidates(origin, range, { Deep = true })
        -- Also merge candidates near the player (origin may lag behind if we walked away).
        if root then
            local c2, d2 = Systems.Loot.GatherCandidates(root.Position, math.min(range, 55), { Deep = false })
            local seen = {}
            for i = 1, #chests do seen[chests[i].Inst] = true end
            for i = 1, #c2 do
                if not seen[c2[i].Inst] then
                    chests[#chests + 1] = c2[i]
                end
            end
            seen = {}
            for i = 1, #drops do seen[drops[i].Inst] = true end
            for i = 1, #d2 do
                if not seen[d2[i].Inst] then
                    drops[#drops + 1] = d2[i]
                end
            end
            table.sort(chests, function(a, b) return a.Dist < b.Dist end)
            table.sort(drops, function(a, b) return a.Dist < b.Dist end)
        end
        local phase = Runtime.LootPhase or "chest"

        if phase == "chest" then
            if #chests > 0 then
                Runtime.LootEmptySince = nil
                return Systems.Loot.ApproachAndFire(chests[1], "Open")
            end
            if #drops > 0 then
                Runtime.LootPhase = "drops"
                Runtime.LootEmptySince = nil
                Logger.Info("Loot", "No chest — pick up drops")
                return Systems.Loot.ApproachAndFire(drops[1], "Claim")
            end
            return false
        end

        if phase == "drops" then
            if #drops > 0 then
                Runtime.LootEmptySince = nil
                return Systems.Loot.ApproachAndFire(drops[1], "Claim")
            end
            return false
        end
        return false
    end

    local DecisionEngine = {}
    local StateMachine = {}

    local function setBlocked(system, reason)
        Runtime.Blocked = {
            System = system,
            Reason = reason,
            Since = os.clock(),
        }
        Logger.Once("blocked-" .. system, "warn", "BLOCKED", "[" .. system .. "] " .. reason)
    end

    local function intentTravelOrAccept(key, def, source)
        Runtime.CurrentIntent = { Key = key, Def = def, Source = source }
        return "QUEST_ACCEPT"
    end

    function DecisionEngine.Evaluate()
        if not stillCurrent() then
            return "IDLE"
        end
        if not Game.PlayerData.IsLoaded() then
            return "WAIT_DATA"
        end
        Game.PlayerData.Refresh()
        if Runtime.Race == nil then
            return "WAIT_DATA"
        end
        Systems.Quest.CurrentStage()
        if Systems.Breathing and Systems.Breathing.TryProgress then
            Systems.Breathing.TryProgress()
        end
        if not Resolver.IsPlayerAlive() then
            Runtime.DrinkingPotion = false
            if Runtime.Humanoid and Runtime.Humanoid.Health <= 0 then
                return "PLAYER_DEAD"
            end
            if not Runtime.Root then
                return "ROOT_MISSING"
            end
            return "WAIT_CHARACTER"
        end
        if Runtime.DrinkingPotion then
            return "POTION_DRINK"
        end

        local st = Runtime.State
        local allowPeek = st == nil or st == "FARM_COMBAT" or st == "HUNT_TRAVEL" or st == "FARM_TRAVEL"
            or st == "LOOT_CHEST" or st == "IDLE" or st == "WAIT_RESPAWN" or st == "WAITING_FOR_BOSS"
            or st == "WAIT_COOLDOWN"
        if allowPeek then
            local peek = Systems.Loot.PeekNearby(52)
            if peek then
                local lootOn = Runtime.LootUntil and Runtime.LootUntil > os.clock()
                if not lootOn then
                    Systems.Loot.BeginWindow(peek.Pos, "nearby-chest")
                end
                if Runtime.LootUntil and Runtime.LootUntil > os.clock() then
                    return "LOOT_CHEST"
                end
            end
        end
        if Runtime.LootUntil and Runtime.LootUntil > 0 and os.clock() < Runtime.LootUntil then
            return "LOOT_CHEST"
        end
        -- Do not reopen loot after this kill was already looted — resume hunt.
        if Runtime.LootUntil and Runtime.LootUntil > 0 and os.clock() >= Runtime.LootUntil then
            Systems.Loot.EndWindow("expired")
        end
        if Runtime.BossFightEngaged and not Runtime.LootSpent and Runtime.LastCombatPos then
            if not Systems.Loot.TargetStillAlive() then
                Systems.Loot.BeginWindow(Runtime.LastCombatPos, "boss-engaged-gone")
                if Runtime.LootUntil and Runtime.LootUntil > os.clock() then
                    return "LOOT_CHEST"
                end
            end
        end

        local holder = Systems.Quest.SelectHolderAction()
        if holder and holder.Entry then
            local hdef = QuestDB[holder.Entry.Key]
            if hdef and not Systems.Quest.RaceAllowed(hdef, Game.PlayerData.GetRace()) then
                Systems.Quest.RemoveHeld(holder.Entry, "farm-mode")
                holder = nil
            end
        end
        if Systems.BossOpportunity and Systems.BossOpportunity.Check then
            Systems.BossOpportunity.Check()
        end
        local function tryHuntPatrol()
            if Runtime.LootUntil and Runtime.LootUntil > 0 and os.clock() < Runtime.LootUntil then
                return nil
            end

            local function bindWorldCombat(patrol)
                Runtime.HuntPatrol = patrol
                Runtime.HuntAccepting = false
                Runtime.PendingBossQuest = nil
                Runtime.SelectedReason = (patrol.NoQuest == false and patrol.Key) and "world-claim" or "world-boss"
                Runtime.CurrentIntent = {
                    Key = patrol.Key,
                    Def = patrol.Def,
                    Source = Runtime.SelectedReason,
                    Code = patrol.Code,
                }
                Runtime.CurrentTask = { Code = patrol.Code, Intent = "COMBAT", WorldBoss = true }
                if patrol.Model and Systems.Enemy.IsAlive(patrol.Model) then
                    Runtime.CurrentTarget = patrol.Model
                end
            end

            local function worldTravelOrFight(world)
                bindWorldCombat(world)
                local dest = world.Center
                local range = Config.Boss.HuntArriveRange or 42
                local model = (world.Model and Systems.Enemy.IsAlive(world.Model) and world.Model)
                    or (Runtime.CurrentTarget and Systems.Enemy.IsAlive(Runtime.CurrentTarget) and Runtime.CurrentTarget)
                if model then
                    Runtime.CurrentTarget = model
                    local mroot = Systems.Enemy.GetRoot(model)
                    local _, _, root = Resolver.Character()
                    if mroot and root then
                        local flat = Vector3.new(root.Position.X - mroot.Position.X, 0, root.Position.Z - mroot.Position.Z).Magnitude
                        if flat <= 140 or Runtime.State == "FARM_COMBAT" then
                            return "FARM_COMBAT"
                        end
                    elseif Runtime.State == "FARM_COMBAT" then
                        return "FARM_COMBAT"
                    end
                end
                if dest and Systems.Movement.HasArrived(dest, range) then
                    return "FARM_COMBAT"
                end
                return "HUNT_TRAVEL"
            end

            local world = Systems.BossOpportunity.PickLiveWorld()
            if world then
                if Systems.BossOpportunity.HolderBlocksHunt(holder) then
                    return nil
                end
                local hdef = world.Def or Systems.BossOpportunity.HuntDefForCode(world.Code)
                local huntKey = world.Key or (hdef and hdef.Key)
                if huntKey and Runtime.PendingAccept == huntKey then
                    Runtime.HuntPatrol = world
                    Runtime.HuntAccepting = true
                    Runtime.SelectedReason = "world-claim"
                    Runtime.CurrentIntent = { Key = huntKey, Def = hdef, Source = "world-claim" }
                    return "QUEST_ACCEPT"
                end
                if huntKey and Game.PlayerData.GetQuestByKey(huntKey) then
                    world.NoQuest = false
                    world.Key = huntKey
                    world.Def = hdef
                    local logKey = "WC:" .. tostring(world.Code)
                    if Runtime.HuntPatrolLogged ~= logKey then
                        Runtime.HuntPatrolLogged = logKey
                        Logger.Info("Boss", tostring(world.Code) .. " world live — hunt claimed, fight")
                    end
                    return worldTravelOrFight(world)
                end
                local can, why, card = Systems.BossOpportunity.CanClaimHunt(world.Code)
                if can and hdef and card then
                    world.NoQuest = false
                    world.Key = hdef.Key
                    world.Def = hdef
                    world.HuntId = card.Id
                    Runtime.HuntPatrol = world
                    Runtime.HuntAccepting = true
                    Runtime.SelectedReason = "world-claim"
                    Runtime.CurrentIntent = { Key = hdef.Key, Def = hdef, Source = "world-claim" }
                    local logKey = "WQ:" .. tostring(world.Code)
                    if Runtime.HuntPatrolLogged ~= logKey then
                        Runtime.HuntPatrolLogged = logKey
                        Logger.Info("Boss", tostring(world.Code) .. " world live — claim " .. tostring(hdef.Key))
                    end
                    return "QUEST_ACCEPT"
                end
                world.NoQuest = true
                local logKey = "W:" .. tostring(world.Code)
                if Runtime.HuntPatrolLogged ~= logKey then
                    Runtime.HuntPatrolLogged = logKey
                    Logger.Info("Boss", tostring(world.Code) .. " world live — no hunt (" .. tostring(why) .. "), farm")
                end
                return worldTravelOrFight(world)
            end
            if Runtime.HuntPatrol and Runtime.HuntPatrol.NoQuest
                and Systems.BossOpportunity.IsWorldCode(Runtime.HuntPatrol.Code)
            then
                Systems.BossOpportunity.ClearPatrol()
            end

            if not Systems.BossOpportunity.ShouldPatrol(holder) then
                return nil
            end

            local function huntAcceptState(patrol)
                if not patrol then
                    return nil
                end
                if patrol.NoQuest then
                    return worldTravelOrFight(patrol)
                end
                if not patrol.Key then
                    return nil
                end
                Runtime.HuntAccepting = true
                Runtime.PendingBossQuest = patrol.Key
                Runtime.SelectedReason = "hunt-accept"
                Runtime.CurrentIntent = { Key = patrol.Key, Def = patrol.Def, Source = "hunt-patrol" }
                if Game.PlayerData.GetQuestByKey(patrol.Key) then
                    local heldKey = holder and holder.Entry and holder.Entry.Key
                    if heldKey == patrol.Key then
                        Systems.BossOpportunity.ClearPatrol()
                        return nil
                    end
                    -- Quest is on the character; wait one tick for Holder instead of QUEST_TRAVEL again.
                    return "IDLE"
                end
                local okTake, whyTake = Systems.Quest.CanTakeQuest(patrol.Key, { IgnoreBossAlive = true })
                if not okTake then
                    local spawn = Systems.BossOpportunity.GetSpawn(patrol.Code)
                    if spawn and spawn.Alive then
                        patrol.NoQuest = true
                        Runtime.HuntAccepting = false
                        Runtime.PendingBossQuest = nil
                        local logKey = "NQ:" .. tostring(patrol.Code)
                        if Runtime.HuntPatrolLogged ~= logKey then
                            Runtime.HuntPatrolLogged = logKey
                            Logger.Info("Boss", tostring(patrol.Code) .. " live, cannot take quest (" .. tostring(whyTake) .. ") — farm")
                        end
                        return worldTravelOrFight(patrol)
                    end
                    Runtime.HuntAccepting = false
                    Runtime.PendingBossQuest = nil
                    return nil
                end
                local held = Systems.Quest.HeldEntry()
                if held and held.Key and held.Key ~= patrol.Key then
                    local heldDef = QuestDB[held.Key]
                    local heldAction = Systems.Quest.SelectHolderAction()
                    if (heldDef and heldDef.Kind == "Breathing")
                        or (heldAction and (heldAction.Intent == "TRAINING" or heldAction.Intent == "COMPLETE"))
                        or Systems.Breathing.IsHeld()
                    then
                        Runtime.HuntAccepting = false
                        Runtime.PendingBossQuest = nil
                        Systems.BossOpportunity.ClearPatrol()
                        return nil
                    end
                    Systems.Quest.RemoveHeld(held, "hunt " .. tostring(patrol.Code))
                    return "IDLE"
                end
                local dest, _, model = Systems.Quest.GiverDest(patrol.Def)
                if dest and not Systems.Movement.IsBesideNpc(dest, model) then
                    return "QUEST_TRAVEL"
                end
                return "QUEST_ACCEPT"
            end

            local patrol = Runtime.HuntPatrol
            if Runtime.HuntAccepting and patrol and patrol.Key then
                return huntAcceptState(patrol)
            end

            local ready = Systems.BossOpportunity.PickPatrol()
            if patrol then
                local spawn = Systems.BossOpportunity.GetSpawn(patrol.Code)
                if not (spawn and Systems.BossOpportunity.IsDue(spawn)) then
                    patrol = ready
                    Runtime.HuntPatrol = patrol
                    Runtime.HuntArriveAt = nil
                    Runtime.HuntAccepting = false
                elseif patrol.Center == nil and ready and ready.Code == patrol.Code then
                    patrol.Center = ready.Center
                end
            else
                patrol = ready
                Runtime.HuntPatrol = patrol
                Runtime.HuntArriveAt = nil
                Runtime.HuntAccepting = false
            end
            if patrol then
                if Runtime.HuntPatrolLogged ~= patrol.Code then
                    Runtime.HuntPatrolLogged = patrol.Code
                    local spawn = Systems.BossOpportunity.GetSpawn(patrol.Code)
                    if spawn and spawn.Alive then
                        Logger.Info("Boss", tostring(patrol.Code) .. " Lv" .. tostring(patrol.Level) .. " live — take quest")
                    elseif spawn and spawn.Remain then
                        Logger.Info("Boss", tostring(patrol.Code) .. " Lv" .. tostring(patrol.Level) .. " spawns in " .. string.format("%.0f", spawn.Remain) .. "s — go now")
                    else
                        Logger.Info("Boss", "Patrol spawn " .. tostring(patrol.Code) .. " Lv" .. tostring(patrol.Level))
                    end
                end
            else
                Runtime.HuntPatrolLogged = nil
                Systems.BossOpportunity.LogTimers()
            end
            patrol = Runtime.HuntPatrol
            if not patrol then
                return nil
            end

            local spawn = Systems.BossOpportunity.GetSpawn(patrol.Code)
            if spawn and spawn.Center then
                patrol.Center = spawn.Center
            end
            if spawn and spawn.Alive then
                return huntAcceptState(patrol)
            end

            Runtime.SelectedReason = "hunt-patrol"
            Runtime.CurrentIntent = { Key = patrol.Key, Def = patrol.Def, Source = "hunt-patrol" }
            return "HUNT_TRAVEL"
        end
        if holder then
            local thunderKey = Systems.Breathing.Key and Systems.Breathing.Key()
            if thunderKey and Systems.Breathing.ShouldStart and Systems.Breathing.ShouldStart() then
                if holder.Entry and holder.Entry.Key ~= thunderKey then
                    Systems.Quest.RemoveHeld(holder.Entry, "thunder-breathing")
                    return "IDLE"
                end
            end
            local entry = holder.Entry
            local task = holder.Task
            Runtime.SelectedReason = holder.Why
            if holder.Intent == "COMPLETE" or Systems.Quest.IsQuestComplete(entry) then
                return "QUEST_COMPLETE"
            end
            if task and task.Intent == "TRAINING" then
                if Runtime.HuntAccepting then
                    Runtime.HuntAccepting = false
                    Runtime.PendingBossQuest = nil
                    Systems.BossOpportunity.ClearPatrol()
                end
                return "TRAINING"
            end
            local hdef = entry and QuestDB[entry.Key]
            local keepBreathing = hdef and hdef.Kind == "Breathing"
            if not keepBreathing then
                local huntState = tryHuntPatrol()
                if huntState then
                    return huntState
                end
                local preempt, bossKey = Systems.Quest.ShouldPreemptForBoss(holder)
                if preempt then
                    Runtime.PendingBossQuest = bossKey
                    Runtime.SelectedReason = "preempt-boss"
                    Runtime.CurrentIntent = { Key = bossKey, Def = QuestDB[bossKey], Source = "preempt-boss" }
                    return "BOSS_PREEMPT"
                end
            end
            if task and task.Intent == "PICKUP" then
                return "QUEST_PICKUP"
            end
            if task and task.Intent == "COMBAT" then
                local target = Systems.Enemy.ValidateCurrent(task.Code)
                if not target then
                    local nearest = select(1, Systems.Enemy.FindNearestTarget(task.Code))
                    if not nearest then
                        local def = QuestDB[entry.Key]
                        local enemy = task.Code and EnemyDB[task.Code]
                        if (def and def.Boss) or (enemy and enemy.Boss) then
                            return "WAITING_FOR_BOSS"
                        end
                        return "WAIT_RESPAWN"
                    end
                    Runtime.CurrentTarget = nearest
                end
                return "FARM_COMBAT"
            end
            if task and (task.Intent == "DELIVER" or task.Intent == "DIALOGUE") then
                local meta = task.Meta or {}
                if meta.RequiredItem and not Game.PlayerData.HasItem(meta.RequiredItem, meta.Count or 1) then
                    local related = meta.RelatedQuest
                    if related and not Game.PlayerData.GetQuestByKey(related) then
                        if Systems.Quest.CanTakeQuest(related) then
                            return intentTravelOrAccept(related, QuestDB[related], "related-item")
                        end
                        local cd = Systems.Quest.OnCooldown()
                        if cd then
                            Runtime.CurrentIntent = { Key = related, Def = QuestDB[related], Source = "related-cooldown" }
                            return "WAIT_COOLDOWN"
                        end
                    end
                    return "IDLE"
                end
                return "QUEST_DELIVER"
            end
            if task and (task.Intent == "DUNGEON" or task.Intent == "FISHING" or task.Intent == "ESCORT") then
                Logger.Once("task-" .. tostring(task.Intent), "warn", "Quest", "Live task intent " .. task.Intent .. " is not auto-executable")
                return "IDLE"
            end
            return "IDLE"
        end

        do
            local huntState = tryHuntPatrol()
            if huntState then
                return huntState
            end
        end

        if not Config.AutoQuest then
            return "IDLE"
        end

        local key, def, source = Systems.Quest.SelectBestQuest()
        Runtime.SelectedReason = source
        if key and source and string.find(tostring(source), "holder", 1, true) then
            -- holder handled above
        end
        if not key then
            local cd, remain = Systems.Quest.OnCooldown()
            if source == "thunder-drop" then
                return "IDLE"
            end
            if source == "thunder-cooldown" then
                Runtime.CooldownRemain = remain
                if not Runtime.CurrentIntent or Runtime.CurrentIntent.Source ~= "thunder-breathing" then
                    local thunderKey = Systems.Breathing.Key()
                    Runtime.CurrentIntent = { Key = thunderKey, Def = QuestDB[thunderKey], Source = "thunder-breathing" }
                end
                return "WAIT_COOLDOWN"
            end
            if source == "pending-boss-wait" then
                if cd then
                    Runtime.CooldownRemain = remain
                    return "WAIT_COOLDOWN"
                end
                local intent = Runtime.CurrentIntent
                if intent and intent.Key then
                    return intentTravelOrAccept(intent.Key, intent.Def, "pending-boss")
                end
            end
            if cd then
                if Systems.Quest.StageBossLive() then
                    Runtime.CooldownRemain = remain
                    return "WAIT_COOLDOWN"
                end
                local farmKey, farmDef = Systems.Quest.SelectFarmDestination()
                if farmKey then
                    Runtime.CurrentIntent = { Key = farmKey, Def = farmDef, Source = "cooldown-pretravel" }
                end
                Runtime.CooldownRemain = remain
                return "WAIT_COOLDOWN"
            end
            local race = Runtime.Race
            local level = Runtime.Level or 0
            if race == "Human" and Config.AutoFinalSelection and level >= Config.Progression.FinalSelectionMinLevel then
                if not Systems.FinalSelection.CanAutomate() then
                    setBlocked("FinalSelection", Systems.FinalSelection.GetMissingCapability())
                end
            elseif Runtime.Blocked and Runtime.Blocked.System == "FinalSelection" then
                Runtime.Blocked = nil
            end
            return "IDLE"
        end

        Runtime.CurrentIntent = { Key = key, Def = def, Source = source }
        local progStamp = tostring(Runtime.Level) .. ":" .. tostring(Runtime.Race) .. ":" .. tostring(Runtime.CurrentStageId) .. ":" .. tostring(key) .. ":" .. tostring(source)
        if Runtime.LastProgressionLog ~= progStamp then
            Runtime.LastProgressionLog = progStamp
            Logger.Info("Progression", string.format(
                "Level=%s Race=%s Stage=%s SelectedQuest=%s Reason=%s",
                tostring(Runtime.Level),
                tostring(Runtime.Race),
                tostring(Runtime.CurrentStageId),
                tostring(key),
                tostring(source)
            ))
        end
        local npcName = def and Systems.Quest.GiverName(def)
        local dest, _, model = Systems.Quest.GiverDest(def)
        if dest and not Systems.Movement.IsBesideNpc(dest, model) then
            return "QUEST_TRAVEL"
        end
        return "QUEST_ACCEPT"
    end

    function StateMachine.Transition(state)
        -- Cheap loot gate: no Workspace scans here (that lagged Execute).
        local lootActive = Runtime.LootUntil and Runtime.LootUntil > 0 and os.clock() < Runtime.LootUntil
        local leavingCombat = Runtime.State == "FARM_COMBAT" and state ~= "FARM_COMBAT" and state ~= "LOOT_CHEST"
        local stillHunting = state == "HUNT_TRAVEL" or state == "FARM_TRAVEL" or state == "FARM_COMBAT"
        local forceLoot = leavingCombat
            and Runtime.BossFightEngaged == true
            and not Runtime.LootSpent
            and not stillHunting
            and not Systems.Loot.TargetStillAlive()
        local shouldLoot = lootActive or forceLoot
        if shouldLoot and state ~= "PLAYER_DEAD" and state ~= "ROOT_MISSING" and state ~= "WAIT_CHARACTER" then
            if not lootActive then
                local _, _, root = Resolver.Character()
                Systems.Loot.BeginWindow(Runtime.LastCombatPos or (root and root.Position), "force-loot")
            end
            if state ~= "LOOT_CHEST" then
                Logger.Info("Loot", "Override " .. tostring(state) .. " → LOOT_CHEST")
            end
            state = "LOOT_CHEST"
        end
        if Runtime.State ~= state then
            local from = Runtime.State
            Logger.Debug("State", tostring(from) .. " → " .. tostring(state))
            Runtime.LastState = from
            Runtime.State = state
            local huntSwap = (from == "HUNT_TRAVEL" and (state == "QUEST_TRAVEL" or state == "QUEST_ACCEPT"))
                or (from == "QUEST_TRAVEL" and state == "HUNT_TRAVEL")
                or (from == "QUEST_ACCEPT" and state == "HUNT_TRAVEL")
                or (from == "LOOT_CHEST" and (state == "HUNT_TRAVEL" or state == "FARM_COMBAT"))
            if from == "LOOT_CHEST" and state ~= "LOOT_CHEST" and Systems.Movement.Cancel then
                Systems.Movement.Cancel("leave-loot")
            end
            if huntSwap and Systems.Movement.Cancel then
                Systems.Movement.Cancel("hunt-quest-swap")
            end
            local keepNpcHold = state == "QUEST_TRAVEL"
                or state == "QUEST_ACCEPT"
                or state == "QUEST_COMPLETE"
                or state == "QUEST_DELIVER"
                or state == "WAIT_COOLDOWN"
                or state == "TRAINING"
            if Runtime.NpcHoldCf and not keepNpcHold then
                Systems.Movement.ReleaseNpcHold()
                if Systems.Movement.UnfreezeLocomotion then
                    Systems.Movement.UnfreezeLocomotion()
                end
            end
            if state ~= "FARM_COMBAT" and state ~= "FARM_TRAVEL" and state ~= "WAIT_RESPAWN" and state ~= "WAITING_FOR_BOSS" and state ~= "LOOT_CHEST" and state ~= "BOSS_PREEMPT" and state ~= "HUNT_TRAVEL" and state ~= "TRAINING" then
                if Runtime.LockTarget then
                    Systems.Movement.Stop()
                elseif state ~= "QUEST_ACCEPT" and state ~= "QUEST_TRAVEL" and state ~= "QUEST_COMPLETE" and state ~= "QUEST_DELIVER" and state ~= "QUEST_PICKUP" and state ~= "WAIT_COOLDOWN" then
                    Systems.Movement.Stop()
                end
            end
        end
        return state
    end

    function StateMachine.Execute(state)
        if state == "POTION_DRINK" then
            Systems.Watchdog.MarkProgress()
            return
        end
        if state == "LOOT_CHEST" then
            -- Drop combat lock so we can stand at Common/Rare Chest (prompt Key T / Open).
            Runtime.LockTarget = nil
            if Systems.Movement.ReleasePin then
                Systems.Movement.ReleasePin()
            end
            if Systems.Movement.SetCombatLock then
                Systems.Movement.SetCombatLock(false)
            end
            Runtime.MovePurpose = "pickup"
            local now = os.clock()
            local timedOut = (not Runtime.LootUntil) or Runtime.LootUntil <= 0 or now >= Runtime.LootUntil
                or (Runtime.LootHardUntil and Runtime.LootHardUntil > 0 and now >= Runtime.LootHardUntil)
            if timedOut or Runtime.LootSpent then
                Systems.Loot.EndWindow(Runtime.LootSpent and "spent" or "timeout")
                Systems.Combat.EquipBest()
            elseif Systems.Loot.Collect() then
                Runtime.LootEmptySince = nil
                Systems.Watchdog.MarkProgress()
            else
                -- No chest/drop right now. After a short empty grace, leave — don't sit out the full window.
                Runtime.LootEmptySince = Runtime.LootEmptySince or now
                local opened = Runtime.LootPhase == "drops" or Runtime.LastLootLog ~= nil
                local grace = opened and 2.8 or 2
                if (now - Runtime.LootEmptySince) >= grace then
                    Systems.Loot.EndWindow("empty")
                    Systems.Combat.EquipBest()
                else
                    Systems.Watchdog.MarkProgress()
                end
            end
            return
        end
        if state == "HUNT_TRAVEL" then
            local patrol = Runtime.HuntPatrol
            if not patrol or not patrol.Center then
                Systems.BossOpportunity.ClearPatrol()
                return
            end
            if patrol.NoQuest or (patrol.Def and patrol.Def.ClaimHunt) or Systems.BossOpportunity.IsWorldCode(patrol.Code) then
                Runtime.HuntAccepting = false
                local spawn = Systems.BossOpportunity.GetSpawn(patrol.Code)
                local model = (spawn and spawn.Model)
                    or select(1, Systems.Enemy.FindNearestTarget(patrol.Code, nil, true))
                if model and not Systems.Enemy.IsAlive(model) then
                    model = nil
                end
                if not model and not (spawn and spawn.Alive) then
                    Logger.Info("Boss", tostring(patrol.Code) .. " world despawned — resume farm")
                    Systems.BossOpportunity.ClearPatrol()
                    return
                end
                local edef = EnemyDB[patrol.Code]
                local travelDest = (edef and edef.Center) or (spawn and spawn.Center) or patrol.Center
                if Runtime.HuntTravelCode ~= patrol.Code then
                    Runtime.HuntTravelCode = patrol.Code
                    Runtime.HuntTravelDest = travelDest
                end
                patrol.Center = Runtime.HuntTravelDest or travelDest
                if model then
                    patrol.Model = model
                    Runtime.CurrentTarget = model
                    Runtime.CurrentTask = { Code = patrol.Code, Intent = "COMBAT", WorldBoss = true }
                end
                local range = Config.Boss.HuntArriveRange or 42
                local mroot = model and Systems.Enemy.GetRoot(model)
                if mroot and Systems.Movement.HasArrived(mroot.Position, range) then
                    Systems.Watchdog.MarkProgress()
                    return
                end
                if Systems.Movement.HasArrived(patrol.Center, range) then
                    Systems.Watchdog.MarkProgress()
                    return
                end
                Systems.Movement.MoveToHunt(patrol.Center, range)
                Systems.Watchdog.MarkProgress()
                return
            end
            if Runtime.HuntAccepting then
                return
            end
            local spawn = Systems.BossOpportunity.GetSpawn(patrol.Code)
            if spawn and spawn.Center then
                patrol.Center = spawn.Center
            end
            if not spawn or not Systems.BossOpportunity.IsDue(spawn) then
                Logger.Info("Boss", tostring(patrol.Code) .. " not due anymore — resume farm")
                Systems.BossOpportunity.ClearPatrol()
                return
            end
            local range = Config.Boss.HuntArriveRange or 42
            if not Systems.Movement.HasArrived(patrol.Center, range) then
                Systems.Movement.MoveTo(patrol.Center, range)
                Systems.Watchdog.MarkProgress()
                Runtime.HuntArriveAt = nil
                return
            end
            if spawn.Alive then
                Runtime.PendingBossQuest = patrol.Key
                Runtime.HuntAccepting = true
                Logger.Info("Boss", tostring(patrol.Code) .. " spawned — take quest and farm")
                local held = Systems.Quest.HeldEntry()
                if held and held.Key ~= patrol.Key then
                    Systems.Quest.RemoveHeld(held, "hunt " .. tostring(patrol.Code))
                end
                Systems.Watchdog.MarkProgress()
                return
            end
            Runtime.HuntArriveAt = Runtime.HuntArriveAt or os.clock()
            if (spawn.Remain or 0) <= 0 and os.clock() - Runtime.HuntArriveAt > 12 then
                Logger.Info("Boss", tostring(patrol.Code) .. " timer 0 but missing — next")
                Systems.BossOpportunity.MarkMiss(patrol.Code)
                Systems.BossOpportunity.ClearPatrol()
                return
            end
            Systems.Watchdog.MarkProgress()
            return
        end
        if state == "BOSS_PREEMPT" then
            local holder = Systems.Quest.HeldEntry()
            local bossKey = Runtime.PendingBossQuest or (Systems.Quest.StageBossLive())
            if holder and bossKey and holder.Key ~= bossKey then
                Systems.Quest.RemoveHeld(holder, "boss " .. tostring(bossKey))
            end
            Systems.Watchdog.MarkProgress()
            return
        end
        if state == "WAIT_DATA" then
            Logger.Debug("Boot", "Waiting for PlayerData")
            Game.PlayerData.GetSlot()
            return
        end
        if state == "WAIT_CHARACTER" or state == "PLAYER_DEAD" or state == "ROOT_MISSING" then
            Resolver.Character()
            pcall(Systems.Lifecycle.TryRespawnUi)
            if Resolver.IsPlayerAlive() then
                Runtime.DiedAt = nil
                Systems.Watchdog.MarkProgress()
                Systems.Combat.EquipBest()
                Logger.Info("Lifecycle", "Alive after death — resume Holder quest")
            else
                local waited = Runtime.DiedAt and (os.clock() - Runtime.DiedAt) or 0
                if waited < (Config.Watchdog.Death or 90) then
                    Systems.Watchdog.MarkProgress()
                end
            end
            return
        end
        if state == "BUY_EQUIPMENT" then
            if Systems.Shop.BuyIfNeeded() then
                Systems.Watchdog.MarkProgress()
            end
            Systems.Equipment.EnsureWeapon()
            return
        end
        if state == "QUEST_TRAVEL" or state == "QUEST_ACCEPT" then
            local intent = Runtime.CurrentIntent
            local key = intent and intent.Key
            local def = intent and intent.Def
            if not key then
                return
            end
            if def and def.ClaimHunt then
                local ok, err = Systems.Quest.AcceptQuest(key)
                if ok then
                    Systems.Watchdog.MarkProgress()
                    Systems.Recovery.Clear("QUEST_ACCEPT_FAILED")
                    Logger.Info("Quest", "Claimed verified: " .. key)
                    Runtime.HuntAccepting = false
                elseif err == "pending" or err == "retrying" then
                    Systems.Watchdog.MarkProgress()
                elseif err == "no card" or err == "race" or err == "level" or err == "maxlevel" or err == "category"
                    or (err and string.sub(tostring(err), 1, 9) == "cooldown:") then
                    Logger.Info("Quest", "Claim skipped (" .. tostring(err) .. ") — farm without hunt")
                    if Runtime.HuntPatrol then
                        Runtime.HuntPatrol.NoQuest = true
                    end
                    Runtime.HuntAccepting = false
                    Runtime.PendingAccept = nil
                    Systems.Watchdog.MarkProgress()
                else
                    local action = Systems.Recovery.Handle("QUEST_ACCEPT_FAILED", tostring(err))
                    if action == "GIVE_UP" then
                        Runtime.PendingAccept = nil
                        Runtime.HuntAccepting = false
                        if Runtime.HuntPatrol then
                            Runtime.HuntPatrol.NoQuest = true
                        end
                    end
                end
                return
            end
            if def then
                local dest, npcName = Systems.Quest.GiverDest(def)
                if not dest then
                    Systems.Quest.Skip(key, "NPC_MISSING")
                    Logger.Warn("Quest", tostring(npcName) .. " has no spawn dest — skip " .. tostring(key))
                    return
                end
                local okMove, moveErr = Systems.Movement.MoveToNPC(npcName, dest)
                if not okMove then
                    if moveErr == "moving" then
                        Systems.Watchdog.MarkProgress()
                    elseif moveErr == "npc missing" then
                        Systems.Movement.MoveToNPC(npcName, dest)
                        Systems.Watchdog.MarkProgress()
                    end
                    return
                end
            end
            local ok, err = Systems.Quest.AcceptQuest(key)
            if ok then
                Systems.Watchdog.MarkProgress()
                Systems.Recovery.Clear("QUEST_ACCEPT_FAILED")
                if Runtime.UnavailableQuests then
                    Runtime.UnavailableQuests[key] = nil
                end
                Logger.Info("Quest", "Accepted verified: " .. key)
            elseif err == "pending" or err == "retrying" or err == "too far" or err == "no dest" or err == "npc missing"
                or err == "training" or err == "paused" or err == "category" or err == "boss absent" then
                Systems.Watchdog.MarkProgress()
                return
            elseif err and string.sub(tostring(err), 1, 9) == "cooldown:" then
                Systems.Watchdog.MarkProgress()
                return
            else
                local action = Systems.Recovery.Handle("QUEST_ACCEPT_FAILED", tostring(err))
                if action == "GIVE_UP" then
                    Runtime.PendingAccept = nil
                    Runtime.HuntAccepting = false
                    if Systems.BossOpportunity and Systems.BossOpportunity.ClearPatrol then
                        Systems.BossOpportunity.ClearPatrol()
                    end
                end
            end
            return
        end
        if state == "FARM_TRAVEL" then
            local target = Runtime.CurrentTarget
            if target then
                if Systems.Movement.MoveToEnemy(target) then
                    Systems.Watchdog.MarkProgress()
                end
            else
                local taskInfo = Runtime.CurrentTask
                local def = Runtime.CurrentQuest and QuestDB[Runtime.CurrentQuest]
                local center = (taskInfo and taskInfo.Code and EnemyDB[taskInfo.Code] and EnemyDB[taskInfo.Code].Center)
                    or (def and def.Marker)
                if center then
                    Systems.Movement.MoveTo(center, 12)
                end
            end
            return
        end
        if state == "FARM_COMBAT" then
            local taskInfo = Runtime.CurrentTask
            local code = taskInfo and taskInfo.Code
            if not code then
                return
            end
            local result = Systems.Combat.Cycle(code)
            if result == "NO_ENEMY" then
                local enemy = EnemyDB[code]
                local recent = Runtime.LastTargetHealthAt and (os.clock() - Runtime.LastTargetHealthAt) < 8
                if recent and Runtime.BossFightEngaged and not Systems.Loot.TargetStillAlive() then
                    Systems.Loot.BeginWindow(Runtime.LastCombatPos, "farm-no-enemy")
                    return
                end
                local center = enemy and enemy.Center
                if center and Systems.Movement.DistanceTo(center) > 20 then
                    Systems.Movement.MoveTo(center, 12)
                end
            elseif result == "TARGET_DEAD" then
                Systems.Watchdog.MarkProgress()
            elseif result == "COMBAT" then
                Systems.Watchdog.MarkProgress()
            end
            return
        end
        if state == "WAIT_RESPAWN" or state == "WAITING_FOR_BOSS" then
            local taskInfo = Runtime.CurrentTask
            local code = taskInfo and taskInfo.Code
            local enemy = code and EnemyDB[code]
            local center = enemy and enemy.Center
            if not center then
                local def = Systems.Quest.GetDefinition(Runtime.CurrentQuest)
                center = def and def.Marker
                if not center and def and def.TargetCode then
                    enemy = EnemyDB[def.TargetCode]
                    center = enemy and enemy.Center
                end
            end
            if center then
                local dest = Systems.Movement.GroundedCFrame(center, 6) or center
                local dist = Systems.Movement.DistanceTo(dest)
                if dist and dist > 18 then
                    Systems.Movement.MoveTo(dest, 14)
                    Systems.Watchdog.MarkProgress()
                elseif dist then
                    if Systems.Movement.Overlapping() then
                        Systems.Movement.Unstuck()
                    end
                    Systems.Watchdog.MarkProgress()
                end
            end
            if code and select(1, Systems.Enemy.FindNearestTarget(code)) then
                Systems.Watchdog.MarkProgress()
            end
            return
        end
        if state == "QUEST_PICKUP" then
            local active = Systems.Quest.HeldEntry()
            local def = active and QuestDB[active.Key]
            local task = Runtime.CurrentTask or Systems.Quest.GetActionableTask(active)
            if not (def and def.Pickups and task) then
                return
            end
            if Runtime.PickupQuest ~= active.Key then
                Runtime.PickupQuest = active.Key
                Runtime.PickupIndex = 1
                Runtime.PickupTaskValue = task.Value or 0
                Logger.Info("Quest", "Pickup start " .. tostring(active.Key) .. " " .. tostring(task.Value) .. "/" .. tostring(task.Max))
            end
            local index = Runtime.PickupIndex or 1
            if index > #def.Pickups then
                index = ((index - 1) % #def.Pickups) + 1
            end
            local dest = def.Pickups[index] or def.Pickups[1]
            local destCf = Util.ToCFrame(dest)
            if destCf and not Systems.Movement.HasArrived(destCf, 6) then
                Systems.Movement.StartTween(destCf, 6, "pickup")
                Systems.Watchdog.MarkProgress()
                return
            end
            local objectText = def.ObjectText
            if not objectText then
                return
            end
            local function nameMatches(inst)
                local n = inst.Name
                return n == (objectText .. tostring(index)) or n == (objectText .. index) or n == objectText or string.sub(n, 1, #objectText) == objectText
            end
            local found
            pcall(function()
                local params = OverlapParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                local center = destCf and destCf.Position or (root and root.Position)
                if not center then
                    return
                end
                for _, part in ipairs(Workspace:GetPartBoundsInRadius(center, 40, params)) do
                    local cursor = part
                    for _ = 1, 4 do
                        if not cursor then
                            break
                        end
                        if nameMatches(cursor) then
                            found = cursor
                            return
                        end
                        cursor = cursor.Parent
                    end
                    local prompt = part:FindFirstChildWhichIsA("ProximityPrompt")
                    if prompt and nameMatches(prompt) then
                        found = prompt
                        return
                    end
                end
            end)
            if found then
                local prompt = found:IsA("ProximityPrompt") and found or found:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    pcall(function()
                        if fireproximityprompt then
                            fireproximityprompt(prompt)
                        else
                            prompt:InputHoldBegin()
                            task.wait(prompt.HoldDuration or 0)
                            prompt:InputHoldEnd()
                        end
                    end)
                elseif def.PickupTask then
                    Systems.Quest.FireProgress(active.Key, def.PickupTask, index)
                end
            elseif def.PickupTask then
                Systems.Quest.FireProgress(active.Key, def.PickupTask, index)
            end
            local nowTasks = Game.PlayerData.GetQuestTasks(active.Instance)
            local nowValue = task.Value or 0
            if nowTasks then
                for i = 1, #nowTasks do
                    if nowTasks[i].Name == task.Name then
                        nowValue = nowTasks[i].Value or 0
                        break
                    end
                end
            end
            if nowValue > (Runtime.PickupTaskValue or 0) then
                Runtime.PickupIndex = (Runtime.PickupIndex or index) + 1
                Runtime.PickupTaskValue = nowValue
                Systems.Watchdog.MarkProgress()
                Logger.Info("Quest", "Pickup " .. tostring(nowValue) .. "/" .. tostring(task.Max))
            elseif (os.clock() - (Runtime.LastPickupAdvance or 0)) > 4 then
                Runtime.LastPickupAdvance = os.clock()
                Runtime.PickupIndex = index + 1
            end
            return
        end
        if state == "QUEST_DELIVER" then
            local active = Systems.Quest.HeldEntry()
            local def = active and QuestDB[active.Key]
            local task = Runtime.CurrentTask or Systems.Quest.GetActionableTask(active)
            if not def or not task then
                return
            end
            local meta = task.Meta or (def.LiveTasks and def.LiveTasks[task.Name]) or {}
            if meta.RequiredItem and not Game.PlayerData.HasItem(meta.RequiredItem, meta.Count or 1) then
                local related = meta.RelatedQuest
                if related and not Game.PlayerData.GetQuestByKey(related) and Systems.Quest.CanTakeQuest(related) then
                    Runtime.CurrentIntent = { Key = related, Def = QuestDB[related], Source = "related-item" }
                end
                return
            end
            local npcName = meta.TargetNpc or def.DeliverNpc or def.NpcName
            local dest = Resolver.FindWorldNpc(npcName)
                or (NpcDB[npcName] and NpcDB[npcName].CFrame)
                or def.NpcCFrame
            if not dest then
                if (os.clock() - (Runtime.LastDeliverMissAt or 0)) > 5 then
                    Runtime.LastDeliverMissAt = os.clock()
                    Logger.Warn("Quest", "Deliver NPC has no CFrame: " .. tostring(npcName))
                end
                return
            end
            if not Systems.Movement.HasArrived(dest, Config.Movement.NpcDistance) then
                local okMove, moveErr = Systems.Movement.MoveToNPC(npcName, dest)
                if okMove or moveErr == "moving" then
                    Systems.Watchdog.MarkProgress()
                end
                return
            end
            Systems.Quest.FireNpcPrompt(npcName)
            local progress = meta.Progress
            if progress and progress[1] and progress[2] then
                local stamp = progress[1] .. ":" .. progress[2]
                if Runtime.LastProgressRemote ~= stamp or (os.clock() - (Runtime.LastProgressRemoteAt or 0)) > 2 then
                    Systems.Quest.FireProgress(progress[1], progress[2])
                    Runtime.LastProgressRemote = stamp
                    Runtime.LastProgressRemoteAt = os.clock()
                    Logger.Info("Quest", "QuestProgress " .. stamp)
                end
            end
            local again = Systems.Quest.GetActionableTask(active)
            if not again or again.Name ~= task.Name or (again.Value or 0) > (task.Value or 0) then
                Systems.Watchdog.MarkProgress()
            end
            return
        end
        if state == "QUEST_COMPLETE" then
            local active = Systems.Quest.SelectHolderAction()
            local entry = active and active.Entry
            if not entry then
                Systems.Watchdog.MarkProgress()
                return
            end
            if not Systems.Quest.IsQuestComplete(entry) then
                return
            end
            local still = Game.PlayerData.GetQuestByKey(entry.Key)
            if not still then
                Systems.Watchdog.MarkProgress()
                return
            end
            local def = QuestDB[entry.Key]
            if def and def.ClaimHunt then
                if Runtime.CompleteObserveKey ~= entry.Key then
                    Runtime.CompleteObserveAt = os.clock()
                    Runtime.CompleteObserveKey = entry.Key
                    Logger.Info("Quest", "Hunt complete (no giver): " .. tostring(entry.Key))
                end
                Systems.Watchdog.MarkProgress()
                return
            end
            local observed = Runtime.CompleteObserveAt
            if not observed or Runtime.CompleteObserveKey ~= entry.Key then
                Runtime.CompleteObserveAt = os.clock()
                Runtime.CompleteObserveKey = entry.Key
                Logger.Info("Quest", "Tasks complete — returning to giver: " .. tostring(entry.Key))
            end
            local npcName = Systems.Quest.GiverName(def)
            local dest = Resolver.FindWorldNpc(npcName) or (def and def.NpcCFrame) or (npcName and NpcDB[npcName] and NpcDB[npcName].CFrame)
            if dest then
                local okMove, moveErr = Systems.Movement.MoveToNPC(npcName, dest)
                if not okMove then
                    if moveErr == "moving" then
                        Systems.Watchdog.MarkProgress()
                    end
                    return
                end
                Systems.Watchdog.MarkProgress()
            end
            if npcName then
                Systems.Quest.FireNpcPrompt(npcName)
            end
            return
        end
        if state == "TRAINING" then
            Runtime.LockTarget = nil
            if Systems.Movement.ReleasePin then
                Systems.Movement.ReleasePin()
            end
            if Systems.Movement.SetCombatLock then
                Systems.Movement.SetCombatLock(false)
            end
            Systems.Training.DoCurrentTask()
            return
        end
        if state == "IDLE" then
            Systems.Equipment.EnsureWeapon()
            if Config.AutoShop then
                Systems.Shop.BuyIfNeeded()
            end
            return
        end
        if state == "WAIT_COOLDOWN" then
            local _, remain = Systems.Quest.OnCooldown()
            local intent = Runtime.CurrentIntent
            if not (intent and intent.Def) then
                local liveBoss = Systems.Quest.StageBossLive()
                if liveBoss then
                    Runtime.CurrentIntent = { Key = liveBoss, Def = QuestDB[liveBoss], Source = "cooldown-boss" }
                else
                    local farmKey, farmDef = Systems.Quest.SelectFarmDestination()
                    Runtime.CurrentIntent = { Key = farmKey, Def = farmDef, Source = "cooldown-pretravel" }
                end
                intent = Runtime.CurrentIntent
            end
            if (os.clock() - (Runtime.LastCooldownLog or 0)) > 5 then
                Runtime.LastCooldownLog = os.clock()
                local giver = intent and intent.Def and Systems.Quest.GiverName(intent.Def)
                Logger.Info("Quest", string.format(
                    "QuestCD %.0fs — at %s then AddQuest %s",
                    remain or 0,
                    tostring(giver),
                    tostring(intent and intent.Key)
                ))
            end
            local def = intent and intent.Def
            if def then
                local npcName = Systems.Quest.GiverName(def)
                local okMove, moveErr = Systems.Movement.MoveToNPC(npcName, def.NpcCFrame)
                if okMove or moveErr == "moving" then
                    Systems.Watchdog.MarkProgress()
                end
            end
            if not remain or remain <= 0 then
                Systems.Watchdog.MarkProgress()
            end
            return
        end
    end

    -- ============================================================
    -- 17. LIFECYCLE / ANTI-AFK / TELEPORT
    -- ============================================================

    Systems.Lifecycle = {}

    function Systems.Lifecycle.TryRespawnUi()
        local now = os.clock()
        if Runtime.LastRespawnUiAt and now - Runtime.LastRespawnUiAt < 2 then
            return false
        end
        Runtime.LastRespawnUiAt = now
        local gui = LocalPlayer:FindFirstChild("PlayerGui")
        if not gui then
            return false
        end
        local clicked = false
        local function readText(inst)
            local ok, text = pcall(function()
                return inst.Text
            end)
            if ok and type(text) == "string" then
                return text
            end
            return ""
        end
        local function maybeClick(inst)
            if clicked or not inst then
                return
            end
            local name = string.lower(tostring(inst.Name or ""))
            if string.find(name, "menu", 1, true) then
                return
            end
            local label = name .. " " .. string.lower(readText(inst))
            if not (string.find(label, "respawn", 1, true) or string.find(label, "revive", 1, true) or string.find(label, "retry", 1, true)) then
                return
            end
            clicked = true
            Logger.Info("Lifecycle", "Click death UI " .. inst:GetFullName())
            pcall(function()
                if firesignal and inst.Activated then
                    firesignal(inst.Activated)
                end
            end)
            pcall(function()
                if firesignal and inst.MouseButton1Click then
                    firesignal(inst.MouseButton1Click)
                end
            end)
            pcall(function()
                inst.Activated:Fire()
            end)
        end
        pcall(function()
            for _, desc in ipairs(gui:GetDescendants()) do
                if desc:IsA("GuiButton") or desc:IsA("TextButton") or desc:IsA("ImageButton") then
                    maybeClick(desc)
                    if clicked then
                        break
                    end
                end
            end
        end)
        return clicked
    end

    local function hookCharacter()
        trackConnection("CharacterAdded", LocalPlayer.CharacterAdded:Connect(function(character)
            if not stillCurrent() then
                return
            end
            Logger.Info("Lifecycle", "CharacterAdded — rebinding")
            Runtime.DiedAt = nil
            Runtime.LastAnimPrune = nil
            Systems.Movement.Stop()
            Systems.Enemy.InvalidateTarget()
            Resolver.BindCharacter(character)
            Systems.Watchdog.MarkProgress()
            task.spawn(function()
                if character then
                    character:WaitForChild("Humanoid", 8)
                    character:WaitForChild("HumanoidRootPart", 8)
                end
                if not stillCurrent() or LocalPlayer.Character ~= character then
                    return
                end
                Resolver.BindCharacter(character)
                Systems.Watchdog.MarkProgress()
                Systems.Combat.EquipBest()
                Logger.Info("Lifecycle", "Respawn ready")
            end)
        end))
        if LocalPlayer.Character then
            Resolver.BindCharacter(LocalPlayer.Character)
        end
    end

    local function hookAntiAfk()
        trackConnection("Idled", LocalPlayer.Idled:Connect(function()
            if not stillCurrent() then
                return
            end
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end))
    end

    local function hookTeleport()
        local q
        pcall(function()
            q = (syn and syn.queue_on_teleport) or queue_on_teleport or (fluxus and fluxus.queue_on_teleport)
        end)
        if type(q) ~= "function" then
            Logger.Debug("Boot", "queue_on_teleport unavailable; re-execute after place change")
            return
        end
        -- No external URL loader. Persistence would require embedding this entire source.
        Logger.Debug("Boot", "queue_on_teleport present but unused (no external loader)")
    end

    -- ============================================================
    -- 18. MAIN SCHEDULER
    -- ============================================================

    local lastStatusAt = 0
    local lastWatchdogAt = 0
    local lastDataAt = 0

    local function printStatus()
        if os.clock() - lastStatusAt < Config.StatusInterval then
            return
        end
        lastStatusAt = os.clock()
        Logger.Info("Status", Progression.DebugSnapshot())
    end

    local function schedulerLoop()
        Runtime.Running = true
        Logger.Info("Boot", "Kaitun generation " .. tostring(Generation) .. " started")
        while stillCurrent() and Runtime.Running and Config.Enabled ~= false and Config.AutoStart do
            local ok, err = xpcall(function()
                if os.clock() - lastDataAt >= Config.Tick.DataRefresh then
                    lastDataAt = os.clock()
                    Resolver.Character()
                    if Game.PlayerData.IsLoaded() then
                        Game.PlayerData.Refresh()
                    end
                else
                    Resolver.Character()
                end

                Resolver.Character()
                Systems.Potion.Tick()
                Systems.Movement.Update()

                local state = DecisionEngine.Evaluate()
                state = StateMachine.Transition(state) or state
                StateMachine.Execute(state)
                Systems.Skills.Spend()

                if os.clock() - lastWatchdogAt >= Config.Tick.Watchdog then
                    lastWatchdogAt = os.clock()
                    Systems.Watchdog.Tick()
                end
                printStatus()
            end, debug.traceback)
            if not ok then
                Logger.Error("Scheduler", err)
                Runtime.LastError = err
                task.wait(0.4)
            else
                local waitTime = Config.Tick.Scheduler
                if Runtime.State == "FARM_COMBAT" then
                    waitTime = Config.Tick.Combat
                elseif Runtime.State == "POTION_DRINK" then
                    waitTime = 0.15
                elseif Runtime.State == "WAIT_RESPAWN" or Runtime.State == "WAITING_FOR_BOSS" or Runtime.State == "WAIT_COOLDOWN" then
                    waitTime = 0.45
                elseif Runtime.State == "WAIT_DATA" or Runtime.State == "WAIT_CHARACTER" or Runtime.State == "PLAYER_DEAD" or Runtime.State == "ROOT_MISSING" then
                    waitTime = 0.2
                end
                task.wait(waitTime)
            end
        end
        Runtime.Running = false
        Logger.Info("Boot", "Scheduler stopped (generation " .. tostring(Generation) .. ")")
    end

    local function shutdown()
        if ENV.__OUWLAND_KAITUN_GENERATION ~= Generation then
            -- a newer instance owns the env flag
        end
        Runtime.Running = false
        Systems.Movement.Stop()
        Systems.Enemy.InvalidateTarget()
        disconnectAll()
        Logger.Info("Boot", "Shutdown generation " .. tostring(Generation))
    end

    ENV.__OUWLAND_KAITUN_SHUTDOWN = shutdown
    ENV.__OUWLAND_KAITUN_RUNNING = true
    ENV.__OUWLAND_KAITUN_SNAPSHOT = function()
        return Progression.DebugSnapshot()
    end

    -- ============================================================
    -- 19. START
    -- ============================================================

    do
        local gui = LocalPlayer:FindFirstChild("PlayerGui")
        if not gui then
            Util.WaitFor(15, function()
                return LocalPlayer:FindFirstChild("PlayerGui")
            end)
        end
        Util.WaitFor(20, function()
            return LocalPlayer.Character ~= nil
        end, 0.2)
        Resolver.Character()
        hookCharacter()
        Systems.Movement.BindHeartbeat()
        hookAntiAfk()
        hookTeleport()
        Resolver.SignalEvent()
        Resolver.SignalFunction()
        Game.PlayerData.Refresh()
        Logger.Info("Boot", string.format(
            "PlaceId=%s Race=%s Level=%s FarmMode=%s HuntBossFrom=%s WorldBossFrom=%s AutoWorldBoss=%s AutoThunder=%s FromLv=%s Slot=%s SignalEvent=%s",
            tostring(game.PlaceId),
            tostring(Runtime.Race),
            tostring(Runtime.Level),
            Systems.Quest.FarmMode(),
            tostring(Config.Boss.HuntFromLevel),
            tostring(Config.Boss.WorldBossFromLevel),
            tostring(Config.AutoWorldBoss),
            tostring(Systems.Breathing.Enabled()),
            tostring(Config.ThunderFromLevel),
            Runtime.Slot and Runtime.Slot:GetFullName() or "nil",
            Runtime.SignalEvent and "module" or (Runtime.SignalRemote and "remote" or "missing")
        ))
        if Config.AutoStart then
            task.spawn(function()
                if not stillCurrent() then
                    return
                end
                schedulerLoop()
            end)
            task.spawn(function()
                if not stillCurrent() then
                    return
                end
                Systems.Combat.M1Loop()
            end)
        else
            Logger.Warn("Boot", "AutoStart is false")
        end
    end
