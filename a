    Systems.Quest = {}

    function Systems.Quest.NormalizeKey(key)
        if type(key) ~= "string" then
            return key
        end
        key = string.gsub(key, "\226\128\153", "'")
        key = string.gsub(key, "\226\128\152", "'")
        key = string.gsub(key, "`", "'")
        key = string.gsub(key, "I'll", "Ill")
        key = string.gsub(key, "I'LL", "ILL")
        return key
    end

    function Systems.Quest.GetDefinition(key)
        if not key then
            return nil
        end
        return QuestDB[key] or QuestDB[Systems.Quest.NormalizeKey(key)]
    end

    function Systems.Quest.GetActiveQuests()
        return Game.PlayerData.GetCurrentQuests()
    end

    function Systems.Quest.TaskDone(task)
        if not task then
            return true
        end
        local maxValue = task.Max or 0
        if maxValue <= 0 then
            return (task.Value or 0) > 0
        end
        return (task.Value or 0) >= maxValue
    end

    function Systems.Quest.NeedMet(tasks, needName)
        if not needName or needName == "" then
            return true
        end
        for i = 1, #tasks do
            if tasks[i].Name == needName then
                return Systems.Quest.TaskDone(tasks[i])
            end
        end
        return true
    end

    function Systems.Quest.ClassifyTask(questEntry, task)
        local def = questEntry and QuestDB[questEntry.Key]
        local live = def and def.LiveTasks and def.LiveTasks[task.Name]
        if def and def.Kind == "Pickup" then
            return "PICKUP", live
        end
        if live and live.Intent then
            return live.Intent, live
        end
        if task.Code and task.Code ~= "" and EnemyDB[task.Code] then
            return "COMBAT", live
        end
        if def and (def.Kind == "Combat" or def.ClaimHunt) and def.TargetCode then
            if not task.Code or task.Code == "" then
                task.Code = def.TargetCode
            end
            return "COMBAT", live
        end
        if def and (def.Kind == "Deliver" or def.Kind == "Chain") then
            return "DELIVER", live
        end
        if def and def.Kind == "Fishing" then
            return "FISHING", live
        end
        if def and def.Kind == "Dungeon" then
            return "DUNGEON", live
        end
        if def and def.Kind == "Breathing" then
            return "TRAINING", live
        end
        if def and def.Kind == "Escort" then
            return "ESCORT", live
        end
        return "UNKNOWN", live
    end

    function Systems.Quest.GetActionableTask(questEntry)
        if not questEntry then
            return nil
        end
        local tasks = Game.PlayerData.GetQuestTasks(questEntry.Instance)
        if not tasks or #tasks == 0 then
            return nil
        end
        local def = QuestDB[questEntry.Key]
        for i = 1, #tasks do
            local task = tasks[i]
            if not Systems.Quest.TaskDone(task) then
                local need = task.Need
                if (not need or need == "") and def and def.LiveTasks and def.LiveTasks[task.Name] then
                    need = def.LiveTasks[task.Name].Need
                end
                if Systems.Quest.NeedMet(tasks, need) then
                    local intent, meta = Systems.Quest.ClassifyTask(questEntry, task)
                    task.Intent = intent
                    task.Meta = meta
                    return task
                end
            end
        end
        return nil
    end

    function Systems.Quest.IsQuestComplete(questEntry)
        local tasks = questEntry and Game.PlayerData.GetQuestTasks(questEntry.Instance)
        if not tasks or #tasks == 0 then
            return false
        end
        for i = 1, #tasks do
            if not Systems.Quest.TaskDone(tasks[i]) then
                return false
            end
        end
        return true
    end

    function Systems.Quest.CanExecuteAutomatically(def)
        if not def then
            return false, "unknown"
        end
        if def.AutoExecute == false then
            return false, "flag"
        end
        if def.BlockedReason and def.Kind ~= "Combat" and def.Kind ~= "Pickup" and def.Kind ~= "Chain" then
            return false, def.BlockedReason
        end
        local kind = def.Kind
        if kind == "Pickup" then
            if not def.ObjectText or not def.Pickups or not def.PickupTask then
                return false, "pickup object unresolved"
            end
            return true, "ok"
        end
        if kind == "Chain" then
            if not def.LiveTasks then
                return false, "chain unresolved"
            end
            return true, "ok"
        end
        if kind == "Breathing" then
            if def.AutoExecute == true then
                return true, "ok"
            end
            return false, kind
        end
        if kind == "Dungeon" or kind == "Fishing" or kind == "DemonArt" or kind == "Story" or kind == "Escort" then
            return false, kind
        end
        if kind == "Deliver" and not def.LiveTasks then
            return false, "deliver flow unresolved"
        end
        if def.LifeSkill then
            return false, "life skill"
        end
        if kind == "Combat" then
            return true, "ok"
        end
        if def.TargetCode then
            return true, "ok"
        end
        return false, "unsupported"
    end

    function Systems.Quest.GetQuestProgress(questEntry)
        questEntry = questEntry or Systems.Quest.GetActiveQuest()
        if not questEntry then
            return nil
        end
        return Game.PlayerData.GetQuestTasks(questEntry.Instance)
    end

    function Systems.Quest.RemainingCombatTask(questEntry)
        local task = Systems.Quest.GetActionableTask(questEntry)
        if task and task.Intent == "COMBAT" then
            return task
        end
        return nil
    end

    function Systems.Quest.SelectHolderAction()
        local list = Systems.Quest.GetActiveQuests()
        if #list == 0 then
            Runtime.CurrentQuest = nil
            Runtime.CurrentQuestInstance = nil
            Runtime.CurrentTask = nil
            return nil
        end
        local ranked = {}
        for i = 1, #list do
            local entry = list[i]
            if Systems.Quest.IsQuestComplete(entry) then
                local cdef = QuestDB[entry.Key]
                local crank = (cdef and cdef.ClaimHunt) and 92 or 20
                table.insert(ranked, { Entry = entry, Rank = crank, Why = "complete", Intent = "COMPLETE" })
            else
                local task = Systems.Quest.GetActionableTask(entry)
                if task then
                    local rank = 50
                    if task.Intent == "DELIVER" or task.Intent == "DIALOGUE" then
                        local meta = task.Meta
                        if meta and meta.RequiredItem and not Game.PlayerData.HasItem(meta.RequiredItem, meta.Count or 1) then
                            rank = 25
                        else
                            rank = 100
                        end
                    elseif task.Intent == "PICKUP" then
                        rank = 80
                    elseif task.Intent == "TRAINING" then
                        rank = 95
                    elseif task.Intent == "COMBAT" then
                        local alive = Systems.Enemy.FindNearestTarget(task.Code)
                        local def = QuestDB[entry.Key]
                        if def and def.Kind == "Breathing" then
                            rank = alive and 96 or 40
                        else
                            rank = alive and 90 or 30
                        end
                    elseif task.Intent == "UNKNOWN" then
                        rank = 10
                    else
                        rank = 15
                    end
                    table.insert(ranked, { Entry = entry, Task = task, Rank = rank, Why = task.Intent, Intent = task.Intent })
                end
            end
        end
        table.sort(ranked, function(a, b)
            return a.Rank > b.Rank
        end)
        local best = ranked[1]
        if not best then
            return nil
        end
        Runtime.CurrentQuest = best.Entry.Key
        Runtime.CurrentQuestInstance = best.Entry.Instance
        Runtime.CurrentTask = best.Task
        return best
    end

    function Systems.Quest.GetActiveQuest()
        local selected = Systems.Quest.SelectHolderAction()
        return selected and selected.Entry or nil
    end

    function Systems.Quest.HeldEntry()
        if Runtime.CurrentQuest and Runtime.CurrentQuestInstance and Runtime.CurrentQuestInstance.Parent then
            return {
                Key = Runtime.CurrentQuest,
                Instance = Runtime.CurrentQuestInstance,
            }
        end
        local selected = Systems.Quest.SelectHolderAction()
        return selected and selected.Entry or nil
    end

    function Systems.Quest.NowTick()
        local util = Resolver.Utility()
        if util and type(util.Tick) == "function" then
            local ok, value = pcall(util.Tick)
            if ok and type(value) == "number" then
                return value
            end
        end
        return tick()
    end

    function Systems.Quest.OnCooldown()
        local last = Game.PlayerData.GetLastQuestTime()
        if not last or last <= 0 then
            return false, 0
        end
        local now = Systems.Quest.NowTick()
        local remain = (last + Config.Quest.Cooldown) - now
        if remain < -1e8 or remain > 1e8 then
            return false, 0
        end
        if remain > 0 then
            return true, remain
        end
        return false, 0
    end

    function Systems.Quest.MarkUnavailable(key, reason)
        if not key then
            return
        end
        reason = reason or "NPC_MISSING"
        local dur = 15
        local map = Config.Quest.Unavailable
        if map and map[reason] then
            dur = map[reason]
        end
        Runtime.UnavailableQuests = Runtime.UnavailableQuests or {}
        Runtime.UnavailableQuests[key] = {
            Reason = reason,
            RetryAfter = os.clock() + dur,
        }
        Logger.Warn("Quest", tostring(key) .. " unavailable " .. tostring(dur) .. "s (" .. tostring(reason) .. ")")
    end

    function Systems.Quest.IsUnavailable(key)
        if not key then
            return false
        end
        local u = Runtime.UnavailableQuests and Runtime.UnavailableQuests[key]
        if not u then
            return false
        end
        if os.clock() >= (u.RetryAfter or 0) then
            Runtime.UnavailableQuests[key] = nil
            return false
        end
        return true, u.Reason
    end

    function Systems.Quest.Skip(key, reason)
        Systems.Quest.MarkUnavailable(key, reason or "NPC_MISSING")
    end

    function Systems.Quest.FarmMode()
        local mode = ENV.OuwlandFarmMode or Config.FarmMode or "Auto"
        if type(mode) ~= "string" then
            return "Auto"
        end
        mode = string.lower(mode)
        if mode == "slayer" then
            return "Slayer"
        end
        if mode == "demon" then
            return "Demon"
        end
        return "Auto"
    end

    function Systems.Quest.RaceAllowed(def, race)
        if not def then
            return true
        end
        if def.Race then
            if not race then
                return false
            end
            if not Util.TableContains(def.Race, race) then
                return false
            end
        end
        local mode = Systems.Quest.FarmMode()
        if mode == "Slayer" then
            if def.Category == "Muzan" or def.Kind == "DemonArt" then
                return false
            end
            if def.Race and not Util.TableContains(def.Race, "Slayer") then
                return false
            end
        elseif mode == "Demon" then
            if def.Kind == "Breathing" then
                return false
            end
            if def.Key and string.find(tostring(def.Key), "Breathing", 1, true) then
                return false
            end
            if def.Race and not Util.TableContains(def.Race, "Demon") then
                return false
            end
        end
        return true
    end

    Systems.BossOpportunity = Systems.BossOpportunity or {}

    function Systems.Quest.CanTakeQuest(key, opts)
        opts = opts or {}
        local def = QuestDB[key]
        if not def then
            return false, "unknown quest"
        end
        if Systems.Quest.IsUnavailable(key) then
            local _, why = Systems.Quest.IsUnavailable(key)
            return false, "unavailable:" .. tostring(why)
        end
        if Runtime.SkippedQuests and Runtime.SkippedQuests[key] then
            return false, "skipped:" .. tostring(Runtime.SkippedQuests[key].Reason)
        end
        local executable, execReason = Systems.Quest.CanExecuteAutomatically(def)
        if not executable then
            return false, "cannot execute:" .. tostring(execReason)
        end
        if def.LifeSkill and not Config.AutoLifeSkills then
            return false, "life skills disabled"
        end
        if def.Boss and not Config.AutoBoss then
            return false, "boss disabled"
        end
        if Game.PlayerData.GetQuestByKey(key) then
            return false, "already held"
        end
        if def.LogCompletion and Game.PlayerData.IsQuestCompleted(key) then
            return false, "completed"
        end
        local race = Game.PlayerData.GetRace()
        if not race then
            return false, "no race"
        end
        if not Systems.Quest.RaceAllowed(def, race) then
            return false, "race"
        end
        local level = Game.PlayerData.GetLevel()
        if def.MinLevel and level < def.MinLevel then
            return false, "level"
        end
        if def.MaxLevel and level > def.MaxLevel then
            return false, "maxlevel"
        end
        if def.WenCostOnAccept and Game.PlayerData.GetWen() < def.WenCostOnAccept then
            return false, "wen"
        end
        if def.RequiredItem and not Game.PlayerData.HasItem(def.RequiredItem) then
            return false, "item"
        end
        if def.ItemCostOnAccept then
            for itemName, amount in pairs(def.ItemCostOnAccept) do
                if not Game.PlayerData.HasItem(itemName, amount) then
                    return false, "itemcost"
                end
            end
        end
        if def.NeedAxeAndMace then
            local hasAxe = Game.PlayerData.HasItem("Axe and Mace")
                or Game.PlayerData.HasItem("Seismic Axe and Mace")
                or Game.PlayerData.HasItem("Nightfall Axe and Mace")
            if not hasAxe then
                return false, "axe"
            end
        end
        local category = def.Category or "Combat"
        if not opts.IgnoreCategory then
            if Game.PlayerData.CountCategory(category) >= Config.Quest.MaxPerCategory then
                return false, "category"
            end
        end
        if def.Boss and not opts.IgnoreBossAlive then
            local opp = Systems.BossOpportunity
            if not (opp and opp.IsAlive and opp.IsAlive(def.TargetCode)) then
                return false, "boss absent"
            end
        end
        if not opts.IgnoreCooldown then
            local cd, remain = Systems.Quest.OnCooldown()
            if cd then
                return false, "cooldown:" .. string.format("%.1f", remain)
            end
        end
        return true, "ok"
    end

    function Systems.BossOpportunity.PickBestLive()
        if not Config.AutoBoss then
            return nil
        end
        local level = Game.PlayerData.GetLevel() or 0
        local huntAll = level >= (Config.Boss.HuntFromLevel or 70)
        local rows = {}
        if huntAll then
            for key, def in pairs(QuestDB) do
                if def.Boss and def.TargetCode and not def.ClaimHunt and not def.WorldBoss then
                    rows[#rows + 1] = { Key = key, Def = def }
                end
            end
        else
            local stage = Systems.Quest.CurrentStage()
            if stage and stage.Boss and QuestDB[stage.Boss] then
                rows[1] = { Key = stage.Boss, Def = QuestDB[stage.Boss] }
            end
        end
        local ranked = {}
        for i = 1, #rows do
            local def = rows[i].Def
            if def and Systems.Quest.RaceAllowed(def, Game.PlayerData.GetRace()) then
                local minLv = def.MinLevel or 0
                if minLv <= level then
                    -- Lv70+ hunt: ignore streamed low bosses (Kaiden/Mother Bear) unless this
                    -- is the spawn we already committed to. Otherwise QUEST_TRAVEL fights HUNT_TRAVEL.
                    local committed = Runtime.HuntPatrol and Runtime.HuntPatrol.Key == rows[i].Key
                    local huntFloor = Config.Boss.HuntFromLevel or 70
                    if huntAll and minLv < huntFloor and not committed then
                        -- skip
                    elseif Systems.BossOpportunity.IsAlive(def.TargetCode) then
                        ranked[#ranked + 1] = {
                            Key = rows[i].Key,
                            Def = def,
                            Level = minLv,
                        }
                    end
                end
            end
        end
        table.sort(ranked, function(a, b)
            if a.Level == b.Level then
                return (a.Def.Priority or 0) > (b.Def.Priority or 0)
            end
            return a.Level > b.Level
        end)
        return ranked[1]
    end

    function Systems.BossOpportunity.HuntRows()
        local level = Game.PlayerData.GetLevel() or 0
        local tags = Systems.BossOpportunity.ScanTags()
        local rows = {}
        for key, def in pairs(QuestDB) do
            if def.ClaimHunt or def.WorldBoss then
                -- Board hunts / Hashira: only when already spawned (PickLiveWorld), never wait at empty spawn.
            elseif def.Boss and def.TargetCode and Systems.Quest.RaceAllowed(def, Game.PlayerData.GetRace()) then
                if (def.MinLevel or 1) <= level then
                    local enemy = EnemyDB[def.TargetCode]
                    local spawn = tags[def.TargetCode]
                    local center = (spawn and spawn.Center) or (enemy and enemy.Center) or def.Marker
                    if center then
                        rows[#rows + 1] = {
                            Key = key,
                            Def = def,
                            Code = def.TargetCode,
                            Center = center,
                            Level = def.MinLevel or 0,
                        }
                    end
                end
            end
        end
        table.sort(rows, function(a, b)
            if a.Level == b.Level then
                return (a.Def.Priority or 0) > (b.Def.Priority or 0)
            end
            return a.Level > b.Level
        end)
        return rows
    end

    function Systems.BossOpportunity.ScanTags()
        local nowClock = os.clock()
        if Runtime.BossTagCache and Runtime.BossTagAt and (nowClock - Runtime.BossTagAt) < 0.45 then
            return Runtime.BossTagCache
        end
        local byCode = {}
        local serverNow = 0
        pcall(function()
            serverNow = Workspace:GetServerTimeNow()
        end)
        if serverNow <= 0 then
            serverNow = os.clock()
        end
        local tagged = {}
        pcall(function()
            tagged = CollectionService:GetTagged("BossTag")
        end)
        for i = 1, #tagged do
            local info = tagged[i]
            if info and info:IsDescendantOf(Workspace) then
                local code = info:GetAttribute("NpcCode")
                if type(code) == "string" and code ~= "" then
                    local parent = info.Parent
                    local model = parent and parent:FindFirstChildOfClass("Model")
                    local alive = false
                    if model then
                        local hum = model:FindFirstChildOfClass("Humanoid")
                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                        alive = hum ~= nil and (hum.Health or 0) > 0 and hrp ~= nil
                    end
                    local spawnTime = tonumber(info:GetAttribute("SpawnTime")) or 0
                    local despawnedAt = parent and tonumber(parent:GetAttribute("DespawnedAt"))
                    local remain = nil
                    if alive then
                        remain = 0
                    elseif despawnedAt and spawnTime > 0 and serverNow > 0 then
                        remain = spawnTime - (serverNow - despawnedAt)
                        -- Leftover timestamps from another session are hours off — ignore.
                        if remain > spawnTime + 8 or remain < -30 then
                            remain = nil
                        elseif remain < 0 then
                            remain = 0
                        end
                    end
                    local center = info:GetAttribute("Center")
                    if typeof(center) ~= "Vector3" then
                        center = nil
                    end
                    local prev = byCode[code]
                    local better = not prev
                        or (alive and not prev.Alive)
                        or (remain ~= nil and prev.Remain ~= nil and remain < prev.Remain)
                    if better then
                        byCode[code] = {
                            Code = code,
                            Alive = alive,
                            Remain = remain,
                            SpawnTime = spawnTime,
                            Center = center,
                            Title = info:GetAttribute("Title"),
                            Model = alive and model or nil,
                        }
                    end
                end
            end
        end
        Runtime.BossTagCache = byCode
        Runtime.BossTagAt = nowClock
        return byCode
    end

    function Systems.BossOpportunity.GetSpawn(code)
        if not code then
            return nil
        end
        return Systems.BossOpportunity.ScanTags()[code]
    end

    function Systems.BossOpportunity.TravelSeconds(center)
        local _, _, root = Resolver.Character()
        if not root or not center then
            return 4
        end
        local pos = center
        if typeof(center) ~= "Vector3" then
            pos = center.Position
        end
        if typeof(pos) ~= "Vector3" then
            return 4
        end
        local speed = Config.Movement.TweenSpeed or 250
        return (root.Position - pos).Magnitude / math.max(80, speed)
    end

    function Systems.BossOpportunity.IsDue(spawn)
        if not spawn then
            return false
        end
        if spawn.Alive then
            return true
        end
        if spawn.Remain == nil then
            return false
        end
        local lead = Systems.BossOpportunity.TravelSeconds(spawn.Center) + (Config.Boss.HuntArriveLead or 2)
        return spawn.Remain <= lead
    end

    function Systems.BossOpportunity.WorldEnabled()
        if not Config.AutoBoss then
            return false
        end
        local flag = ENV.OuwlandAutoWorldBoss
        if flag == nil then
            flag = Config.AutoWorldBoss
        end
        if flag == false then
            return false
        end
        local level = Game.PlayerData.GetLevel() or 0
        return level >= (Config.Boss.WorldBossFromLevel or 110)
    end

    function Systems.BossOpportunity.IsWorldCode(code)
        local def = code and EnemyDB[code]
        return def and def.WorldBoss == true
    end

    function Systems.BossOpportunity.HuntDefForCode(code)
        return code and BossHuntByCode[code]
    end

    function Systems.BossOpportunity.FindOpenHunt(code)
        local hdef = BossHuntByCode[code]
        if not hdef then
            return nil
        end
        local folder = ReplicatedStorage:FindFirstChild("BossHunts")
        if not folder then
            return nil
        end
        local npc = hdef.HuntNpc or hdef.TargetCode or code
        local now = 0
        pcall(function()
            now = Workspace:GetServerTimeNow()
        end)
        for _, child in ipairs(folder:GetChildren()) do
            local boss = child:GetAttribute("Boss")
            if boss == npc or boss == code then
                local expires = tonumber(child:GetAttribute("ExpiresAt"))
                if not (expires and now > 0 and expires + 1 < now) then
                    local id = tonumber(child.Name)
                    if id == nil then
                        id = child.Name
                    end
                    return {
                        Id = id,
                        Quest = child:GetAttribute("Quest") or hdef.Key,
                        Boss = boss,
                        Side = child:GetAttribute("Side"),
                    }
                end
            end
        end
        return nil
    end

    function Systems.BossOpportunity.CanClaimHunt(code)
        local hdef = BossHuntByCode[code]
        if not hdef then
            return false, "no hunt def"
        end
        if Game.PlayerData.GetQuestByKey(hdef.Key) then
            return false, "already held"
        end
        if Runtime.PendingAccept == hdef.Key then
            return false, "pending"
        end
        local ok, why = Systems.Quest.CanTakeQuest(hdef.Key, { IgnoreBossAlive = true })
        if not ok then
            return false, why or "cannot take"
        end
        local card = Systems.BossOpportunity.FindOpenHunt(code)
        if not card then
            return false, "no card"
        end
        return true, "ok", card, hdef
    end

    function Systems.BossOpportunity.HolderBlocksHunt(holder)
        if not holder then
            return false
        end
        if holder.Intent == "COMPLETE" or holder.Intent == "PICKUP" or holder.Intent == "DELIVER" or holder.Intent == "TRAINING" then
            return true
        end
        local hdef = holder.Entry and QuestDB[holder.Entry.Key]
        if hdef and hdef.Kind == "Breathing" then
            return true
        end
        return false
    end

    function Systems.BossOpportunity.PickLiveWorld()
        if not Systems.BossOpportunity.WorldEnabled() then
            return nil
        end
        local tags = Systems.BossOpportunity.ScanTags()
        local _, _, root = Resolver.Character()
        local origin = root and root.Position
        local function pack(code, spawn, model)
            local def = EnemyDB[code]
            local center = (spawn and spawn.Center) or (def and def.Center)
            local useModel = model or (spawn and spawn.Model)
            local mroot = useModel and Systems.Enemy.GetRoot(useModel)
            -- Keep authored spawn as travel dest. Chasing a walking Hashira restarts hop every tick.
            if mroot and origin and (origin - mroot.Position).Magnitude <= 80 then
                center = mroot.Position
            end
            if not center then
                return nil
            end
            local dist = origin and (origin - center).Magnitude or 0
            local hdef = BossHuntByCode[code]
            return {
                Code = code,
                Center = center,
                Alive = true,
                NoQuest = true,
                Level = Config.Boss.WorldBossFromLevel or 110,
                Model = useModel,
                Dist = dist,
                Key = hdef and hdef.Key or nil,
                Def = hdef,
            }
        end
        local heldList = Game.PlayerData.GetCurrentQuests()
        for i = 1, #heldList do
            local qdef = QuestDB[heldList[i].Key]
            if qdef and qdef.ClaimHunt and qdef.TargetCode then
                local spawn = tags[qdef.TargetCode]
                if spawn and spawn.Alive then
                    local packed = pack(qdef.TargetCode, spawn, spawn.Model)
                    if packed then
                        packed.NoQuest = false
                        packed.Key = qdef.Key
                        packed.Def = qdef
                        return packed
                    end
                end
            end
        end
        local committed = Runtime.HuntPatrol
        if committed and Systems.BossOpportunity.IsWorldCode(committed.Code) then
            local spawn = tags[committed.Code]
            if spawn and spawn.Alive then
                local packed = pack(committed.Code, spawn, spawn.Model)
                if packed then
                    packed.NoQuest = committed.NoQuest
                    packed.Key = committed.Key
                    packed.Def = committed.Def
                    packed.HuntId = committed.HuntId
                    return packed
                end
            end
        end
        local best
        for code, def in pairs(EnemyDB) do
            if def.WorldBoss then
                local spawn = tags[code]
                if spawn and spawn.Alive then
                    local row = pack(code, spawn, spawn.Model)
                    if row and (not best or row.Dist < best.Dist) then
                        best = row
                    end
                end
            end
        end
        return best
    end

    function Systems.BossOpportunity.PickPatrol()
        local rows = Systems.BossOpportunity.HuntRows()
        local tags = Systems.BossOpportunity.ScanTags()
        local due = {}
        for i = 1, #rows do
            local row = rows[i]
            local spawn = tags[row.Code]
            if spawn then
                if spawn.Center then
                    row.Center = spawn.Center
                end
                row.Alive = spawn.Alive == true
                row.Remain = spawn.Alive and 0 or spawn.Remain
                if Systems.BossOpportunity.IsDue(spawn) then
                    due[#due + 1] = row
                end
            end
        end
        table.sort(due, function(a, b)
            local ar, br = a.Remain or 0, b.Remain or 0
            if math.abs(ar - br) > 1.5 then
                return ar < br
            end
            return (a.Level or 0) > (b.Level or 0)
        end)
        return due[1]
    end

    function Systems.BossOpportunity.LogTimers()
        local now = os.clock()
        if now - (Runtime.LastBossTimerLog or 0) < 10 then
            return
        end
        Runtime.LastBossTimerLog = now
        local rows = Systems.BossOpportunity.HuntRows()
        local tags = Systems.BossOpportunity.ScanTags()
        local parts = {}
        local n = math.min(5, #rows)
        for i = 1, n do
            local row = rows[i]
            local spawn = tags[row.Code]
            local label
            if not spawn then
                label = "?"
            elseif spawn.Alive then
                label = "live"
            elseif spawn.Remain ~= nil then
                label = string.format("%.0fs", spawn.Remain)
            else
                label = "off"
            end
            parts[#parts + 1] = tostring(row.Code) .. "=" .. label
        end
        if Systems.BossOpportunity.WorldEnabled() then
            local live = {}
            for code, def in pairs(EnemyDB) do
                if def.WorldBoss then
                    local spawn = tags[code]
                    if spawn and spawn.Alive then
                        live[#live + 1] = code
                    end
                end
            end
            if #live > 0 then
                parts[#parts + 1] = "world={" .. table.concat(live, ",") .. "}"
            end
        end
        if #parts > 0 then
            Logger.Info("Boss", "Timers " .. table.concat(parts, " "))
        end
    end

    function Systems.BossOpportunity.MarkMiss(code)
        if not code then
            return
        end
        Runtime.HuntMissUntil = Runtime.HuntMissUntil or {}
        -- Short latch only: let DespawnedAt replicate after a kill. Real wait is SpawnTime on BossTag.
        Runtime.HuntMissUntil[code] = os.clock() + 6
    end

    function Systems.BossOpportunity.ClearPatrol()
        Runtime.HuntPatrol = nil
        Runtime.HuntArriveAt = nil
        Runtime.HuntAccepting = false
        Runtime.HuntPatrolLogged = nil
        Runtime.HuntTravelCode = nil
        Runtime.HuntTravelDest = nil
    end

    function Systems.BossOpportunity.ShouldPatrol(holder)
        if not Config.AutoBoss then
            return false
        end
        if Systems.Breathing and Systems.Breathing.BlocksHunt and Systems.Breathing.BlocksHunt() then
            return false
        end
        if Runtime.LootUntil and Runtime.LootUntil > 0 and os.clock() < Runtime.LootUntil then
            return false
        end
        if Systems.BossOpportunity.WorldEnabled() and Systems.BossOpportunity.PickLiveWorld() then
            if Systems.BossOpportunity.HolderBlocksHunt(holder) then
                return false
            end
            return true
        end
        local level = Game.PlayerData.GetLevel() or 0
        if level < (Config.Boss.HuntFromLevel or 70) then
            return false
        end
        if holder then
            -- Turn in / pickup / thunder training first. Dead held boss must NOT block hunting other maps.
            if Systems.BossOpportunity.HolderBlocksHunt(holder) then
                return false
            end
            local hdef = holder.Entry and QuestDB[holder.Entry.Key]
            if hdef and hdef.Boss and hdef.TargetCode then
                if Systems.BossOpportunity.IsAlive(hdef.TargetCode) then
                    if holder.Entry and Runtime.HuntPatrol and Runtime.HuntPatrol.Key == holder.Entry.Key then
                        Systems.BossOpportunity.ClearPatrol()
                    end
                    return false
                end
            end
        end
        -- Committed hunt only while that boss is still due (live or spawning in a few seconds).
        if Runtime.HuntAccepting then
            local patrol = Runtime.HuntPatrol
            local huntFloor = Config.Boss.HuntFromLevel or 70
            if patrol and (patrol.Level or 0) < huntFloor and (Game.PlayerData.GetLevel() or 0) >= huntFloor then
                Runtime.HuntAccepting = false
                Runtime.PendingBossQuest = nil
                Systems.BossOpportunity.ClearPatrol()
            else
                return true
            end
        end
        if Runtime.HuntPatrol then
            local spawn = Systems.BossOpportunity.GetSpawn(Runtime.HuntPatrol.Code)
            if spawn and Systems.BossOpportunity.IsDue(spawn) then
                return true
            end
            Systems.BossOpportunity.ClearPatrol()
        end
        return Systems.BossOpportunity.PickPatrol() ~= nil
    end

    function Systems.Quest.StageBossLive()
        local ready = Systems.BossOpportunity.PickPatrol()
        if ready then
            local held = Game.PlayerData.GetQuestByKey(ready.Key) ~= nil
            return ready.Key, ready.Def, held
        end
        local best = Systems.BossOpportunity.PickBestLive()
        if not best then
            return nil
        end
        local held = Game.PlayerData.GetQuestByKey(best.Key) ~= nil
        return best.Key, best.Def, held
    end

    function Systems.Quest.ShouldPreemptForBoss(holder)
        if Config.Boss.PreemptFarm == false then
            return false
        end
        if not holder or not holder.Entry then
            return false
        end
        local heldBreath = QuestDB[holder.Entry.Key]
        if heldBreath and heldBreath.Kind == "Breathing" then
            return false
        end
        if holder.Intent == "COMPLETE" or holder.Intent ~= "COMBAT" then
            return false
        end
        local bossKey, bdef = Systems.Quest.StageBossLive()
        if not bossKey then
            return false
        end
        if holder.Entry.Key == bossKey then
            return false
        end
        local heldDef = QuestDB[holder.Entry.Key]
        if heldDef and heldDef.Boss then
            local heldLv = heldDef.MinLevel or 0
            local bossLv = (bdef and bdef.MinLevel) or 0
            if bossLv <= heldLv then
                return false
            end
            return true, bossKey
        end
        local level = Game.PlayerData.GetLevel() or 0
        if level >= (Config.Boss.HuntFromLevel or 70) then
            return true, bossKey
        end
        local stage = Systems.Quest.CurrentStage()
        if not stage then
            return false
        end
        local key = holder.Entry.Key
        if key ~= stage.Repeatable and key ~= stage.FallbackQuest then
            return false
        end
        return true, bossKey
    end

    function Systems.Quest.RemoveHeld(entry, reason)
        if not entry then
            return false, "no entry"
        end
        local inst = entry.Instance
        local name = inst and inst.Name
        if type(name) ~= "string" or name == "" then
            return false, "no name"
        end
        if os.clock() - (Runtime.LastRemoveQuestAt or 0) < 2.5 then
            return false, "throttle"
        end
        Runtime.LastRemoveQuestAt = os.clock()
        Net.ToServer("RemoveQuest", name)
        Logger.Info("Quest", "RemoveQuest '" .. name .. "' for " .. tostring(reason))
        Systems.Enemy.InvalidateTarget()
        if Systems.Movement and Systems.Movement.Stop then
            Systems.Movement.Stop()
        end
        return true
    end

    function Systems.Quest.CurrentStage()
        local race = Game.PlayerData.GetRace()
        if not race then
            return nil
        end
        local mode = Systems.Quest.FarmMode()
        local stageRace = race
        if mode == "Slayer" and (race == "Slayer" or race == "Hybrid") then
            stageRace = "Slayer"
        elseif mode == "Demon" and (race == "Demon" or race == "Hybrid") then
            stageRace = "Demon"
        end
        local list = Stages[stageRace] or Stages.Human
        local level = Game.PlayerData.GetLevel() or 0
        local chosen
        for i = 1, #list do
            local stage = list[i]
            if level >= (stage.MinLevel or 1) and (stage.MaxLevel == nil or level <= stage.MaxLevel) then
                chosen = stage
            end
        end
        Runtime.CurrentStageId = chosen and chosen.Id or nil
        return chosen
    end

    function Systems.Quest.SelectBestQuest()
        local holder = Systems.Quest.SelectHolderAction()
        if holder and holder.Entry then
            local hdef = QuestDB[holder.Entry.Key]
            if hdef and not Systems.Quest.RaceAllowed(hdef, Game.PlayerData.GetRace()) then
                Systems.Quest.RemoveHeld(holder.Entry, "farm-mode")
                holder = nil
            end
        end
        local thunderKey = Systems.Breathing.Key and Systems.Breathing.Key()
        if thunderKey and Systems.Breathing.ShouldStart and Systems.Breathing.ShouldStart() then
            if holder and holder.Entry and holder.Entry.Key ~= thunderKey then
                Systems.Quest.RemoveHeld(holder.Entry, "thunder-breathing")
                return nil, nil, "thunder-drop"
            end
            if not Game.PlayerData.GetQuestByKey(thunderKey) then
                local ok, why = Systems.Quest.CanTakeQuest(thunderKey)
                if ok then
                    return thunderKey, QuestDB[thunderKey], "thunder-breathing"
                end
                if why and string.sub(tostring(why), 1, 9) == "cooldown:" then
                    Runtime.CurrentIntent = { Key = thunderKey, Def = QuestDB[thunderKey], Source = "thunder-breathing" }
                    return nil, nil, "thunder-cooldown"
                end
                if why == "category" then
                    local list = Game.PlayerData.GetCurrentQuests()
                    for i = 1, #list do
                        local d = QuestDB[list[i].Key]
                        if d and (d.Category or "Combat") == "Combat" and list[i].Key ~= thunderKey then
                            Systems.Quest.RemoveHeld(list[i], "thunder-category")
                            return nil, nil, "thunder-drop"
                        end
                    end
                end
            end
        end
        if holder and holder.Intent ~= "COMPLETE" then
            return holder.Entry.Key, QuestDB[holder.Entry.Key], "holder:" .. tostring(holder.Why)
        end
        local race = Game.PlayerData.GetRace()
        if not race then
            return nil, nil, "no race"
        end
        local stage = Systems.Quest.CurrentStage()
        local function take(key, reason)
            if not key then
                return nil
            end
            local ok = Systems.Quest.CanTakeQuest(key)
            if ok then
                return key, QuestDB[key], reason
            end
            return nil
        end
        local pending = Runtime.PendingBossQuest
        if Runtime.PendingOpportunity and Runtime.PendingOpportunity.QuestKey then
            pending = pending or Runtime.PendingOpportunity.QuestKey
        end
        local liveBoss = Systems.BossOpportunity.PickBestLive()
        local liveBossKey = liveBoss and liveBoss.Key
        local liveBossDef = liveBoss and liveBoss.Def
        if liveBossKey then
            pending = liveBossKey
        end
        if pending then
            local pdef = QuestDB[pending] or liveBossDef
            local huntFloor = Config.Boss.HuntFromLevel or 70
            local huntAll = (Game.PlayerData.GetLevel() or 0) >= huntFloor
            local committed = Runtime.HuntAccepting and Runtime.HuntPatrol and Runtime.HuntPatrol.Key == pending
            if huntAll and pdef and (pdef.MinLevel or 0) < huntFloor and not committed then
                if Runtime.PendingBossQuest == pending then
                    Runtime.PendingBossQuest = nil
                end
                pending = nil
                pdef = nil
            end
        end
        if pending then
            local pdef = QuestDB[pending] or liveBossDef
            local alive = pdef and Systems.BossOpportunity and Systems.BossOpportunity.IsAlive(pdef.TargetCode)
            if alive then
                local key, def, reason = take(pending, "pending-boss")
                if key then
                    return key, def, reason
                end
                Runtime.CurrentIntent = { Key = pending, Def = pdef, Source = "pending-boss-wait" }
                return nil, nil, "pending-boss-wait"
            else
                Runtime.PendingBossQuest = nil
                Runtime.PendingOpportunity = nil
            end
        end
        local function firstOneTime(kinds)
            if not stage or not stage.OneTime then
                return nil
            end
            for i = 1, #stage.OneTime do
                local qkey = stage.OneTime[i]
                local qdef = QuestDB[qkey]
                if qdef then
                    local kind = qdef.Kind or ""
                    if not kinds or kinds[kind] then
                        local key, def, reason = take(qkey, "onetime:" .. stage.Id)
                        if key then
                            return key, def, reason
                        end
                    end
                end
            end
            return nil
        end
        do
            local key, def, reason = firstOneTime({ Chain = true, Deliver = true, Dialogue = true })
            if key then
                return key, def, reason
            end
        end
        if stage then
            local key, def, reason = take(stage.Repeatable, "stage-farm:" .. (stage.Id or ""))
            if key then
                return key, def, reason
            end
            if stage.FallbackQuest and stage.FallbackQuest ~= stage.Repeatable then
                local key2, def2, reason2 = take(stage.FallbackQuest, "stage-fallback:" .. (stage.Id or ""))
                if key2 then
                    return key2, def2, reason2
                end
            end
        end
        do
            local key, def, reason = firstOneTime({ Pickup = true })
            if key then
                return key, def, reason
            end
        end
        do
            local key, def, reason = firstOneTime()
            if key then
                return key, def, reason
            end
        end
        if (Game.PlayerData.GetLevel() or 0) < 40 then
            for key, def in pairs(QuestDB) do
                if def.LogCompletion and Systems.Quest.CanExecuteAutomatically(def) then
                    local dest = Systems.Quest.GiverDest(def)
                    if dest then
                        local k, d, reason = take(key, "onetime:global")
                        if k then
                            return k, d, reason
                        end
                    end
                end
            end
        end
        if stage and Config.AutoBoss and stage.Boss then
            local key, def, reason = take(stage.Boss, "stage-boss:" .. (stage.Id or ""))
            if key then
                return key, def, reason
            end
            local bdef = QuestDB[stage.Boss]
            local fallback = stage.FallbackQuest or stage.Repeatable
            if bdef and Systems.BossOpportunity and not Systems.BossOpportunity.IsAlive(bdef.TargetCode) then
                local stamp = "boss-miss:" .. tostring(stage.Boss)
                if Runtime.LastBossFallbackLog ~= stamp or (os.clock() - (Runtime.LastBossFallbackLogAt or 0)) > 8 then
                    Runtime.LastBossFallbackLog = stamp
                    Runtime.LastBossFallbackLogAt = os.clock()
                    Logger.Info("Boss", tostring(bdef.TargetCode) .. " unavailable, fallback=" .. tostring(fallback))
                end
            end
        end
        local level = Game.PlayerData.GetLevel() or 0
        local ladder = {
            { MinLevel = 47, Key = "Ill drive them off(Lv 47)" },
            { MinLevel = 40, Key = "I will clear out his guards(Lv 40)" },
            { MinLevel = 26, Key = "Ill clear out his subordinates(Lv 26)" },
            { MinLevel = 10, Key = "Ill drive the bears back(Lv 10)" },
        }
        for i = 1, #ladder do
            local row = ladder[i]
            if level >= row.MinLevel then
                local key, def, reason = take(row.Key, "combat-ladder:" .. tostring(level))
                if key then
                    return key, def, reason
                end
            end
        end
        if level < 10 then
            return take("Ill take 3 bandits", "fallback-bandits")
        end
        return nil, nil, "no reachable stage quest"
    end

    function Systems.Quest.GiverDest(def)
        local name = Systems.Quest.GiverName(def)
        local model = Resolver.FindWorldNpcModel(name)
        if model then
            return Systems.Movement.NpcRootCFrame(model), name, model
        end
        local cf = (def and def.NpcCFrame) or (name and NpcDB[name] and NpcDB[name].CFrame)
        return Util.ToCFrame(cf), name, nil
    end

    function Systems.Quest.CombatFallbackKey()
        local level = Game.PlayerData.GetLevel() or 0
        local ladder = {
            { MinLevel = 47, Key = "Ill drive them off(Lv 47)" },
            { MinLevel = 40, Key = "I will clear out his guards(Lv 40)" },
            { MinLevel = 26, Key = "Ill clear out his subordinates(Lv 26)" },
            { MinLevel = 10, Key = "Ill drive the bears back(Lv 10)" },
            { MinLevel = 1, Key = "Ill take 3 bandits" },
        }
        for i = 1, #ladder do
            local row = ladder[i]
            if level >= row.MinLevel then
                return row.Key
            end
        end
        return "Ill take 3 bandits"
    end

    function Systems.Quest.GiverName(def)
        if not def then
            return nil
        end
        if def.OfferNpc == false then
            return def.NpcName
        end
        local name = def.OfferNpc or def.NpcName
        if not name or name == false then
            return def.NpcName
        end
        return name
    end

    function Systems.Quest.GiverCFrame(def)
        local name = Systems.Quest.GiverName(def)
        local cf = (name and NpcDB[name] and NpcDB[name].CFrame) or (def and def.NpcCFrame) or Resolver.FindWorldNpc(name)
        return Util.ToCFrame(cf), name
    end

    function Systems.Quest.IsAtGiver(def)
        local dest, name, model = Systems.Quest.GiverDest(def)
        if not dest then
            return false, "no dest", name
        end
        if Systems.Movement.IsBesideNpc(dest, model) then
            return true, dest, name
        end
        return false, "too far", name
    end

    function Systems.Quest.SelectFarmDestination()
        local stage = Systems.Quest.CurrentStage()
        local key = stage and stage.Repeatable
        local race = Game.PlayerData.GetRace()
        if key and QuestDB[key] and not Systems.Quest.RaceAllowed(QuestDB[key], race) then
            key = nil
        end
        if not key or (key == "Ill take 3 bandits" and (Game.PlayerData.GetLevel() or 0) >= 10) then
            key = Systems.Quest.CombatFallbackKey()
        end
        return key, QuestDB[key]
    end

    function Systems.Quest.FireNpcPrompt(npcName)
        if not npcName then
            return false
        end
        local now = os.clock()
        if Runtime.LastNpcPromptName == npcName and Runtime.LastNpcPromptAt and (now - Runtime.LastNpcPromptAt) < 1.25 then
            return false, "throttle"
        end
        local model = Resolver.FindWorldNpcModel(npcName)
        if not model then
            return false, "npc missing"
        end
        local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
        if not prompt then
            return false, "no prompt"
        end
        Runtime.LastNpcPromptName = npcName
        Runtime.LastNpcPromptAt = now
        pcall(function()
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
                prompt:InputHoldBegin()
                task.wait(prompt.HoldDuration or 0)
                prompt:InputHoldEnd()
            end
        end)
        return true
    end

    function Systems.Quest.AcceptQuest(key)
        if not Config.AutoQuest then
            return false, "disabled"
        end
        key = Systems.Quest.NormalizeKey(key) or key
        if Game.PlayerData.GetQuestByKey(key) then
            Runtime.PendingAccept = nil
            Runtime.LastSuccessfulAction = "AcceptQuest:" .. key
            Runtime.LastHolderMutation = os.clock()
            Runtime.LastProgressAt = os.clock()
            return true
        end
        local def = Systems.Quest.GetDefinition(key) or QuestDB[key]
        if def and def.ClaimHunt then
            if Runtime.PendingAccept == key then
                if os.clock() - (Runtime.PendingAcceptAt or 0) <= Config.Quest.AcceptTimeout then
                    return false, "pending"
                end
                if not Runtime.PendingAcceptRetried and Config.Quest.AcceptRetries > 0 then
                    local card = Systems.BossOpportunity.FindOpenHunt(def.TargetCode)
                    if card then
                        Logger.Warn("Quest", "Claim retry hunt id=" .. tostring(card.Id) .. " " .. key)
                        Net.ClaimBossHunt(card.Id)
                    end
                    Runtime.PendingAcceptRetried = true
                    Runtime.PendingAcceptAt = os.clock()
                    return false, "retrying"
                end
                Runtime.PendingAccept = nil
                return false, "not in Holder"
            end
            local ok, reason = Systems.Quest.CanTakeQuest(key, { IgnoreBossAlive = true })
            if not ok then
                local stamp = tostring(key) .. ":" .. tostring(reason)
                if Runtime.LastAcceptSkip ~= stamp or (os.clock() - (Runtime.LastAcceptSkipAt or 0)) > 6 then
                    Runtime.LastAcceptSkip = stamp
                    Runtime.LastAcceptSkipAt = os.clock()
                    Logger.Info("Quest", "Cannot claim " .. tostring(key) .. " (" .. tostring(reason) .. ")")
                end
                return false, reason
            end
            local card = Systems.BossOpportunity.FindOpenHunt(def.TargetCode)
            if not card then
                return false, "no card"
            end
            Logger.Info("Quest", "Claim hunt id=" .. tostring(card.Id) .. " " .. key)
            local fired, err = Net.ClaimBossHunt(card.Id)
            if not fired then
                return false, err or "remote"
            end
            Runtime.PendingAccept = key
            Runtime.PendingAcceptAt = os.clock()
            Runtime.PendingAcceptRetried = false
            return false, "pending"
        end
        local atGiver, destOrErr, giverName = Systems.Quest.IsAtGiver(def)
        if not atGiver then
            return false, destOrErr or "too far"
        end
        if Runtime.PendingAccept == key then
            if os.clock() - (Runtime.PendingAcceptAt or 0) <= Config.Quest.AcceptTimeout then
                return false, "pending"
            end
            if not Runtime.PendingAcceptRetried and Config.Quest.AcceptRetries > 0 then
                Logger.Warn("Quest", "AddQuest retry at " .. tostring(giverName) .. ": " .. key)
                Net.AddQuest(key)
                Runtime.PendingAcceptRetried = true
                Runtime.PendingAcceptAt = os.clock()
                return false, "retrying"
            end
            Runtime.PendingAccept = nil
            return false, "not in Holder"
        end
        if def and def.Boss then
            if Runtime.BossAliveCache then
                Runtime.BossAliveCache[def.TargetCode] = nil
            end
            if not (Systems.BossOpportunity and Systems.BossOpportunity.IsAlive(def.TargetCode)) then
                return false, "boss absent"
            end
        end
        local ok, reason = Systems.Quest.CanTakeQuest(key)
        if not ok then
            local stamp = tostring(key) .. ":" .. tostring(reason)
            if Runtime.LastAcceptSkip ~= stamp or (os.clock() - (Runtime.LastAcceptSkipAt or 0)) > 6 then
                Runtime.LastAcceptSkip = stamp
                Runtime.LastAcceptSkipAt = os.clock()
                Logger.Info("Quest", "Cannot accept " .. tostring(key) .. " (" .. tostring(reason) .. ")")
            end
            return false, reason
        end
        Logger.Info("Quest", "AddQuest " .. key .. " at " .. tostring(giverName))
        local fired, err = Net.AddQuest(key)
        if not fired then
            return false, err or "remote"
        end
        Runtime.PendingAccept = key
        Runtime.PendingAcceptAt = os.clock()
        Runtime.PendingAcceptRetried = false
        return false, "pending"
    end

    function Systems.Quest.FireProgress(questKey, taskName, extra)
        if not questKey or not taskName then
            return false
        end
        if extra ~= nil then
            return Net.ToServer("QuestProgress", questKey, taskName, extra)
        end
        return Net.ToServer("QuestProgress", questKey, taskName)
    end


