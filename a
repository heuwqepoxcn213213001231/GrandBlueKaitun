    function Resolver.OwnsPlayerFolder(folder)
        if not folder then
            return false
        end
        local name = LocalPlayer.Name
        return folder.Name == name or folder.Name == (name .. "-Studio")
    end

    function Resolver.FindSlotFolder()
        if Runtime.Slot and Runtime.Slot.Parent and Runtime.Slot:FindFirstChild("Exp") then
            local dataFolder = Runtime.Slot.Parent and Runtime.Slot.Parent.Parent
            if dataFolder and Resolver.OwnsPlayerFolder(dataFolder) then
                return Runtime.Slot
            end
            -- Slot parent is `slots`, grandparent is player folder
            local slots = Runtime.Slot.Parent
            local owner = slots and slots.Parent
            if owner and Resolver.OwnsPlayerFolder(owner) then
                return Runtime.Slot
            end
        end
        local ps = ReplicatedStorage:FindFirstChild("Player_Service")
        local dataRoot = ps and ps:FindFirstChild("Data")
        if not dataRoot then
            return nil
        end
        local names = {
            LocalPlayer.Name .. "-Studio",
            LocalPlayer.Name,
        }
        for i = 1, #names do
            local folder = dataRoot:FindFirstChild(names[i])
            if folder then
                local equipped = folder:FindFirstChild("slotEquipped")
                local slots = folder:FindFirstChild("slots") or folder:FindFirstChild("Slots")
                if slots then
                    local slotName = "Slot1"
                    if equipped and equipped:IsA("ValueBase") then
                        slotName = "Slot" .. tostring(equipped.Value)
                    end
                    local slot = slots:FindFirstChild(slotName) or slots:FindFirstChild("Slot1")
                    if slot and slot:FindFirstChild("Exp") then
                        return slot
                    end
                end
                if folder:FindFirstChild("Exp") then
                    return folder
                end
            end
        end
        return nil
    end

    function Game.PlayerData.GetSlot()
        if Runtime.Slot and Runtime.Slot.Parent and Runtime.Slot:FindFirstChild("Exp") then
            local owner = Runtime.Slot.Parent and Runtime.Slot.Parent.Parent
            if owner and Resolver.OwnsPlayerFolder(owner) then
                return Runtime.Slot
            end
            if Resolver.OwnsPlayerFolder(Runtime.Slot) then
                return Runtime.Slot
            end
            Runtime.Slot = nil
        end
        local util = Resolver.Utility()
        if util and type(util.GetData) == "function" then
            local ok, slot = pcall(util.GetData, LocalPlayer)
            if ok and slot and typeof(slot) == "Instance" and slot:FindFirstChild("Exp") then
                local owner = slot.Parent and slot.Parent.Parent
                if owner and Resolver.OwnsPlayerFolder(owner) then
                    Runtime.Slot = slot
                    return slot
                end
            end
        end
        local slot = Resolver.FindSlotFolder()
        Runtime.Slot = slot
        return slot
    end

