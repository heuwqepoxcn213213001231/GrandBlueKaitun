    function Game.PlayerData.GetCurrentQuests()
        local holder = Game.PlayerData.GetHolder()
        local list = {}
        if not holder then
            return list
        end
        for _, inst in ipairs(holder:GetChildren()) do
            local qs = inst:FindFirstChild("QuestString")
            local key = qs and qs:IsA("ValueBase") and qs.Value or nil
            table.insert(list, {
