    function Systems.Recovery.Bump(code)
        Runtime.RecoveryCounts[code] = (Runtime.RecoveryCounts[code] or 0) + 1
        return Runtime.RecoveryCounts[code]
    end

    function Systems.Recovery.Clear(code)
        if code then
            Runtime.RecoveryCounts[code] = 0
        else
            Runtime.RecoveryCounts = {}
        end
    end

    function Systems.Recovery.Handle(code, detail)
        local recKey = tostring(code) .. ":" .. tostring(detail or "")
        Runtime.LastError = code .. (detail and (": " .. detail) or "")
        local deathWait = code == "CHARACTER_MISSING" or code == "PLAYER_DEAD" or code == "ROOT_MISSING"
            or (code == "STALL" and (detail == "PLAYER_DEAD" or detail == "ROOT_MISSING" or detail == "WAIT_CHARACTER" or detail == "WAIT_RESPAWN" or detail == "WAITING_FOR_BOSS"))
        if deathWait then
            Systems.Movement.Stop()
            Systems.Enemy.InvalidateTarget()
            Logger.Info("Recovery", "Death/respawn — keep quest (" .. recKey .. ")")
            return "WAIT"
        end
        local n = Systems.Recovery.Bump(recKey)
        if n > Config.Recovery.MaxRetries then
            local reason = "NPC_MISSING"
            if code == "MOVEMENT_STUCK" then
                reason = "TRAVEL_UNRESOLVED"
            elseif code == "QUEST_ACCEPT_FAILED" then
                reason = "INTERACTION_UNRESOLVED"
            elseif code == "TARGET_MISSING" or code == "COMBAT_NO_DAMAGE" then
                reason = "TARGET_SPAWN_MISSING"
            end
            if Runtime.CurrentIntent and Runtime.CurrentIntent.Key then
                Systems.Quest.MarkUnavailable(Runtime.CurrentIntent.Key, reason)
            end
            Runtime.RecoveryCounts[recKey] = 0
            Logger.Warn("Recovery", code .. " gave up; candidate suppressed (" .. reason .. ")")
            return "GIVE_UP"
        end
        Logger.Warn("Recovery", code .. " x" .. tostring(n) .. (detail and (" — " .. detail) or ""))
        if Config.Debug then
            Logger.Debug("Snapshot", Progression.DebugSnapshot())
        end
        if code == "TARGET_DEAD" or code == "TARGET_MISSING" then
            Systems.Enemy.InvalidateTarget()
            return "RETRY"
        end
        if code == "QUEST_ACCEPT_FAILED" then
            return "RETRY"
        end
        if code == "COMBAT_NO_DAMAGE" then
            Systems.Enemy.InvalidateTarget()
            return "REACQUIRE"
        end
        if code == "MOVEMENT_STUCK" then
            Systems.Movement.Stop()
            return "RETRY"
        end
        return "RETRY"
    end

    function Systems.Watchdog.TimeoutFor(state)
        if state == "FARM_COMBAT" then
            return Config.Watchdog.Combat
        end
        if state == "PLAYER_DEAD" or state == "ROOT_MISSING" or state == "WAIT_CHARACTER" then
            return Config.Watchdog.Death or 90
        end
        if state == "WAIT_RESPAWN" or state == "WAITING_FOR_BOSS" then
            local code = Runtime.CurrentTask and Runtime.CurrentTask.Code
            local enemy = code and EnemyDB[code]
            if not enemy then
                local def = Systems.Quest.GetDefinition(Runtime.CurrentQuest)
                enemy = def and def.TargetCode and EnemyDB[def.TargetCode]
            end
            return (enemy and enemy.SpawnTime or 30) + Config.Watchdog.WaitRespawn
        end
        if state == "HUNT_TRAVEL" then
            return Config.Watchdog.TravelBase + 30
        end
        if state == "POTION_DRINK" then
            return (Config.Potion.DrinkTimeout or 2.2) + 4
        end
        if state == "LOOT_CHEST" then
            return (Config.Boss.LootSeconds or 10) + 6
        end
        if state == "BOSS_PREEMPT" then
            return 15
        end
        if state == "QUEST_ACCEPT" or state == "QUEST_TRAVEL" or state == "QUEST_DELIVER" or state == "QUEST_COMPLETE" then
            return Config.Watchdog.TravelBase + 40
        end
        if state == "WAIT_COOLDOWN" then
            return (Config.Quest.Cooldown or 30) + 20
        end
        if state == "QUEST_COMPLETE" then
            return Config.Watchdog.Dialogue + 25
        end
        if state == "QUEST_PICKUP" then
            return Config.Watchdog.Pickup
        end
        if state == "TRAINING" then
            return Config.Watchdog.Training or 45
        end
        if state == "FARM_TRAVEL" or state == "TRAVEL_REGION" then
            return Config.Watchdog.TravelBase + 15
        end
        if state == "WAIT_DATA" or state == "WAIT_CHARACTER" then
            return Config.Recovery.DataWait
        end
        return Config.Watchdog.Idle
    end

