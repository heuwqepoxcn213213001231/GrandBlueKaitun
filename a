    local Logger = {}
    Logger._once = {}

    function Logger._prefix(level, system)
        return string.format("[Ouwland][%s][%s]", level, system or "Core")
    end

    function Logger.Info(system, message)
        print(Logger._prefix("Info", system) .. " " .. tostring(message))
    end

    function Logger.Warn(system, message)
        warn(Logger._prefix("Warn", system) .. " " .. tostring(message))
    end

    function Logger.Error(system, message)
        warn(Logger._prefix("Error", system) .. " " .. tostring(message))
    end

    function Logger.Debug(system, message)
        if Config.Debug then
            print(Logger._prefix("Debug", system) .. " " .. tostring(message))
        end
    end

    function Logger.Once(key, level, system, message)
        if Logger._once[key] then
            return
        end
        Logger._once[key] = true
        if level == "error" then
            Logger.Error(system, message)
        elseif level == "warn" then
            Logger.Warn(system, message)
        else
            Logger.Info(system, message)
        end
    end

