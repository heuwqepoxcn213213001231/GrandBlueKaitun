    function Systems.Potion.Tick()
        if Config.AutoPotion == false then
            return false
        end
        if Runtime.DrinkingPotion then
            return true
        end
        if Runtime.State == "LOOT_CHEST" or Runtime.State == "WAIT_RESPAWN" or Runtime.State == "PLAYER_DEAD" then
            return false
        end
        local now = os.clock()
        local recheck = (Config.Potion and Config.Potion.Recheck) or 2.8
        if Runtime.LastPotionAt and now - Runtime.LastPotionAt < recheck then
            return false
        end
        local _, humanoid = Resolver.Character()
        if not Util.IsAliveHumanoid(humanoid) then
            return false
        end
        local hpFrac = humanoid.MaxHealth > 0 and (humanoid.Health / humanoid.MaxHealth) or 1
        if hpFrac > ((Config.Potion and Config.Potion.HealthPercent) or 0.42) then
            return false
        end
        local heal = Systems.Potion.Pick((Config.Potion and Config.Potion.HealthInstant) or { "Health Elixir", "Health Potion" })
        if heal then
            return Systems.Potion.Drink(heal)
        end
        return false
    end

