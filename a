    function Game.PlayerData.GetQuestByKey(key)
        if not key then
            return nil
        end
        local want = Systems.Quest.NormalizeKey(key)
        local list = Game.PlayerData.GetCurrentQuests()
        for i = 1, #list do
            local have = list[i].Key
            if have == key or Systems.Quest.NormalizeKey(have) == want then
                return list[i]
            end
        end
        return nil
    end

    function Game.PlayerData.GetQuestTasks(questInstance)
        local tasks = {}
        if not questInstance then
            return tasks
        end
        local folder = questInstance:FindFirstChild("Tasks")
        if not folder then
            return tasks
        end
        for _, task in ipairs(folder:GetChildren()) do
            table.insert(tasks, {
                Name = task.Name,
                Value = readNumber(task, "Value") or (task:IsA("ValueBase") and tonumber(task.Value)) or 0,
                Max = readNumber(task, "Max") or 0,
                Code = readString(task, "Code"),
                Need = readString(task, "Need"),
                Instance = task,
            })
        end
        return tasks
    end

    function Game.PlayerData.CountCategory(category)
        local n = 0
        local list = Game.PlayerData.GetCurrentQuests()
        for i = 1, #list do
            local def = QuestDB[list[i].Key]
            local cat = (def and def.Category) or "Combat"
            if cat == category then
                n = n + 1
            end
        end
        return n
    end

    function Resolver.CurrentRegion()
        if not Runtime.AreaLocator then
            Runtime.AreaLocator = Resolver.RequireModule({ "CAM", "Global", "Subsets", "Areas", "AreaLocator" })
        end
        local loc = Runtime.AreaLocator
        if type(loc) == "table" and type(loc.AreaEquipped) == "table" then
            local parent = loc.AreaEquipped.Parent
            if type(parent) == "string" and parent ~= "" then
                return parent
            end
        end
        return Game.PlayerData.GetSpawnRegion()
    end

    function Game.PlayerData.Refresh()
        local slot = Game.PlayerData.GetSlot()
        Runtime.Slot = slot
        Runtime.PlayerData = slot
        if not slot then
            Runtime.Race = nil
            Runtime.Level = nil
            Runtime.Snapshot = nil
            return false
        end
        local exp = slot:FindFirstChild("Exp")
        local current = readNumber(exp, "Current") or 0
        local goal = readNumber(exp, "Goal") or 0
        local race = readString(slot, "Race")
        if race == "" then
            race = nil
        end
        local per = Config.Progression.ExpPerLevel
        if not per or per <= 0 then
            per = 60
        end
        local powers = slot:FindFirstChild("Powers")
        local spawn = slot:FindFirstChild("Spawn")
        local inv = slot:FindFirstChild("Inventory")
        local bar = inv and inv:FindFirstChild("Toolbar")
        local equippedId = readNumber(bar, "One") or 0
        Runtime.Race = race
        Runtime.ExpCurrent = current
        Runtime.ExpGoal = goal
        Runtime.Level = math.floor((goal or 0) / per)
        Runtime.Wen = readNumber(slot, "Wen") or 0
        Runtime.Clan = readString(slot, "Clan")
        Runtime.SkillPoints = readNumber(slot, "SkillPoints") or 0
        local breathing = readString(powers, "Breathing")
        local demonArt = readString(powers, "DemonArt")
        local fighting = readString(powers, "FightingStyle")
        Runtime.Breathing = (breathing ~= "" and breathing) or nil
        Runtime.DemonArt = (demonArt ~= "" and demonArt) or nil
        Runtime.FightingStyle = (fighting ~= "" and fighting) or nil
        Runtime.SpawnRegion = readString(spawn, "Equipped")
        Runtime.Region = Resolver.CurrentRegion() or Runtime.SpawnRegion
        Runtime.Weapon = Game.PlayerData.GetItemNameById(equippedId) or Runtime.Weapon or "Combat"
        Runtime.Snapshot = {
            Slot = slot,
            Race = Runtime.Race,
            Level = Runtime.Level,
            ExpCurrent = Runtime.ExpCurrent,
            ExpGoal = Runtime.ExpGoal,
            Wen = Runtime.Wen,
            Region = Runtime.Region,
            SpawnRegion = Runtime.SpawnRegion,
        }
        return true
    end

