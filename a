    function Systems.Potion.SetEquippedSlot(index)
        local cfg = LocalPlayer:FindFirstChild("Items_Config")
        local equipped = cfg and cfg:FindFirstChild("Equipped")
        if equipped and equipped:IsA("ValueBase") then
            pcall(function()
                equipped.Value = index
