        end
        local names = TrainingObjectNames[kind]
        local object = prompt.ObjectText
        local action = prompt.ActionText
        if names and object and names[object] then
            return true
        end
        if action == "Train" then
            local parent = prompt.Parent
            local walk = parent
            for _ = 1, 5 do
