                    zone = ch
                end
            end
        end
        if not zone then
            return
        end
        local half = math.max(zone.Size.X.Scale * 0.5, 0.01)
        if math.abs(slider.Position.X.Scale - zone.Position.X.Scale) > half + 0.03 then
            return
        end
        local now = os.clock()
        if Runtime.LastTrainSlideAt and now - Runtime.LastTrainSlideAt < 0.16 then
