    function Systems.Training.FireSignal(signal, ...)
        if not signal then
            return false
        end
        local args = { ... }
        local unpackFn = table.unpack or unpack
        local fired = false
        pcall(function()
            if not getconnections then
                return
            end
            for _, conn in ipairs(getconnections(signal)) do
                local ok = false
                if conn.Fire then
                    ok = pcall(conn.Fire, conn, unpackFn(args))
                elseif type(conn.Function) == "function" then
                    ok = pcall(conn.Function, unpackFn(args))
                end
                if ok then
                    fired = true
                end
            end
        end)
        return fired
    end

