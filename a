    function Systems.Combat.ClampCombo(combo, maxCombo)
        maxCombo = maxCombo or 5
        combo = tonumber(combo)
        if not combo then
            return 1
        end
        combo = math.floor(combo)
        if combo < 1 or combo > maxCombo then
            return 1
        end
        return combo
    end

    function Systems.Combat.NextCombo(combo, maxCombo)
        maxCombo = maxCombo or 5
        combo = Systems.Combat.ClampCombo(combo, maxCombo)
        if combo >= maxCombo then
            return 1
        end
        return combo + 1
    end

    function Systems.Combat.HitDelayArg(preset, combo)
        if not preset then
            return 0.13
        end
        combo = combo or 1
        local beforeHit = (preset.delay_before_hit and preset.delay_before_hit[combo]) or preset.default_before_hit or 0.2
        local beforeSwing = (preset.delay_before_swing and preset.delay_before_swing[combo]) or preset.default_before_swing or 0.07
        return math.max(0, beforeHit - beforeSwing)
    end

    function Systems.Combat.ServerLastCombo(character)
        if character then
            local last = character:GetAttribute("last_combo")
            if last ~= nil then
                return tonumber(last)
            end
        end
        return Runtime.LastCombatCombo
    end

    function Systems.Combat.ChooseCombo(character, comboValue, maxCombo)
        maxCombo = maxCombo or 5
        local last = Systems.Combat.ServerLastCombo(character)
        if last == nil or last == 0 then
            local fromValue = comboValue and tonumber(comboValue.Value)
            return Systems.Combat.ClampCombo(fromValue or Runtime.M1Combo or 1, maxCombo), nil
        end
        if last >= maxCombo or last == 7 then
            return 1, last
        end
        return last + 1, last
    end

    function Systems.Combat.RequiredDelay(preset, lastCombo, nextCombo, maxCombo)
        local defaultDelay = (preset and preset.default) or Config.Combat.AttackInterval or 0.26
        if lastCombo == nil then
            return 0
        end
        lastCombo = tonumber(lastCombo) or 1
        nextCombo = tonumber(nextCombo) or 1
        maxCombo = maxCombo or 5
        -- Combat_presets.get_combat_cd_info: only last+1 (or 6 after 4) uses default.
        -- Combo 1 after 5/7 uses preset.final (1.65). Other combo 1 uses combo_duration (1.35).
        -- Any other skip stays at 10000 and Check_can_do_combat_server rejects after wait.
        if nextCombo == lastCombo + 1 or (nextCombo == 6 and lastCombo == 4) then
            return defaultDelay
        end
        local resetCap = Config.Combat.ComboReset or 0.5
        if nextCombo == 1 then
            if lastCombo == 5 or lastCombo == 7 or lastCombo == maxCombo then
                return math.min((preset and preset.final) or 1.65, resetCap)
            end
            local presets = Runtime.CombatPresets
            return math.min((presets and presets.combo_duration) or 1.35, resetCap)
        end
        return defaultDelay
    end

