    local function trackConnection(name, conn)
        if Runtime.Connections[name] then
            pcall(function()
                Runtime.Connections[name]:Disconnect()
            end)
        end
        Runtime.Connections[name] = conn
        return conn
    end

    local function disconnectAll()
        for name, conn in pairs(Runtime.Connections) do
            pcall(function()
                conn:Disconnect()
            end)
            Runtime.Connections[name] = nil
        end
        if Runtime.ActiveTween then
            pcall(function()
                Runtime.ActiveTween:Cancel()
            end)
            Runtime.ActiveTween = nil
        end
        if Systems and Systems.Movement and Systems.Movement.RestoreCollision then
            pcall(Systems.Movement.RestoreCollision)
        end
    end

