    function Systems.Potion.Drink(itemName)
        if Runtime.DrinkingPotion then
            return false, "busy"
        end
        if itemName ~= "Health Potion" and itemName ~= "Health Elixir" then
            return false, "not heal"
        end
        if not Game.PlayerData.HasItem(itemName) then
            return false, "missing"
        end
        local id = Game.PlayerData.GetItemId(itemName)
        if not id then
            return false, "no id"
        end
        local amountBefore = Game.PlayerData.GetItemAmount(itemName) or 0
        local slotIndex, slotName = Game.PlayerData.FindToolbarSlot(itemName)
        local previousId
        if not slotIndex then
            slotIndex, slotName = Game.PlayerData.FindEmptyToolbarSlot()
            if not slotIndex then
                slotIndex, slotName = 2, "Two"
                previousId = Game.PlayerData.GetToolbarId("Two")
            end
            Net.ToServer("Toolbar_Equip", slotName, id)
            Runtime.LastEquipAt = os.clock()
        end
        Runtime.DrinkingPotion = true
        Runtime.PotionUntil = os.clock() + ((Config.Potion and Config.Potion.DrinkTimeout) or 2.2) + 2
        Runtime.LastPotionAt = os.clock()
        Runtime.LockTarget = nil
        if Systems.Movement.ReleasePin then
            Systems.Movement.ReleasePin()
        end
        if Systems.Movement.SetCombatLock then
            Systems.Movement.SetCombatLock(false)
        end
        if Systems.Movement.Cancel then
            Systems.Movement.Cancel("potion")
        end
        task.spawn(function()
            local finished = false
            local function finish(ok, why)
                if finished then
                    return
                end
                finished = true
                Runtime.DrinkingPotion = false
                Runtime.PotionUntil = 0
                if stillCurrent() then
                    Systems.Potion.SetEquippedSlot(1)
                    if previousId and previousId ~= 0 then
                        Net.ToServer("Toolbar_Equip", slotName, previousId)
                    end
                    Systems.Combat.EquipBest()
                    if ok then
                        Runtime.PotionFailStreak = 0
                        Logger.Info("Potion", "Drank " .. itemName .. " (" .. tostring(why) .. ")")
                    else
                        Runtime.PotionFailStreak = (Runtime.PotionFailStreak or 0) + 1
                        Logger.Warn("Potion", "Drink failed (" .. tostring(why) .. ") x" .. tostring(Runtime.PotionFailStreak))
                        if Runtime.PotionFailStreak >= 3 then
                            Config.AutoPotion = false
                            Logger.Warn("Potion", "Health Potion remote did not complete — AutoPotion off, die/respawn")
                        end
                    end
                end
            end
            task.wait(0.2)
            if not stillCurrent() or not Resolver.IsPlayerAlive() then
                finish(false, "dead")
                return
            end
            Systems.Potion.SetEquippedSlot(slotIndex)
            local welded = false
            local deadline = os.clock() + 1.8
            while os.clock() < deadline and stillCurrent() do
                local character = select(1, Resolver.Character())
                if character and character:FindFirstChild("CapWeld", true) then
                    welded = true
                    break
                end
                task.wait(0.08)
            end
            if not welded then
                finish(false, "no-capweld")
                return
            end
            local _, humanoid, root = Resolver.Character()
            local hp0 = humanoid and humanoid.Health
            local look = root and (root.Position + root.CFrame.LookVector * 6) or Vector3.zero
            -- Official consume remote. Do not send Up — server MouseUp cancels the 1.85s drink.
            Net.ToServer("Tool_Mouse", "Down", look)
            local drinkUntil = os.clock() + ((Config.Potion and Config.Potion.DrinkTimeout) or 2.2)
            while os.clock() < drinkUntil and stillCurrent() do
                if not Resolver.IsPlayerAlive() then
                    finish(false, "died")
                    return
                end
                local hum = select(2, Resolver.Character())
                if hp0 and hum and hum.Health > hp0 + 8 then
                    finish(true, "healed")
                    return
                end
                task.wait(0.08)
            end
            if Game.PlayerData.Refresh then
                Game.PlayerData.Refresh()
            end
            local left = Game.PlayerData.GetItemAmount(itemName) or 0
            if amountBefore > 0 and left < amountBefore then
                finish(true, "consumed")
                return
            end
            local hum = select(2, Resolver.Character())
            if hp0 and hum and hum.Health > hp0 + 8 then
                finish(true, "healed")
                return
            end
            finish(false, "no-heal")
        end)
        return true
    end

    function Systems.Potion.Pick(list)
        if type(list) ~= "table" then
            return nil
