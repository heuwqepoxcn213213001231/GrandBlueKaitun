    function Systems.Training.PlayCups()
        local now = os.clock()
        if Runtime.LastTrainCupAt and now - Runtime.LastTrainCupAt < 1.4 then
            return
        end
        local folder = Workspace:FindFirstChild("Training")
        local sub = folder and folder:FindFirstChild("Cup Game")
        if not sub then
            return
        end
        local ball = sub:FindFirstChild("Ball", true)
        local detectors = {}
        for _, d in ipairs(sub:GetDescendants()) do
            if d:IsA("ClickDetector") then
                local parent = d.Parent
                local name = parent and parent.Name or ""
                if string.match(name, "^Cup%d+$") then
                    table.insert(detectors, d)
                end
            end
        end
        if #detectors == 0 then
            return
        end
        local ballPart = ball
        if ball and ball:IsA("Model") then
            ballPart = ball.PrimaryPart or ball:FindFirstChildWhichIsA("BasePart", true)
        end
        if ballPart and ballPart:IsA("BasePart") and ballPart.Transparency < 0.5 then
            return
        end
        local best, bestDist
        local ballPos = ballPart and ballPart.Position
        for i = 1, #detectors do
            local cd = detectors[i]
            local part = cd.Parent
            if part and part:IsA("BasePart") then
                local dist = ballPos and (part.Position - ballPos).Magnitude or 0
                if not bestDist or dist < bestDist then
                    bestDist = dist
                    best = cd
                end
            end
        end
        if not best then
            return
        end
        Runtime.LastTrainCupAt = now
        Systems.Training.FireClickDetector(best)
        Systems.Training.LogHit("Cup Game")
    end

