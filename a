    function Systems.Training.DoCurrentTask()
        if Runtime.TrainBusyUntil and os.clock() < Runtime.TrainBusyUntil then
            Systems.Watchdog.MarkProgress()
            return
        end
        if Game.PlayerData.HasTimedStat("pause_gameplay") and not Systems.Training.GetSession() then
            Systems.Watchdog.MarkProgress()
            return
        end
        local _, hum, root = Resolver.Character()
        if not root or not hum or hum.Health <= 0 then
            return
        end
        if root.Position.Y < 80 then
            return
        end
        local task = Runtime.CurrentTask
        local kind = Systems.Training.StationTypeForTask(task)
        if not kind then
            Logger.Once("train-unknown-task", "warn", "Training", "No station for " .. tostring(task and task.Name))
            return
        end
        local session = Systems.Training.GetSession()
        if session then
            Systems.Watchdog.MarkProgress()
            Systems.Training.PlayAndFinish(kind, session)
            return
        end
        local dest, prompt = Systems.Training.FindStation(kind)
        if not dest then
            if (os.clock() - (Runtime.LastTrainMissAt or 0)) > 6 then
                Runtime.LastTrainMissAt = os.clock()
                Logger.Warn("Training", "Station missing: " .. kind)
            end
            return
        end
        local stand = Systems.Training.StandCFrame(dest)
        local stamp = kind .. string.format(" %.0f,%.0f,%.0f", stand.Position.X, stand.Position.Y, stand.Position.Z)
        if Runtime.LastTrainDestLog ~= stamp then
            Runtime.LastTrainDestLog = stamp
            Logger.Info("Training", "Go " .. stamp)
        end
        local a, b = root.Position, stand.Position
        local flat = Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
        local dy = math.abs(a.Y - b.Y)
        if flat > 10 or dy > 14 then
            if Runtime.NpcHoldCf then
                Systems.Movement.ReleaseNpcHold()
            end
            Systems.Movement.StartTween(stand, 4, "npc")
            Systems.Watchdog.MarkProgress()
            return
        end
        Systems.Movement.HoldNpc(stand)
        Systems.Watchdog.MarkProgress()
        if dy > 8 then
            return
        end
        if not Runtime.LastTrainPromptAt or os.clock() - Runtime.LastTrainPromptAt > 1.4 then
            Runtime.LastTrainPromptAt = os.clock()
            if prompt then
                Systems.Loot.FirePrompt(prompt)
                Logger.Info("Training", "Train prompt " .. kind)
            else
                local _, found = Systems.Training.FindStation(kind)
                if found then
                    Systems.Loot.FirePrompt(found)
                    Logger.Info("Training", "Train prompt (rescan) " .. kind)
                else
                    Systems.Loot.PressInteractKey(Enum.KeyCode.T)
                    Logger.Info("Training", "Train T " .. kind)
                end
            end
        end
    end

